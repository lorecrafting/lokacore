{
  "name": "loka-assets",
  "version": "1.0.0",
  "description": "Loka game engine frontend assets",
  "private": true,
  "scripts": {
    "build": "echo 'Build handled by mix assets.build'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "npx vitest run --coverage",
    "lint": "npx eslint js/",
    "lint:fix": "npx eslint js/ --fix",
    "format": "npx prettier --write 'js/**/*.js'",
    "format:check": "npx prettier --check 'js/**/*.js'",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run test",
    "clean": "rm -rf node_modules/.cache"
  },
  "dependencies": {
    "@codemirror/language": "6.12.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
