{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loka.game/schemas/quest.schema.json",
  "title": "Quest Definition",
  "description": "Schema for YAML quest definitions in Loka. Quests are placed in priv/world/quests/",
  "type": "object",
  "required": ["id", "name", "description", "objectives"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique quest identifier. Use lowercase with underscores (e.g., 'main_sleeping_master')"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Display name shown to players"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Quest description shown in journal. Use | for multi-line YAML strings"
    },
    "giver": {
      "type": "string",
      "description": "NPC prototype key who offers this quest. Use 'system' for auto-granted quests",
      "examples": ["abbot_jampa", "novice_pema", "system"]
    },
    "type": {
      "type": "string",
      "enum": ["main", "side", "repeatable"],
      "default": "side",
      "description": "Quest type: 'main' for main story, 'side' for optional, 'repeatable' for daily/weekly"
    },
    "act": {
      "type": ["integer", "string"],
      "description": "Act number within the storyline (1, 2, 3, etc.)"
    },
    "level_requirement": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Minimum player level required to accept this quest"
    },
    "requires_quest": {
      "type": "string",
      "description": "Quest ID that must be completed before this quest becomes available"
    },
    "parent": {
      "type": "string",
      "description": "Parent quest to inherit fields from (for quest templates)"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "If true, this quest is a template and won't be loaded directly"
    },
    "variables": {
      "type": "object",
      "description": "Template variables for quest inheritance",
      "additionalProperties": true
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "description": "List of objectives that must be completed",
      "items": {
        "$ref": "#/definitions/objective"
      }
    },
    "rewards": {
      "$ref": "#/definitions/rewards",
      "description": "Rewards given when quest is completed"
    },
    "journal_entries": {
      "$ref": "#/definitions/journal_entries",
      "description": "Text entries for the player's quest journal"
    }
  },
  "definitions": {
    "objective": {
      "type": "object",
      "required": ["id", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique objective ID within this quest"
        },
        "type": {
          "type": "string",
          "enum": ["talk", "kill", "get_item", "go_to"],
          "description": "Objective type: talk (NPC), kill (enemy), get_item (pickup), go_to (room)"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Displayed in quest tracker"
        },
        "target_id": {
          "type": "string",
          "description": "Prototype key of target (NPC, item, or room depending on type)"
        },
        "target_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of targets needed (for kill objectives)"
        },
        "dialogue_topic": {
          "type": "string",
          "description": "Required dialogue node name for 'talk' objectives. NPC must have this node in dialogue_tree"
        },
        "time_limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Time limit in seconds. Objective fails if not completed in time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "talk" } }
          },
          "then": {
            "required": ["target_id"],
            "properties": {
              "target_id": {
                "description": "NPC prototype key to talk to"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "kill" } }
          },
          "then": {
            "required": ["target_id"],
            "properties": {
              "target_id": {
                "description": "NPC prototype key to defeat"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "get_item" } }
          },
          "then": {
            "required": ["target_id"],
            "properties": {
              "target_id": {
                "description": "Item prototype key to obtain"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "go_to" } }
          },
          "then": {
            "required": ["target_id"],
            "properties": {
              "target_id": {
                "description": "Room prototype key to visit"
              }
            }
          }
        }
      ]
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0,
          "description": "Experience points awarded"
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "description": "Gold awarded"
        },
        "items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of item prototype keys to give"
        },
        "unlocks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Quest IDs that become available after completion"
        },
        "reputation": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "Faction reputation changes (e.g., {monastery: 10})"
        },
        "companion_available": {
          "type": "string",
          "description": "NPC prototype key that becomes available as companion"
        }
      }
    },
    "journal_entries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/definitions/lua_text" }
          ],
          "description": "Entry when quest is first accepted"
        },
        "accepted": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/definitions/lua_text" }
          ],
          "description": "Entry when quest is first accepted (alias for 'start')"
        },
        "completed": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/definitions/lua_text" }
          ],
          "description": "Entry when quest is completed"
        }
      },
      "patternProperties": {
        "^objective_complete_[a-z][a-z0-9_]*$": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/definitions/lua_text" }
          ],
          "description": "Entry when specific objective is completed"
        }
      }
    },
    "lua_text": {
      "type": "object",
      "required": ["lua"],
      "additionalProperties": false,
      "properties": {
        "lua": {
          "type": "string",
          "description": "Lua script that returns a string. Has access to 'game' object"
        }
      }
    }
  }
}
