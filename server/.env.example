# Loka Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Generate with: mix phx.gen.secret
GUARDIAN_SECRET_KEY=

# Path to SQLite database file
DATABASE_PATH=/path/to/loka.db

# Your domain (without protocol)
PHX_HOST=lokacore.fly.dev

# =============================================================================
# OPTIONAL
# =============================================================================

# Server port (default: 4000 in dev, 8080 in prod)
PORT=4000

# Database connection pool size (default: 5)
POOL_SIZE=5

# Log level: debug, info, warning, error (default: info)
LOG_LEVEL=info

# Resend API key for email delivery (optional - falls back to local mailbox)
RESEND_API_KEY=

# Email sender configuration
MAILER_FROM_NAME=Loka
MAILER_FROM_EMAIL=noreply@example.com

# DNS cluster query for distributed Erlang (optional)
DNS_CLUSTER_QUERY=
