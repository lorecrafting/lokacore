<div class="ebook-page">
  <div class="ebook-auth">
    <h1 class="ebook-auth-title">Begin Your Journey</h1>

    <.form :let={f} for={@changeset} action={~p"/players/register"} class="ebook-auth-form">
      <div style="margin-bottom: 1.5rem; text-align: left;">
        <label class="ebook-label">Your email address</label>
        <input
          type="email"
          name={f[:email].name}
          value={f[:email].value}
          class="ebook-input"
          autocomplete="email"
          required
          phx-mounted={JS.focus()}
        />
        <%= if @changeset.action do %>
          <% email_errors = Keyword.get_values(@changeset.errors, :email) %>
          <%= if email_errors != [] do %>
            <p style="color: #c00; font-size: 0.875rem; margin-top: 0.5rem;">
              {elem(hd(email_errors), 0)}
            </p>
          <% end %>
        <% end %>
      </div>

      <button type="submit" class="ebook-submit" phx-disable-with="Creating account...">
        Create account
      </button>
    </.form>

    <div class="ebook-auth-footer">
      <p>
        Already a traveler?
        <.link navigate={~p"/players/log-in"} class="ebook-link">Enter the world</.link>
      </p>
    </div>
  </div>
</div>
