<div class="ebook-page">
  <div class="ebook-auth">
    <h1 class="ebook-auth-title">Welcome, Traveler</h1>

    <p class="ebook-prose" style="text-align: center; text-indent: 0; margin-bottom: 2rem;">
      {@player.email}
    </p>

    <.form
      :if={!@player.confirmed_at}
      for={@form}
      id="confirmation_form"
      action={~p"/players/log-in?_action=confirmed"}
      class="ebook-auth-form"
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

      <button
        type="submit"
        name={@form[:remember_me].name}
        value="true"
        class="ebook-submit"
        phx-disable-with="Confirming..."
        style="display: block; margin-bottom: 1rem;"
      >
        Confirm and remember me
      </button>

      <button
        type="submit"
        class="ebook-submit"
        phx-disable-with="Confirming..."
      >
        Confirm for this visit only
      </button>
    </.form>

    <.form
      :if={@player.confirmed_at}
      for={@form}
      id="login_form"
      action={~p"/players/log-in"}
      class="ebook-auth-form"
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

      <%= if @current_scope do %>
        <button type="submit" class="ebook-submit" phx-disable-with="Entering...">
          Continue
        </button>
      <% else %>
        <button
          type="submit"
          name={@form[:remember_me].name}
          value="true"
          class="ebook-submit"
          phx-disable-with="Entering..."
          style="display: block; margin-bottom: 1rem;"
        >
          Remember me on this device
        </button>

        <button type="submit" class="ebook-submit" phx-disable-with="Entering...">
          Enter for this visit only
        </button>
      <% end %>
    </.form>

    <div :if={!@player.confirmed_at} class="ebook-auth-footer">
      <p style="font-style: italic;">You may enable passwords in your settings after entering.</p>
    </div>
  </div>
</div>
