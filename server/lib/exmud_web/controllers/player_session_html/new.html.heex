<div class="ebook-page">
  <div class="ebook-auth">
    <h1 class="ebook-auth-title">Enter the World</h1>

    <div :if={Phoenix.Flash.get(@flash, :error)} class="ebook-error" style="margin-bottom: 1rem; color: #c00; text-align: center;">
      {Phoenix.Flash.get(@flash, :error)}
    </div>

    <div :if={local_mail_adapter?()} style="margin-bottom: 1.5rem; color: var(--ebook-text-muted); font-size: 0.875rem;">
      <p>Development mode: <a href="/dev/mailbox" class="ebook-link">view sent emails</a></p>
    </div>

    <.form :let={f} for={@form} as={:player} action={~p"/players/log-in"} class="ebook-auth-form">
      <div style="margin-bottom: 1.5rem; text-align: left;">
        <label class="ebook-label">Your email address</label>
        <input
          type="email"
          name={f[:email].name}
          value={f[:email].value}
          class="ebook-input"
          autocomplete="email"
          required
          phx-mounted={JS.focus()}
          readonly={!!@current_scope}
        />
      </div>

      <button type="submit" class="ebook-submit">
        Send magic link
      </button>
    </.form>

    <div class="ebook-auth-footer">
      <%= if @current_scope do %>
        <p>You need to reauthenticate to perform sensitive actions.</p>
      <% else %>
        <p>New to this realm? <.link navigate={~p"/players/register"} class="ebook-link">Create an account</.link></p>
      <% end %>
    </div>
  </div>
</div>
