<div class="admin-page">
  <div class="admin-auth">
    <h1 class="admin-auth-title">Enter the World</h1>

    <div :if={Phoenix.Flash.get(@flash, :error)} class="admin-flash admin-flash--error">
      {Phoenix.Flash.get(@flash, :error)}
    </div>

    <div :if={local_mail_adapter?()} class="admin-dev-notice">
      <p>Development mode: <a href="/dev/mailbox" class="admin-link">view sent emails</a></p>
    </div>

    <div :if={Mix.env() == :dev} class="admin-dev-notice admin-dev-notice--spaced">
      <p><strong>Admin credentials:</strong> admin@loka.local / adminadmin12</p>
      <p class="admin-prose--small">
        Use password login below for quick access
      </p>
    </div>

    <.form :let={f} for={@form} as={:player} action={~p"/players/log-in"} class="admin-auth-form">
      <div class="admin-form-group">
        <label class="admin-label" for={f[:email].id}>Your email address</label>
        <input
          type="email"
          id={f[:email].id}
          name={f[:email].name}
          value={if Mix.env() == :dev, do: "admin@loka.local", else: f[:email].value}
          class="admin-input"
          autocomplete="email"
          required
          phx-mounted={JS.focus()}
          readonly={!!@current_scope}
        />
      </div>

      <div class="admin-form-group">
        <label class="admin-label" for={f[:password].id}>
          Password (optional - leave blank for magic link)
        </label>
        <input
          type="password"
          id={f[:password].id}
          name={f[:password].name}
          value={if Mix.env() == :dev, do: "adminadmin12", else: f[:password].value}
          class="admin-input"
          autocomplete="current-password"
        />
      </div>

      <button type="submit" class="admin-submit admin-submit--center">
        Log in
      </button>
    </.form>

    <div :if={@current_scope} class="admin-auth-footer">
      <p>You need to reauthenticate to perform sensitive actions.</p>
    </div>
  </div>
</div>
