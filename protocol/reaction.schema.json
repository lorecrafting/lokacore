{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reaction contracts",
  "description": "ReactionRule (21 \u00a73.4, \u00a711; 06 \u00a714; 04 \u00a75.2-\u00a75.4), owned by reaction@1.",
  "$defs": {
    "ReactionRule": {
      "description": "Typed reaction owned by reaction@1. Every registered event kind can trigger; each optional filter must equal its payload field (W1). Every delivery runs for the command actor; quest resolution verifies the source instance; a status.apply hits the event's subject or its named item (docs/system/mechanics.md reaction@1). Apply may assign facts or activate a quest on quest_resolved. API1.12 adds typed quest.resolve and quest.fail on fact_changed. Deliveries use one writer group and the existing FIFO budgets; faults commit nothing.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "on": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "fact_changed"
                },
                "fact": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "fact"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_entered_room"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_resolved"
                },
                "quest": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event",
                "quest",
                "outcome"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "rested"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "item_acquired"
                },
                "item": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "item_dropped"
                },
                "item": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "shooed"
                },
                "item": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_activated"
                },
                "quest": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "choice_opened"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "choice_resolved"
                },
                "choice": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "story_point_reached"
                },
                "story_point": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "custom_event"
                },
                "custom": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "action_completed"
                },
                "action": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "check_passed"
                },
                "check": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "check_failed"
                },
                "check": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "barrier_changed"
                },
                "barrier": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "to": {
                  "$ref": "room.schema.json#/$defs/BarrierState"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "scene_ended"
                },
                "scene": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_died"
                },
                "victim": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "attack_result"
                },
                "hit": {
                  "type": "boolean"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "filled"
                },
                "kind": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "poured"
                },
                "kind": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "drank"
                },
                "kind": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": { "const": "status_ticked" },
                "status": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": { "const": "status_expired" },
                "status": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            }
          ]
        },
        "when": {
          "$ref": "policy.schema.json#/$defs/VersionedPolicy"
        },
        "apply": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "fact.assign"
                  },
                  "fact": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "value": {
                    "$ref": "delta.schema.json#/$defs/FactValue"
                  }
                },
                "required": [
                  "op",
                  "fact",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "quest.activate"
                  },
                  "quest": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "required": [
                  "op",
                  "quest"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "quest.resolve"
                  },
                  "quest": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "outcome": {
                    "$ref": "action.schema.json#/$defs/Key"
                  }
                },
                "required": [
                  "op",
                  "quest",
                  "outcome"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "quest.fail"
                  },
                  "quest": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "outcome": {
                    "$ref": "action.schema.json#/$defs/Key"
                  }
                },
                "required": [
                  "op",
                  "quest",
                  "outcome"
                ],
                "additionalProperties": false
              },
              {
                "description": "Suppress one authored population plan for duration logical seconds from this accepted fact-change cause, preserving current members and closing its current encounter.",
                "type": "object",
                "properties": {
                  "op": { "const": "population.suppress" },
                  "plan": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                  "duration": { "type": "integer", "minimum": 1 }
                },
                "required": ["op", "plan", "duration"],
                "additionalProperties": false
              },
              {
                "description": "Apply one authored status (toolbox row 1) at the cause's time to the event's subject (a body, NPC or thing, row G3), or to the named item's authored instance; an active one is refreshed; an NPC or item that declares the status immune takes nothing.",
                "type": "object",
                "properties": {
                  "op": { "const": "status.apply" },
                  "status": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                  "item": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
                },
                "required": ["op", "status"],
                "additionalProperties": false
              },
              {
                "description": "Add amount experience to the acting character's levelling row (toolbox row 4), saturating at the ResourceInt maximum; needs world.levelling.",
                "type": "object",
                "properties": {
                  "op": { "const": "experience.grant" },
                  "amount": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
                },
                "required": ["op", "amount"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "key",
        "on",
        "apply"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "gossip",
          "on": {
            "event": "fact_changed",
            "fact": {
              "cartridge_id": "ashmere_green",
              "cartridge_version": "0.0.1",
              "kind": "fact",
              "key": "green_busy"
            }
          },
          "when": {
            "policy_version": 1,
            "root": {
              "op": "fact_compare",
              "fact": {
                "cartridge_id": "ashmere_green",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "green_busy"
              },
              "equals": true
            }
          },
          "apply": [
            {
              "op": "fact.assign",
              "fact": {
                "cartridge_id": "ashmere_green",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "gossip_spread"
              },
              "value": true
            }
          ]
        },
        {
          "key": "start_search",
          "on": {
            "event": "quest_resolved",
            "quest": {
              "cartridge_id": "ashmere_missing_child",
              "cartridge_version": "0.0.9",
              "kind": "quest",
              "key": "first_lead"
            },
            "outcome": "report"
          },
          "apply": [
            {
              "op": "quest.activate",
              "quest": {
                "cartridge_id": "ashmere_missing_child",
                "cartridge_version": "0.0.9",
                "kind": "quest",
                "key": "missing_child"
              }
            }
          ]
        }
      ]
    }
  }
}
