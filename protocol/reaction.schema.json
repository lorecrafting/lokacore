{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reaction contracts",
  "description": "ReactionRule (21 \u00a73.4, \u00a711; 06 \u00a714; 04 \u00a75.2-\u00a75.4), owned by reaction@1.",
  "$defs": {
    "ReactionRule": {
      "description": "A typed reaction owned by reaction@1 (21 \u00a73.4, \u00a711; 06 \u00a714; 04 \u00a75.2-\u00a75.4), in rule-key UTF-8 order. Trigger on fact_changed of its fact, entity_entered_room into its room, or exact quest_resolved quest/outcome. Quest resolution verifies the source resolved player instance, outcome, actor and scope; its instance actor owns the delivery. Legacy triggers retain the command actor. Optional when is read on the proposal at the event time. Apply is an ordered sequence of fact.assign and, only on quest_resolved, quest.activate. Facts use their declared scope and expected values; activation skips every prior actor instance including terminal rows and emits quest-owned quest_activated. A delivery uses one writer group/causal allocator, is caused by its trigger and correlated with the root command; fact_changed remains actorless. All deliveries share the existing FIFO queue and delivery/depth/query/output budgets; faults commit nothing. New quest trigger/consequence forms require kernel API1.8.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "on": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "fact_changed"
                },
                "fact": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "fact"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_entered_room"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_resolved"
                },
                "quest": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event",
                "quest",
                "outcome"
              ],
              "additionalProperties": false
            }
          ]
        },
        "when": {
          "$ref": "policy.schema.json#/$defs/VersionedPolicy"
        },
        "apply": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "fact.assign"
                  },
                  "fact": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "value": {
                    "$ref": "delta.schema.json#/$defs/FactValue"
                  }
                },
                "required": [
                  "op",
                  "fact",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "quest.activate"
                  },
                  "quest": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "required": [
                  "op",
                  "quest"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "key",
        "on",
        "apply"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "gossip",
          "on": {
            "event": "fact_changed",
            "fact": {
              "cartridge_id": "ashmere_green",
              "cartridge_version": "0.0.1",
              "kind": "fact",
              "key": "green_busy"
            }
          },
          "when": {
            "policy_version": 1,
            "root": {
              "op": "fact_compare",
              "fact": {
                "cartridge_id": "ashmere_green",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "green_busy"
              },
              "equals": true
            }
          },
          "apply": [
            {
              "op": "fact.assign",
              "fact": {
                "cartridge_id": "ashmere_green",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "gossip_spread"
              },
              "value": true
            }
          ]
        },
        {
          "key": "start_search",
          "on": {
            "event": "quest_resolved",
            "quest": {
              "cartridge_id": "ashmere_missing_child",
              "cartridge_version": "0.0.9",
              "kind": "quest",
              "key": "first_lead"
            },
            "outcome": "report"
          },
          "apply": [
            {
              "op": "quest.activate",
              "quest": {
                "cartridge_id": "ashmere_missing_child",
                "cartridge_version": "0.0.9",
                "kind": "quest",
                "key": "missing_child"
              }
            }
          ]
        }
      ]
    }
  }
}
