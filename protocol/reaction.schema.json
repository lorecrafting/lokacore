{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reaction contracts",
  "description": "ReactionRule (21 \u00a73.4, \u00a711; 06 \u00a714; 04 \u00a75.2-\u00a75.4), owned by reaction@1.",
  "$defs": {
    "ReactionRule": {
      "description": "A rule that runs steps when something happens in the game: when names the event (such as a fact changing), any filters must match it, and the steps then change the world, such as setting a fact or starting a quest.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "on": {"description":"What sets this reaction off: one event, optionally narrowed to a room, item, NPC and so on. Example: {\"event\": \"item_acquired\", \"item\": \"key\"}.",
          "oneOf": [
            {"description":"A fact's value changed.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "fact_changed"
                },
                "fact": {"description":"Only this fact.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "fact"
              ],
              "additionalProperties": false
            },
            {"description":"Someone entered a room.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_entered_room"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "npc": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The one entering is the NPC placed in the world from this definition."
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Someone said a word an NPC heard; fires once for each NPC that heard it.",
              "properties": {
                "event": {
                  "const": "spoken"
                },
                "npc": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The one hearing is the NPC placed in the world from this definition."
                },
                "word": {"description":"The word that fires it.",
                  "$ref": "dialogue.schema.json#/$defs/SpokenKeyword"
                },
                "loudness": {"description":"Only this loudness.",
                  "$ref": "event.schema.json#/$defs/Loudness"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "A character reached a level.",
              "properties": {
                "event": {
                  "const": "level_reached"
                },
                "level": {
                  "type": "integer",
                  "minimum": 2,
                  "description": "The event is for this level."
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "The player asked an NPC about a topic.",
              "properties": {
                "event": {
                  "const": "asked"
                },
                "npc": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The NPC asked is the one placed in the world from this definition."
                },
                "topic": {"description":"Only this topic.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "answered": {"description":"Only asks that were, or were not, answered.",
                  "type": "boolean"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A quest was completed with an outcome.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_resolved"
                },
                "quest": {"description":"Only this quest.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {"description":"Only this outcome.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event",
                "quest",
                "outcome"
              ],
              "additionalProperties": false
            },
            {"description":"The player rested.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "rested"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {"description":"An item came into someone's hands: picked up, bought, given, harvested or stolen.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "item_acquired"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The NPC placed in the world from this definition, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "item": {"description":"Only this item.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"An item was dropped.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "item_dropped"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The NPC placed in the world from this definition, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "item": {"description":"Only this item.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A creature was shooed away from an item.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "shooed"
                },
                "item": {"description":"Only this item.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A quest started.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_activated"
                },
                "quest": {"description":"Only this quest.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A choice was put in front of the player, in a conversation, a scene or speech.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "choice_opened"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"The player picked an option in a choice.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "choice_resolved"
                },
                "choice": {"description":"Only this choice.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A story point was reached.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "story_point_reached"
                },
                "story_point": {"description":"Only this story point.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {"description":"Only this outcome.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A custom event sent by an event.emit step.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "custom_event"
                },
                "custom": {"description":"The custom event key.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A scripted action finished.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "action_completed"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The NPC placed in the world from this definition, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "action": {"description":"Only this action.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A check passed.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "check_passed"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The NPC placed in the world from this definition, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "check": {"description":"Only the check with this key.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A check failed.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "check_failed"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The NPC placed in the world from this definition, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "check": {"description":"Only the check with this key.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A door or other barrier changed state, such as opened or locked.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "barrier_changed"
                },
                "barrier": {"description":"Only this barrier.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "to": {"description":"Only this new state.",
                  "$ref": "room.schema.json#/$defs/BarrierState"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A scene ended.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "scene_ended"
                },
                "scene": {"description":"Only this scene.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"Someone died.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_died"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The NPC placed in the world from this definition, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "victim": {"description":"Only this victim.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"An attack hit or missed.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "attack_result"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The NPC placed in the world from this definition, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "hit": {"description":"Only hits, or only misses.",
                  "type": "boolean"
                },
                "attacker": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The attacker is the NPC placed in the world from this definition; a player's blow never matches."
                },
                "target": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The target is this NPC itself; a blow on the player never matches."
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A vessel was filled with a liquid.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "filled"
                },
                "kind": {"description":"Only this liquid.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"A liquid was poured out.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "poured"
                },
                "kind": {"description":"Only this liquid.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"Someone drank a liquid.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "drank"
                },
                "kind": {"description":"Only this liquid.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "description": "Fires at the start of every hour of the game day.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "clock_hour"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {"description":"An active status took effect again, such as poison each tick.",
              "type": "object",
              "properties": {
                "event": { "const": "status_ticked" },
                "status": {"description":"Only this status.", "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "A status was put on someone.",
              "properties": {
                "event": { "const": "status_applied" },
                "status": {"description":"Only this status.", "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {"description":"A status wore off.",
              "type": "object",
              "properties": {
                "event": { "const": "status_expired" },
                "status": {"description":"Only this status.", "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {"description":"A quest failed.",
              "type": "object",
              "properties": {
                "event": { "const": "quest_failed" },
                "quest": {"description":"Only this quest.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                "outcome": {"description":"Only this outcome.", "$ref": "action.schema.json#/$defs/Key" }
              },
              "required": ["event"],
              "additionalProperties": false
            }
          ]
        },
        "when": {"description":"A condition that must also hold for the reaction to run.",
          "$ref": "policy.schema.json#/$defs/Policy"
        },
        "silent": {
          "description": "Says the rule changes things without telling the player, on purpose, so the checker does not warn. Used only while writing; the finished game drops it.",
          "const": true
        },
        "after": {
          "description": "The steps run this many logical seconds after delivery, as a reaction job for the delivery's actor, when `when` holds at both times; due no earlier than 1 s after the proposal's clock.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "steps": {"description":"What happens, in order.",
          "type": "array",
          "items": { "$ref": "step.schema.json#/$defs/Step" }
        }
      },
      "required": [
        "key",
        "on",
        "steps"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "gossip",
          "on": {
            "event": "fact_changed",
            "fact": {
              "cartridge_id": "green_sampler",
              "cartridge_version": "0.0.1",
              "kind": "fact",
              "key": "green_busy"
            }
          },
          "when": {
            "op": "fact_compare",
            "fact": {
              "cartridge_id": "green_sampler",
              "cartridge_version": "0.0.1",
              "kind": "fact",
              "key": "green_busy"
            },
            "equals": true
          },
          "steps": [
            {
              "op": "fact.assign",
              "fact": {
                "cartridge_id": "green_sampler",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "gossip_spread"
              },
              "value": true
            }
          ]
        },
        {
          "key": "start_search",
          "on": {
            "event": "quest_resolved",
            "quest": {
              "cartridge_id": "village_chapter",
              "cartridge_version": "0.0.9",
              "kind": "quest",
              "key": "first_lead"
            },
            "outcome": "report"
          },
          "steps": [
            {
              "op": "quest.activate",
              "quest": {
                "cartridge_id": "village_chapter",
                "cartridge_version": "0.0.9",
                "kind": "quest",
                "key": "lost_lamb"
              }
            }
          ]
        }
      ]
    }
  }
}
