{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reaction contracts",
  "description": "ReactionRule (21 \u00a73.4, \u00a711; 06 \u00a714; 04 \u00a75.2-\u00a75.4), owned by reaction@1.",
  "$defs": {
    "ReactionRule": {
      "description": "Typed reaction owned by reaction@1. Every registered event kind can trigger; each optional filter must equal its payload field (W1). Every delivery runs for the command actor; quest resolution verifies the source instance; a status.apply hits the event's subject or its named item (docs/system/mechanics.md reaction@1). Steps may assign facts (an entity or pair fact, toolbox row W2, at its named npc's or item's instance, else at the event's subject when that is an NPC, item or detail; no subject, no write) or activate a quest on quest_resolved. API1.12 adds typed quest.resolve and quest.fail on fact_changed. Deliveries use one writer group and the existing FIFO budgets; faults commit nothing.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "on": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "fact_changed"
                },
                "fact": {"description":"Only this fact.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "fact"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_entered_room"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "npc": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The entrant is this NPC's authored instance (toolbox row W3)."
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Toolbox row G9 (speech@1): one spoken event per NPC that heard the word.",
              "properties": {
                "event": {
                  "const": "spoken"
                },
                "npc": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The hearer is this NPC's authored instance."
                },
                "word": {"description":"The word that fires it.",
                  "$ref": "dialogue.schema.json#/$defs/SpokenKeyword"
                },
                "loudness": {"description":"Only this loudness.",
                  "$ref": "event.schema.json#/$defs/Loudness"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Toolbox row 4 (attribute@1): a character reached a level.",
              "properties": {
                "event": {
                  "const": "level_reached"
                },
                "level": {
                  "type": "integer",
                  "minimum": 2,
                  "description": "The event is for this level."
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Toolbox row FD7 (speech@1): the actor asked an NPC about a topic.",
              "properties": {
                "event": {
                  "const": "asked"
                },
                "npc": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The asked NPC is this NPC's authored instance."
                },
                "topic": {"description":"Only this topic.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "answered": {"description":"Only asks that were, or were not, answered.",
                  "type": "boolean"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_resolved"
                },
                "quest": {"description":"Only this quest.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {"description":"Only this outcome.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event",
                "quest",
                "outcome"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "rested"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "item_acquired"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "Toolbox row FD5: this NPC's authored instance, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "item": {"description":"Only this item.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "item_dropped"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "Toolbox row FD5: this NPC's authored instance, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "item": {"description":"Only this item.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "shooed"
                },
                "item": {"description":"Only this item.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_activated"
                },
                "quest": {"description":"Only this quest.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "choice_opened"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "choice_resolved"
                },
                "choice": {"description":"Only this choice.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "story_point_reached"
                },
                "story_point": {"description":"Only this story point.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {"description":"Only this outcome.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "custom_event"
                },
                "custom": {"description":"The custom event key.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "action_completed"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "Toolbox row FD5: this NPC's authored instance, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "action": {"description":"Only this action.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "check_passed"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "Toolbox row FD5: this NPC's authored instance, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "check": {"description":"Only this action's check.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "check_failed"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "Toolbox row FD5: this NPC's authored instance, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "check": {"description":"Only this action's check.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "barrier_changed"
                },
                "barrier": {"description":"Only this barrier.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "to": {"description":"Only this new state.",
                  "$ref": "room.schema.json#/$defs/BarrierState"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "scene_ended"
                },
                "scene": {"description":"Only this scene.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_died"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "Toolbox row FD5: this NPC's authored instance, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "victim": {"description":"Only this victim.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {"description":"Only this room.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "attack_result"
                },
                "witness": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "Toolbox row FD5: this NPC's authored instance, alive in the event subject's room, sees the subject (not blind, the subject not concealed from it); an event's subject is never its own witness."
                },
                "hit": {"description":"Only hits, or only misses.",
                  "type": "boolean"
                },
                "attacker": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The attacker is this NPC's authored instance (loka-kgd.79); a player's blow never matches."
                },
                "target": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The target is this NPC's authored instance (row 39); a blow on the player never matches."
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "filled"
                },
                "kind": {"description":"Only this liquid.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "poured"
                },
                "kind": {"description":"Only this liquid.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "drank"
                },
                "kind": {"description":"Only this liquid.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "description": "The world's hourly calendar event (toolbox row W25; schedule@1): no filters; a status lands on the actor's body.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "clock_hour"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": { "const": "status_ticked" },
                "status": {"description":"Only this status.", "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Toolbox row G3 reader 2.",
              "properties": {
                "event": { "const": "status_applied" },
                "status": {"description":"Only this status.", "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": { "const": "status_expired" },
                "status": {"description":"Only this status.", "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": { "const": "quest_failed" },
                "quest": {"description":"Only this quest.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                "outcome": {"description":"Only this outcome.", "$ref": "action.schema.json#/$defs/Key" }
              },
              "required": ["event"],
              "additionalProperties": false
            }
          ]
        },
        "when": {
          "$ref": "policy.schema.json#/$defs/Policy"
        },
        "silent": {
          "description": "Author-time only (mix loka.lint, pass-1 row 3): the rule writes state without a narrate step on purpose. The compiler drops it, so a compiled cartridge never carries it.",
          "const": true
        },
        "after": {
          "description": "Toolbox row FD1: the steps run this many logical seconds after delivery, as a reaction job for the delivery's actor, when `when` holds at both times; due no earlier than 1 s after the proposal's clock.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "step.schema.json#/$defs/Step" }
        }
      },
      "required": [
        "key",
        "on",
        "steps"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "gossip",
          "on": {
            "event": "fact_changed",
            "fact": {
              "cartridge_id": "green_sampler",
              "cartridge_version": "0.0.1",
              "kind": "fact",
              "key": "green_busy"
            }
          },
          "when": {
            "op": "fact_compare",
            "fact": {
              "cartridge_id": "green_sampler",
              "cartridge_version": "0.0.1",
              "kind": "fact",
              "key": "green_busy"
            },
            "equals": true
          },
          "steps": [
            {
              "op": "fact.assign",
              "fact": {
                "cartridge_id": "green_sampler",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "gossip_spread"
              },
              "value": true
            }
          ]
        },
        {
          "key": "start_search",
          "on": {
            "event": "quest_resolved",
            "quest": {
              "cartridge_id": "village_chapter",
              "cartridge_version": "0.0.9",
              "kind": "quest",
              "key": "first_lead"
            },
            "outcome": "report"
          },
          "steps": [
            {
              "op": "quest.activate",
              "quest": {
                "cartridge_id": "village_chapter",
                "cartridge_version": "0.0.9",
                "kind": "quest",
                "key": "lost_lamb"
              }
            }
          ]
        }
      ]
    }
  }
}
