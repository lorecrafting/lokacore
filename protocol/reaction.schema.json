{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reaction contracts",
  "description": "ReactionRule (21 \u00a73.4, \u00a711; 06 \u00a714; 04 \u00a75.2-\u00a75.4), owned by reaction@1.",
  "$defs": {
    "ReactionRule": {
      "description": "Typed reaction owned by reaction@1. Every registered event kind can trigger; each optional filter must equal its payload field (W1). Every delivery runs for the command actor; quest resolution verifies the source instance; a status.apply hits the event's subject or its named item (docs/system/mechanics.md reaction@1). Apply may assign facts (an entity or pair fact, toolbox row W2, at its named npc's or item's instance, else at the event's subject when that is an NPC, item or detail; no subject, no write) or activate a quest on quest_resolved. API1.12 adds typed quest.resolve and quest.fail on fact_changed. Deliveries use one writer group and the existing FIFO budgets; faults commit nothing.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "on": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "fact_changed"
                },
                "fact": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "fact"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_entered_room"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "npc": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The entrant is this NPC's authored instance (toolbox row W3). Needs kernel_api at least 1.47."
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Toolbox row G9 (speech@1; kernel_api at least 1.48): one spoken event per NPC that heard the word.",
              "properties": {
                "event": {
                  "const": "spoken"
                },
                "npc": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The hearer is this NPC's authored instance."
                },
                "word": {
                  "$ref": "dialogue.schema.json#/$defs/SpokenKeyword"
                },
                "loudness": {
                  "$ref": "event.schema.json#/$defs/Loudness"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_resolved"
                },
                "quest": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event",
                "quest",
                "outcome"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "rested"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event",
                "room"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "item_acquired"
                },
                "item": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "item_dropped"
                },
                "item": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "shooed"
                },
                "item": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "quest_activated"
                },
                "quest": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "choice_opened"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "choice_resolved"
                },
                "choice": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "story_point_reached"
                },
                "story_point": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "custom_event"
                },
                "custom": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "action_completed"
                },
                "action": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "check_passed"
                },
                "check": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "check_failed"
                },
                "check": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "barrier_changed"
                },
                "barrier": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "to": {
                  "$ref": "room.schema.json#/$defs/BarrierState"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "scene_ended"
                },
                "scene": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "entity_died"
                },
                "victim": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "attack_result"
                },
                "hit": {
                  "type": "boolean"
                },
                "attacker": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef",
                  "description": "The attacker is this NPC's authored instance (loka-kgd.79); a player's blow never matches. Needs kernel_api at least 1.58."
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "filled"
                },
                "kind": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "poured"
                },
                "kind": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": {
                  "const": "drank"
                },
                "kind": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "description": "The world's hourly calendar event (toolbox row W25; schedule@1): no filters; a status lands on the actor's body. Needs kernel_api at least 1.46.",
              "type": "object",
              "properties": {
                "event": {
                  "const": "clock_hour"
                }
              },
              "required": [
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": { "const": "status_ticked" },
                "status": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Toolbox row G3 reader 2 (kernel_api at least 1.53).",
              "properties": {
                "event": { "const": "status_applied" },
                "status": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": { "const": "status_expired" },
                "status": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
              },
              "required": ["event"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "event": { "const": "quest_failed" },
                "quest": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                "outcome": { "$ref": "action.schema.json#/$defs/Key" }
              },
              "required": ["event"],
              "additionalProperties": false
            }
          ]
        },
        "when": {
          "$ref": "policy.schema.json#/$defs/VersionedPolicy"
        },
        "apply": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "fact.assign"
                  },
                  "fact": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "npc": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "item": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "value": {
                    "$ref": "delta.schema.json#/$defs/FactValue"
                  }
                },
                "required": [
                  "op",
                  "fact",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "description": "Toolbox row 15 (kernel_api at least 1.47): adds amount to a bounded int fact, clamped to its minimum and maximum, at the subject a fact.assign step writes at.",
                "type": "object",
                "properties": {
                  "op": {
                    "const": "fact.adjust"
                  },
                  "fact": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "npc": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "item": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "amount": {
                    "type": "integer"
                  }
                },
                "required": [
                  "op",
                  "fact",
                  "amount"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "quest.activate"
                  },
                  "quest": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "required": [
                  "op",
                  "quest"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "quest.resolve"
                  },
                  "quest": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "outcome": {
                    "$ref": "action.schema.json#/$defs/Key"
                  }
                },
                "required": [
                  "op",
                  "quest",
                  "outcome"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "quest.fail"
                  },
                  "quest": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "outcome": {
                    "$ref": "action.schema.json#/$defs/Key"
                  }
                },
                "required": [
                  "op",
                  "quest",
                  "outcome"
                ],
                "additionalProperties": false
              },
              {
                "description": "Suppress one authored population plan for duration logical seconds from this accepted fact-change cause, preserving current members and closing its current encounter.",
                "type": "object",
                "properties": {
                  "op": { "const": "population.suppress" },
                  "plan": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                  "duration": { "type": "integer", "minimum": 1 }
                },
                "required": ["op", "plan", "duration"],
                "additionalProperties": false
              },
              {
                "description": "Apply one authored status (toolbox row 1) at the cause's time to the event's subject (a body, NPC or thing, row G3), or to the named item's or (row 42, never with item; not a spawn template) NPC's authored instance, or (row W21, co_present) to every living NPC in the event's room; an active one is refreshed; an NPC or item that declares the status immune takes nothing.",
                "type": "object",
                "properties": {
                  "op": { "const": "status.apply" },
                  "status": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                  "item": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                  "npc": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                  "room": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef",
                    "description": "Status reader 9 (kernel_api at least 1.65): the status lands on this room of the cartridge, which holds it as any holder does (its tick changes nothing). Never with item, npc or co_present (compiler and loader SCHEMA_VIOLATION)."
                  },
                  "co_present": {
                    "enum": [true],
                    "description": "Toolbox row W21 (kernel_api at least 1.50): the status lands on every living NPC in the event's room (its room_id, else the room directly holding the subject; none for a carried or unplaced one), in EntityId order, never on the player's body; an NPC declaring the status immune takes nothing. Never with item or npc (compiler and loader SCHEMA_VIOLATION)."
                  },
                  "tag": {
                    "$ref": "entity.schema.json#/$defs/Tag",
                    "description": "Toolbox row W22 (kernel_api at least 1.56; only with co_present): the status lands instead on every item lying directly in the event's room whose definition carries this tag, the event's subject included, in EntityId order; an item declaring the status immune takes nothing."
                  }
                },
                "dependentRequired": { "tag": ["co_present"] },
                "required": ["op", "status"],
                "additionalProperties": false
              },
              {
                "description": "Toolbox row W22 (Beads loka-kgd.96; kernel_api at least 1.56, barrier@1): move barrier, or every barrier on an exit of the event's room (its room_id, else the room directly holding the subject) whose definition carries tag, in direction-key order, to state to, from any state and with no key, opens_when or reach check (a burnt or broken door); each legal step on the way (locked, closed, open) is one barrier.transition and one barrier_changed, and a barrier already at to takes nothing. to locked needs the barrier's key_item, every tagged barrier's for tag (compiler and loader BARRIER_UNREACHABLE_KEY at to).",
                "type": "object",
                "properties": {
                  "op": { "const": "barrier.set" },
                  "to": { "$ref": "room.schema.json#/$defs/BarrierState" },
                  "barrier": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
                  "tag": { "$ref": "entity.schema.json#/$defs/Tag" }
                },
                "exactlyOneRequired": ["barrier", "tag"],
                "required": ["op", "to"],
                "additionalProperties": false
              },
              {
                "description": "Toolbox row G3 reader 3 (kernel_api at least 1.53): end this status when active on the event's subject (the holder a status.apply without item, npc or co_present lands on), as a cure does: no event, no line. Once per holder and status in a rule, shared with status.apply: the first of the two steps on a pair wins.",
                "type": "object",
                "properties": {
                  "op": { "const": "status.cure" },
                  "status": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
                },
                "required": ["op", "status"],
                "additionalProperties": false
              },
              {
                "description": "Add amount experience to the acting character's levelling row (toolbox row 4), saturating at the ResourceInt maximum; needs world.levelling.",
                "type": "object",
                "properties": {
                  "op": { "const": "experience.grant" },
                  "amount": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
                },
                "required": ["op", "amount"],
                "additionalProperties": false
              },
              {
                "description": "Toolbox row 41 (decay; kernel_api at least 1.77): when the event's subject is an item not already directly in room and not consumed, transfer it from its current holder to room (one entity.transfer, no event, no line, no capacity or reach check); any other subject takes nothing.",
                "type": "object",
                "properties": {
                  "op": { "const": "item.move" },
                  "room": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
                },
                "required": ["op", "room"],
                "additionalProperties": false
              },
              {
                "description": "Toolbox row 37a (phased world events; kernel_api at least 1.84): births one bundle of the population plan into its home, in the highest free slot up to cap, as the plan job's birth does; no free slot births nothing. No RNG draw (the plan's chance and targets govern its own job only).",
                "type": "object",
                "properties": {
                  "op": { "const": "population.spawn" },
                  "plan": { "$ref": "identity.schema.json#/$defs/DefinitionRef" }
                },
                "required": ["op", "plan"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "key",
        "on",
        "apply"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "gossip",
          "on": {
            "event": "fact_changed",
            "fact": {
              "cartridge_id": "ashmere_green",
              "cartridge_version": "0.0.1",
              "kind": "fact",
              "key": "green_busy"
            }
          },
          "when": {
            "policy_version": 1,
            "root": {
              "op": "fact_compare",
              "fact": {
                "cartridge_id": "ashmere_green",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "green_busy"
              },
              "equals": true
            }
          },
          "apply": [
            {
              "op": "fact.assign",
              "fact": {
                "cartridge_id": "ashmere_green",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "gossip_spread"
              },
              "value": true
            }
          ]
        },
        {
          "key": "start_search",
          "on": {
            "event": "quest_resolved",
            "quest": {
              "cartridge_id": "ashmere_missing_child",
              "cartridge_version": "0.0.9",
              "kind": "quest",
              "key": "first_lead"
            },
            "outcome": "report"
          },
          "apply": [
            {
              "op": "quest.activate",
              "quest": {
                "cartridge_id": "ashmere_missing_child",
                "cartridge_version": "0.0.9",
                "kind": "quest",
                "key": "missing_child"
              }
            }
          ]
        }
      ]
    }
  }
}
