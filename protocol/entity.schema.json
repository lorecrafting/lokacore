{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item and NPC contracts",
  "description": "Items and NPCs, the things containment moves and holds (21 §8 Containment; 03 §23; 00 §4.4; 00a §5, §12), owned by containment (capability_registry.json). R5 slice 4: what take, drop and give need. Each is a RuntimeEntity: a fresh world gives it an EntityId (numeric profile, Initial world ids) and one container, the only place its location is stored (03 §23); a holder's contents and an actor's inventory are derived from it. Text follows the four LegendMUD tiers (owner decision 2026-09-25, Q1): keywords the player types, a short description for action messages and the inventory, a room line for the room's contents, and a description for examine. An item's equipment slot joins with equipment@1 (chapter-one slice c1-equipment); stacking, weight and put join with their capabilities as optional fields.",
  "$defs": {
    "ItemLocation": {
      "description": "Where an item starts (00a §12 location): in a room, held by an NPC, or inside another item of the same cartridge, named by the field its kind selects. The containers an artifact's items start in form no cycle (CONTAINMENT_CYCLE) and hold at most their capacity (CAPACITY_EXCEEDED).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "in": {
              "const": "room"
            },
            "room": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "in",
            "room"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "in": {
              "const": "npc"
            },
            "npc": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "in",
            "npc"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "in": {
              "const": "item"
            },
            "item": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "in",
            "item"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "in": {
              "const": "template"
            }
          },
          "required": [
            "in"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "in": "room",
          "room": {
            "cartridge_id": "ashmere_items",
            "cartridge_version": "0.0.1",
            "kind": "room",
            "key": "ferry_landing"
          }
        },
        {
          "in": "item",
          "item": {
            "cartridge_id": "ashmere_items",
            "cartridge_version": "0.0.1",
            "kind": "item",
            "key": "satchel"
          }
        }
      ]
    },
    "SlotKey": {
      "description": "An equipment slot (equipment@1; 00 §4.4 and 21 §8 as amended by c1-equipment): the thirteen keys. A fresh world makes one holder entity inside the body per slot some item declares, capacity 2 for finger (two fingers, toolbox row 3) and 1 for every other slot (numeric profile, Slot holder ids).",
      "enum": [
        "head",
        "neck",
        "body",
        "cloak",
        "arms",
        "hands",
        "finger",
        "waist",
        "legs",
        "feet",
        "wield",
        "off_hand",
        "light"
      ],
      "examples": [
        "head",
        "neck",
        "body",
        "cloak",
        "arms",
        "hands",
        "finger",
        "waist",
        "legs",
        "feet",
        "wield",
        "off_hand",
        "light"
      ]
    },
    "ItemAffect": {
      "description": "One attribute modifier an item grants its wearer while worn (docs/system/mechanics.md item slots and affects, toolbox row 3; the shape of an ancestry's attribute modifier): attribute, an attribute of this cartridge; modifier, the signed amount added to the value attributes@1 reads. The number is the cartridge's.",
      "type": "object",
      "properties": {
        "attribute": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "modifier": {
          "$ref": "resource.schema.json#/$defs/ResourceInt"
        }
      },
      "required": [
        "attribute",
        "modifier"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "attribute": {
            "cartridge_id": "c",
            "cartridge_version": "1.0.0",
            "kind": "attribute",
            "key": "per"
          },
          "modifier": 2
        }
      ]
    },
    "ItemDefinition": {
      "description": "A portable thing (21 §8): its key; keywords, the Alias words a player names it by (target resolution); short, the text key of its short description (\"a brass lantern\"); room_line, the text key of the line a room shows while it lies there (\"A brass lantern sits here.\"), with room_line_variants (DescriptionVariant, first match wins, as for a room's description); description, the text key examine shows; location, where a fresh world puts it; and optionally container: true, making it a receptacle; only receptacles may declare capacity, the most items held directly (without capacity a receptacle has no limit); optionally slot, the SlotKey it is worn in (equipment@1), with optional affects (ItemAffect), each added to the wearer's attribute while the item is worn (toolbox row 3; needs slot and attributes@1, kernel_api at least 1.41); and optionally barrier, the barrier on it (a container's lid, barrier@1, c1-locks): a barrier of this cartridge that no exit and no other item names (BARRIER_MISMATCH), whose state the door verbs change with the item as target_id; while it is closed or locked, what the item holds is out of reach (containment@1 custody). Optional mass_grams is the shell mass, required for every item when world.carry is authored. Optional tags are its property tags (Tag, toolbox row G1). Optional short_variants and description_variants vary its short and description (TextVariants, toolbox row W6).",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "keywords": {
          "type": "array",
          "items": {
            "$ref": "room.schema.json#/$defs/Alias"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "short": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "short_variants": {
          "$ref": "#/$defs/TextVariants"
        },
        "room_line": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "room_line_variants": {
          "$ref": "#/$defs/TextVariants"
        },
        "description": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "description_variants": {
          "$ref": "#/$defs/TextVariants"
        },
        "location": {
          "$ref": "#/$defs/ItemLocation"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "slot": {
          "$ref": "#/$defs/SlotKey"
        },
        "affects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/ItemAffect"
          }
        },
        "barrier": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "mass_grams": {
          "description": "The item shell mass in grams, excluding its contents. Required on every item under world.carry; explicit zero is valid (docs/system/cartridge.md Carrying settings and item mass).",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "give_allowed": {
          "description": "API1.10: false prevents ordinary Give of this item or any container holding it transitively; absence permits Give when contents allow it. Dialogue hand_over remains legal.",
          "const": false
        },
        "container": {
          "description": "Only explicitly authored receptacles hold items. Absence is false; capacity and barrier require this field.",
          "const": true
        },
        "fuel": {
          "$ref": "#/$defs/FuelSpec"
        },
        "weapon": {
          "$ref": "entity.schema.json#/$defs/WeaponProfile"
        },
        "block_chance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "vessel": {
          "$ref": "liquid.schema.json#/$defs/VesselSpec"
        },
        "readable": {
          "$ref": "#/$defs/ItemReadable"
        },
        "edible": {
          "$ref": "#/$defs/ItemEdible"
        },
        "bandage": {
          "$ref": "entity.schema.json#/$defs/ItemBandage"
        },
        "tags": {
          "description": "Its property tags (Tag; toolbox row G1), read by the has_tag policy leaf (tags@1).",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "entity.schema.json#/$defs/Tag"
          }
        },
        "immune": {
          "description": "Toolbox row G3: statuses that status.apply skips on this item's instance; each names a declared status (kernel_api 1.46).",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "identity.schema.json#/$defs/DefinitionRef"
          }
        }
      },
      "required": [
        "key",
        "keywords",
        "short",
        "room_line",
        "description",
        "location"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "lantern",
          "keywords": [
            "lantern",
            "brass_lantern"
          ],
          "short": "item.lantern.short",
          "room_line": "item.lantern.room",
          "description": "item.lantern.description",
          "location": {
            "in": "room",
            "room": {
              "cartridge_id": "ashmere_items",
              "cartridge_version": "0.0.1",
              "kind": "room",
              "key": "ferry_landing"
            }
          },
          "slot": "light"
        },
        {
          "key": "satchel",
          "keywords": [
            "satchel"
          ],
          "short": "item.satchel.short",
          "room_line": "item.satchel.room",
          "room_line_variants": [
            {
              "when": {
                "policy_version": 1,
                "root": {
                  "op": "has_item",
                  "item": {
                    "cartridge_id": "ashmere_items",
                    "cartridge_version": "0.0.1",
                    "kind": "item",
                    "key": "lantern"
                  }
                }
              },
              "description": "item.satchel.room_empty"
            }
          ],
          "description": "item.satchel.description",
          "location": {
            "in": "npc",
            "npc": {
              "cartridge_id": "ashmere_items",
              "cartridge_version": "0.0.1",
              "kind": "npc",
              "key": "bram"
            }
          },
          "capacity": 2,
          "container": true
        }
      ]
    },
    "Tag": {
      "description": "A property tag (toolbox row G1): a closed engine vocabulary, so every mechanic that gives a tag meaning and every cartridge that declares one share its spelling. Item, barrier and room definitions declare tags; the has_tag policy leaf (tags@1) reads them. A row whose mechanic needs a new tag adds it here.",
      "enum": [
        "burnable",
        "cool",
        "exposed",
        "fragile",
        "liquid_holding",
        "metal",
        "sharp",
        "silver",
        "warm",
        "waterproof",
        "windproof",
        "wooden"
      ],
      "examples": [
        "burnable",
        "metal"
      ]
    },
    "DamageKind": {
      "description": "A damage kind (toolbox row G2): a closed engine vocabulary shared by attack profiles and NPC resistances. A row that needs a new kind adds it here; a kind never shares a name with a Tag.",
      "enum": [
        "cold",
        "fire",
        "physical",
        "poison"
      ],
      "examples": [
        "physical",
        "fire"
      ]
    },
    "ResistancePercent": {
      "description": "A resistance percent (toolbox row G2): negative is a weakness.",
      "type": "integer",
      "minimum": -100,
      "maximum": 100,
      "examples": [
        50,
        -50
      ]
    },
    "Resistances": {
      "description": "Toolbox row G2 (docs/system/mechanics.md damage model; kernel_api at least 1.44): an NPC's percent resistance per damage kind (DamageKind) and per material tag (Tag) of the weapon whose own attack strikes (an unarmed or NPC attack has none); negative is a weakness. An attack sums the entries for its kind and each such tag, clamps the sum to -100..100 and scales its damage by (100 - sum) / 100, rounded down. Its members are exactly the DamageKind and Tag values.",
      "type": "object",
      "properties": {
        "cold": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "fire": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "physical": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "poison": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "burnable": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "cool": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "exposed": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "fragile": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "liquid_holding": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "metal": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "sharp": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "silver": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "warm": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "waterproof": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "windproof": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        },
        "wooden": {
          "$ref": "entity.schema.json#/$defs/ResistancePercent"
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "physical": 50,
          "fire": 75,
          "silver": -50
        }
      ]
    },
    "NpcDefinition": {
      "description": "A non-player character (00a §4), as a holder of items so far: its key, keywords, short, room_line and description as for an item, the room a fresh world puts it in, and optionally capacity, the most items it holds. Optionally daily_schedule, its daily location schedule (behavior@1); dialogue joins with its capability as an optional field. Optional hp opts into entity-specific HP under kernel API 1.4 (docs/system/cartridge.md NPC HP overrides). Optional short_variants, room_line_variants and description_variants vary its texts (TextVariants, toolbox row W6).",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "keywords": {
          "type": "array",
          "items": {
            "$ref": "room.schema.json#/$defs/Alias"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "short": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "short_variants": {
          "$ref": "#/$defs/TextVariants"
        },
        "room_line": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "room_line_variants": {
          "$ref": "#/$defs/TextVariants"
        },
        "description": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "description_variants": {
          "$ref": "#/$defs/TextVariants"
        },
        "room": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "daily_schedule": {
          "description": "behavior@1 (06 §13 Behavior/schedule profiles; 21 §10; capability_registry.json definitions): a daily location schedule. Each key is a nonnegative hour of the authored calendar day without a leading zero; the compiler and loader check it is below hours_per_day. From that hour until the next listed one (wrapping at day end) the NPC belongs in that room of this cartridge. A fresh world schedules one durable job at the first listed hour strictly after its start time; each job's run_job moves the NPC there, if it is elsewhere, and schedules the next (04 §5.4). Until its first job runs, the NPC stays in its room. An empty schedule schedules nothing.",
          "type": "object",
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "$ref": "identity.schema.json#/$defs/DefinitionRef"
          }
        },
        "hp": {
          "$ref": "resource.schema.json#/$defs/NpcHp"
        },
        "resource_starts": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "resource.schema.json#/$defs/ResourceInt"
          }
        },
        "attack": {
          "$ref": "entity.schema.json#/$defs/AttackProfile"
        },
        "shop": {
          "$ref": "entity.schema.json#/$defs/Shop"
        },
        "perception": {
          "type": "object",
          "properties": {
            "discovered": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "discovered"
          ],
          "additionalProperties": false
        },
        "spawn_template": {
          "const": true
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "identity.schema.json#/$defs/DefinitionRef"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "drops": {
          "description": "Toolbox row 8 loot table (docs/system/mechanics.md loot tables; kernel_api at least 1.43, world.death): in order, an item this NPC holds at genesis and its percent chance of passing to the corpse when combat kills the NPC; a failed item stays with the dead NPC.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "chance": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "item",
              "chance"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 8
        },
        "resistances": {
          "$ref": "entity.schema.json#/$defs/Resistances"
        },
        "immune": {
          "description": "Toolbox row G3: statuses that status.apply skips on this NPC's instance; each names a declared status (kernel_api 1.46).",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "identity.schema.json#/$defs/DefinitionRef"
          }
        },
        "attributes": {
          "description": "Toolbox row G3: this NPC's base attribute values (attributes@1, kernel_api 1.46), read at use by an opposed check naming the NPC and by its derived attack; each names a distinct attribute of this cartridge. An attribute it does not list reads its definition start.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "attribute": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "value": {
                "$ref": "resource.schema.json#/$defs/ResourceInt"
              }
            },
            "required": [
              "attribute",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "keywords",
        "short",
        "room_line",
        "description",
        "room"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "bram",
          "keywords": [
            "bram",
            "ferryman"
          ],
          "short": "npc.bram.short",
          "room_line": "npc.bram.room",
          "description": "npc.bram.description",
          "room": {
            "cartridge_id": "ashmere_items",
            "cartridge_version": "0.0.1",
            "kind": "room",
            "key": "ferry_landing"
          },
          "capacity": 1
        }
      ]
    },
    "TextVariants": {
      "description": "Toolbox row W6: variants of one entity text (short, room_line or description), the first whose condition holds replacing it (DescriptionVariant, as for a room's description); the base text stays mandatory. Each condition reads with the entity itself as the target (status_active subject target). An item's room_line_variants predate the row; every other entity variant needs kernel_api at least 1.46.",
      "type": "array",
      "items": {
        "$ref": "room.schema.json#/$defs/DescriptionVariant"
      },
      "minItems": 1,
      "maxItems": 16,
      "examples": [
        [
          {
            "when": {
              "policy_version": 1,
              "root": {
                "op": "status_active",
                "subject": "target",
                "status": {
                  "cartridge_id": "variants_sampler",
                  "cartridge_version": "0.0.1",
                  "kind": "status",
                  "key": "bruised"
                }
              }
            },
            "description": "npc.maud.description_bruised"
          }
        ]
      ]
    },
    "AttackProfile": {
      "type": "object",
      "properties": {
        "chance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "damage_min": {
          "type": "integer",
          "minimum": 1
        },
        "damage_max": {
          "type": "integer",
          "minimum": 1
        },
        "on_positive_hit": {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "effect"
          ],
          "additionalProperties": false
        },
        "kind": {
          "$ref": "entity.schema.json#/$defs/DamageKind"
        },
        "crit": {
          "description": "Toolbox row G2 (kernel_api at least 1.44): a hit whose accuracy roll (the hit draw, uniform in [0, 100)) is below chance is critical and its damage is multiplied by multiplier, before resistances.",
          "type": "object",
          "properties": {
            "chance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "multiplier": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            }
          },
          "required": [
            "chance",
            "multiplier"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "chance",
        "damage_min",
        "damage_max"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "chance": 75,
          "damage_min": 1,
          "damage_max": 2
        }
      ],
      "description": "Cartridge-owned hit chance and positive damage bounds. Compiler and loader enforce damage_min <= damage_max."
    },
    "ShopOffer": {
      "examples": [
        {
          "item": {
            "cartridge_id": "ashmere_missing_child",
            "cartridge_version": "0.0.18",
            "kind": "item",
            "key": "torch"
          },
          "buy": 3,
          "sell": 1
        }
      ],
      "description": "One exact authored shop item definition with its positive buy and sell prices; custody determines availability (B3).",
      "type": "object",
      "properties": {
        "item": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "buy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "sell": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "item",
        "buy",
        "sell"
      ],
      "additionalProperties": false
    },
    "Shop": {
      "examples": [
        {
          "resource": {
            "cartridge_id": "ashmere_missing_child",
            "cartridge_version": "0.0.18",
            "kind": "resource",
            "key": "pennies"
          },
          "offers": [
            {
              "item": {
                "cartridge_id": "ashmere_missing_child",
                "cartridge_version": "0.0.18",
                "kind": "item",
                "key": "torch"
              },
              "buy": 3,
              "sell": 1
            }
          ],
          "bought": "shop.bought",
          "sold": "shop.sold"
        }
