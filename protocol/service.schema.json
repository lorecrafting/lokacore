{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immediate services",
  "description": "B8 typed finite paid entitlement, meal and provider-owned serving.",
  "$defs": {
    "ServiceDefinition": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "provider": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "action": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "label": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "narration": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "currency": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "price": {
          "type": "integer",
          "description": "Row kgd.70 (kernel_api at least 1.101): 0 only on an entitlement with escrow, a barter.",
          "minimum": 0,
          "maximum": 2147483647
        },
        "benefit": {
          "$ref": "service.schema.json#/$defs/ServiceBenefit"
        }
      },
      "required": [
        "key",
        "provider",
        "action",
        "label",
        "narration",
        "currency",
        "price",
        "benefit"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "room",
          "provider": {
            "cartridge_id": "service_probe",
            "cartridge_version": "1.0.0",
            "kind": "npc",
            "key": "innkeeper"
          },
          "action": "rent_room",
          "label": "service.room",
          "narration": "service.rented",
          "currency": {
            "cartridge_id": "service_probe",
            "cartridge_version": "1.0.0",
            "kind": "resource",
            "key": "pennies"
          },
          "price": 3,
          "benefit": {
            "kind": "entitlement",
            "fact": {
              "cartridge_id": "service_probe",
              "cartridge_version": "1.0.0",
              "kind": "fact",
              "key": "paid"
            }
          }
        }
      ],
      "description": "Exact original-provider action and conserved quote with one typed immediate benefit."
    },
    "ServiceBenefit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "entitlement"
            },
            "fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "escrow": {
              "type": "object",
              "description": "Toolbox row 20a: the first quantity of these directly held items move to the custody room with the order. Row 20b: ready_after with output (an item lying in custody) adds a work job a claim waits for; cancel returns the inputs, never the fee. Row kgd.70 (kernel_api at least 1.101): output with no ready_after is a barter, handed from custody to the body with the inputs, no job.",
              "properties": {
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "custody": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "ready_after": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31536000
                },
                "output": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "items",
                "quantity",
                "custody"
              ],
              "additionalProperties": false,
              "dependentRequired": {
                "ready_after": [
                  "output"
                ]
              }
            }
          },
          "required": [
            "kind",
            "fact"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "meal"
            },
            "stock": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "debit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "recovery": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "stock",
            "debit",
            "recovery",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "drink"
            },
            "vessel": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "liquid": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "recovery": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "vessel",
            "liquid",
            "recovery",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "repair"
            },
            "fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "fact",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "claim"
            },
            "service": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "kind",
            "service"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cancel"
            },
            "service": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "kind",
            "service"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "deposit"
            },
            "account": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "vault": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "kind",
            "account",
            "vault",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "withdraw"
            },
            "account": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "vault": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "kind",
            "account",
            "vault",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "description": "Built rooms S2 (construction@1): raise blueprint at site's direction. blueprint is one of site.blueprints and direction one of site.directions (SCHEMA_VIOLATION invalid_value otherwise). Refused service.site_taken while a built room holds that site direction and service.construction_full at world.construction.max_total. Built rooms S3: fact with escrow (ready_after, no output) makes it a commission: the order sets fact true, moves the inputs to custody and schedules an order job; when due the job raises the room for its owner and sets fact false (refunding the inputs when the site is taken or construction full by then). Cancel (a cancel benefit naming this service) returns the inputs, never the fee.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "build"
            },
            "blueprint": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "site": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "direction": {
              "enum": [
                "north",
                "south",
                "east",
                "west",
                "up",
                "down"
              ]
            },
            "fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "escrow": {
              "type": "object",
              "description": "Built rooms S3: the first quantity of these directly held items move to the custody room with the order; ready_after seconds later the order job raises the room.",
              "properties": {
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "custody": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "ready_after": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31536000
                }
              },
              "required": [
                "items",
                "quantity",
                "custody",
                "ready_after"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "blueprint",
            "site",
            "direction"
          ],
          "additionalProperties": false,
          "dependentRequired": {
            "fact": [
              "escrow"
            ],
            "escrow": [
              "fact"
            ]
          }
        },
        {
          "description": "Built rooms S4 (construction@1): mend the built room at site's direction. Refused service.nothing_to_mend unless that room's blueprint ruin status is active on it; otherwise the mend cures ruin and applies the blueprint's weathering again. site and direction as build's.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "mend"
            },
            "site": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "direction": {
              "enum": [
                "north",
                "south",
                "east",
                "west",
                "up",
                "down"
              ]
            },
            "escrow": {
              "type": "object",
              "description": "The first quantity of these directly held items move to the custody room with the mend (spent at once).",
              "properties": {
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "custody": {
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "items",
                "quantity",
                "custody"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "site",
            "direction"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Closed paid entitlement, finite meal recovery, provider-owned complete liquid serving (recovery is MV only) or, toolbox row 21, a repair adding up to amount to the wielded weapon's durability fact; or, toolbox row 20b, a claim or cancel of the named commission service's timed escrow order; or, toolbox row 25, a deposit or withdraw of amount between the player's pool and the vault NPC's, mirrored in the account fact, the price being the fee; or, Built rooms S2 to S4, a build or mend of a site's room.",
      "examples": [
        {
          "kind": "entitlement",
          "fact": {
            "cartridge_id": "service_probe",
            "cartridge_version": "1.0.0",
            "kind": "fact",
            "key": "paid"
          }
        }
      ]
    }
  }
}
