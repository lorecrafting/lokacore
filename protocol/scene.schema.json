{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene contracts",
  "$defs": {
    "SceneDefinition": {
      "oneOf": [
        {"description":"A scene that takes over the screen: some lines, a Continue button, then it ends.",
          "type": "object",
          "properties": {
            "key": {
              "description": "Scene key: lowercase snake_case of at most 58 characters, leaving room for the engine fact prefix scene_ within Key's 64-character limit.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 58,
              "examples": [
                "bell_rung",
                "k",
                "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
              ]
            },
            "on": {
              "description": "What starts the scene: a story point reached, a quest outcome, a scripted action's success, or `start` (an opening scene, started at world creation, without outcome); an action start names the scripted action's room and detail.",
              "type": "object",
              "properties": {
                "story_point": {"description":"Start when this story point is reached.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "quest": {"description":"Start when this quest is completed with the outcome below.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "action": {"description":"Start when this scripted action succeeds; give its room and detail too.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "room": {"description":"The room of the action that starts the scene.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "detail": {"description":"The detail of the action that starts the scene.",
                  "$ref": "action.schema.json#/$defs/Key"
                },
                "outcome": {"description":"The outcome that starts the scene; success for an action.",
                  "$ref": "action.schema.json#/$defs/Key"
                },
                "start": {
                  "const": true
                }
              },
              "exactlyOneRequired": [
                "story_point",
                "quest",
                "action",
                "start"
              ],
              "dependentRequired": {
                "story_point": [
                  "outcome"
                ],
                "quest": [
                  "outcome"
                ],
                "action": [
                  "outcome"
                ]
              },
              "additionalProperties": false
            },
            "control": {
              "const": "modal"
            },
            "steps": {"description":"The scene's steps: one or more narrate steps, then await_ack, then end.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SceneStep"
              }
            },
            "treatment": {
              "enum": [
                "reverie"
              ],
              "description": "Presentation only: the Book treatment that draws this scene (book-ui.md, Book treatments)."
            },
            "on_end": {"description":"What happens when the scene ends: facts are set, then a story point is reached.",
              "type": "object",
              "properties": {
                "assign": {"description":"The facts to set, 1 to 3.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "properties": {
                      "fact": {"description":"The fact to set.",
                        "$ref": "identity.schema.json#/$defs/DefinitionRef"
                      },
                      "value": {"description":"The value to give it.",
                        "$ref": "delta.schema.json#/$defs/FactValue"
                      }
                    },
                    "required": [
                      "fact",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "story_point": {"description":"The story point reached when the scene ends.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "outcome": {"description":"The outcome the story point is reached with.",
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "assign",
                "story_point",
                "outcome"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "key",
            "on",
            "control",
            "steps"
          ],
          "additionalProperties": false
        },
        {"description":"A dream when the player rests in a paid bed: three lines, a choice of two, the chosen option's text, then Continue.",
          "type": "object",
          "properties": {
            "key": {
              "description": "Scene key: lowercase snake_case of at most 58 characters, leaving room for the engine fact prefix scene_ within Key's 64-character limit.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 58,
              "examples": [
                "bell_rung",
                "k",
                "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
              ]
            },
            "on": {"description":"What starts the dream.",
              "type": "object",
              "properties": {
                "rest": {"description":"Start when the player rests in this paid bed.",
                  "$ref": "scene.schema.json#/$defs/RestBinding"
                }
              },
              "required": [
                "rest"
              ],
              "additionalProperties": false
            },
            "control": {
              "const": "presentation_only"
            },
            "steps": {"description":"Exactly these steps in order: narrate, narrate, narrate, choice, branch, await_ack, end.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SceneStep"
              }
            },
            "on_end": {"description":"What happens when the dream ends: one fact is set and its quest is completed.",
              "type": "object",
              "properties": {
                "assign": {"description":"The one fact to set.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "properties": {
                      "fact": {"description":"The fact to set.",
                        "$ref": "identity.schema.json#/$defs/DefinitionRef"
                      },
                      "value": {"description":"The value to give it.",
                        "$ref": "delta.schema.json#/$defs/FactValue"
                      }
                    },
                    "required": [
                      "fact",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "outcome": {"description":"The outcome the quest is completed with.",
                  "$ref": "action.schema.json#/$defs/Key"
                },
                "quest": {"description":"The quest to complete; the same quest as the bed's.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "assign",
                "quest",
                "outcome"
              ],
              "additionalProperties": false
            },
            "name": {"description":"The scene's name.",
              "$ref": "text.schema.json#/$defs/TextKey"
            },
            "description": {"description":"A short description of the scene.",
              "$ref": "text.schema.json#/$defs/TextKey"
            }
          },
          "required": [
            "key",
            "on",
            "control",
            "steps",
            "name",
            "description",
            "on_end"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Modal narration or the consumed paid-Rest anchored, resumable presentation-only dream.",
      "examples": [
        {
          "key": "bell_rung",
          "on": {
            "story_point": {
              "cartridge_id": "scene_sampler",
              "cartridge_version": "0.0.1",
              "kind": "story_point",
              "key": "lantern_resolved"
            },
            "outcome": "carry"
          },
          "control": "modal",
          "steps": [
            {
              "type": "narrate",
              "text": "scene.bell_rung.bell"
            },
            {
              "type": "await_ack"
            },
            {
              "type": "end"
            }
          ]
        }
      ]
    },
    "SceneStep": {
      "description": "The installed closed scene step subset; no arbitrary writes.",
      "oneOf": [
        {"description":"Shows a line of text.",
          "type": "object",
          "properties": {
            "type": {
              "const": "narrate"
            },
            "text": {"description":"The line to show.",
              "$ref": "text.schema.json#/$defs/TextKey"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {"description":"Waits for the player to press Continue.",
          "type": "object",
          "properties": {
            "type": {
              "const": "await_ack"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {"description":"Ends the scene.",
          "type": "object",
          "properties": {
            "type": {
              "const": "end"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {"description":"Asks the player to pick one of two options.",
          "type": "object",
          "properties": {
            "type": {
              "const": "choice"
            },
            "key": {"description":"A short id for this choice.",
              "$ref": "action.schema.json#/$defs/Key"
            },
            "prompt": {"description":"The question shown above the options.",
              "$ref": "text.schema.json#/$defs/TextKey"
            },
            "choices": {"description":"The two options.",
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "choice_id": {"description":"A short id for this option.",
                    "$ref": "action.schema.json#/$defs/Key"
                  },
                  "label": {"description":"The button text.",
                    "$ref": "text.schema.json#/$defs/TextKey"
                  },
                  "text": {"description":"What is shown after the player picks it.",
                    "$ref": "text.schema.json#/$defs/TextKey"
                  }
                },
                "required": [
                  "choice_id",
                  "label",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "key",
            "prompt",
            "choices"
          ],
          "additionalProperties": false
        },
        {"description":"Shows the text of the option the player picked.",
          "type": "object",
          "properties": {
            "type": {
              "const": "branch"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "type": "narrate",
          "text": "scene.bell_rung.bell"
        },
        {
          "type": "await_ack"
        },
        {
          "type": "end"
        },
        {
          "type": "choice",
          "key": "fork",
          "prompt": "dream.fork",
          "choices": [
            {
              "choice_id": "follow_fox",
              "label": "dream.follow",
              "text": "dream.follow.final"
            },
            {
              "choice_id": "wake",
              "label": "dream.wake",
              "text": "dream.wake.final"
            }
          ]
        },
        {
          "type": "branch"
        }
      ]
    },
    "RestBinding": {
      "type": "object",
      "properties": {
        "room": {"description":"The inn room with the bed.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "detail": {"description":"The bed: a detail of that room.",
          "$ref": "action.schema.json#/$defs/Key"
        },
        "entitlement": {"description":"The true-or-false fact that paying for the bed sets.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "credit": {"description":"The true-or-false fact that records the first rest.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "quest": {"description":"The dream's quest.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        }
      },
      "required": [
        "room",
        "detail",
        "entitlement",
        "credit",
        "quest"
      ],
      "additionalProperties": false,
      "description": "One exact paid Rest binding: authored bed, first-credit fact and sole quest.",
      "examples": [
        {
          "room": {
            "cartridge_id": "dream_probe",
            "cartridge_version": "1.0.0",
            "kind": "room",
            "key": "inn"
          },
          "detail": "bed",
          "entitlement": {
            "cartridge_id": "dream_probe",
            "cartridge_version": "1.0.0",
            "kind": "fact",
            "key": "paid"
          },
          "credit": {
            "cartridge_id": "dream_probe",
            "cartridge_version": "1.0.0",
            "kind": "fact",
            "key": "rested"
          },
          "quest": {
            "cartridge_id": "dream_probe",
            "cartridge_version": "1.0.0",
            "kind": "quest",
            "key": "room"
          }
        }
      ]
    },
    "DreamDraw": {
      "type": "object",
      "properties": {
        "scene": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "line": {
          "const": 4
        },
        "body_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "room_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "scene",
        "line",
        "body_id",
        "room_id",
        "expected_revision"
      ],
      "additionalProperties": false,
      "description": "Captured original scene-owned choice occurrence at its shown choice beat.",
      "examples": [
        {
          "scene": {
            "cartridge_id": "dream_probe",
            "cartridge_version": "1.0.0",
            "kind": "scene",
            "key": "dream"
          },
          "line": 4,
          "body_id": "11111111-2222-4333-8444-555555555555",
          "room_id": "22222222-2222-4333-8444-555555555555",
          "expected_revision": 3
        }
      ]
    }
  }
}
