{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ferry transport",
  "description": "Exact paired boarding endpoints, conserved fare and actor-owned corpse recovery.",
  "$defs": {
    "TransportDefinition": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "room": {"description":"The boarding room.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "detail": {"description":"The boarding detail.",
          "$ref": "action.schema.json#/$defs/Key"
        },
        "destination": {"description":"The destination.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "reverse": {"description":"The paired return transport: boards at this one's destination, goes back to its room, with the same recipient and currency.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "recipient": {"description":"The conserved fare recipient.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "currency": {"description":"The fare resource.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "fare": {"description":"The conserved fare.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "recovery_rooms": {"description":"The corpse recovery rooms.",
          "type": "array",
          "items": {
            "$ref": "identity.schema.json#/$defs/DefinitionRef"
          },
          "maxItems": 64
        },
        "action": {"description":"Key of the scripted action that boards this transport. It must be a use_transport action on inspectable details taking route and quoted_fare.",
          "$ref": "action.schema.json#/$defs/Key"
        },
        "name": {"description":"Text key for the boarding action and its offer label.",
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "narration": {"description":"Text key told when the player makes the passage.",
          "$ref": "text.schema.json#/$defs/TextKey"
        }
      },
      "required": [
        "key",
        "room",
        "detail",
        "destination",
        "reverse",
        "recipient",
        "currency",
        "fare",
        "recovery_rooms",
        "action",
        "name",
        "narration"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "outbound",
          "room": {
            "cartridge_id": "ferry_probe",
            "cartridge_version": "1.0.0",
            "kind": "room",
            "key": "shore"
          },
          "detail": "ferry",
          "destination": {
            "cartridge_id": "ferry_probe",
            "cartridge_version": "1.0.0",
            "kind": "room",
            "key": "isle"
          },
          "reverse": {
            "cartridge_id": "ferry_probe",
            "cartridge_version": "1.0.0",
            "kind": "transport",
            "key": "return"
          },
          "recipient": {
            "cartridge_id": "ferry_probe",
            "cartridge_version": "1.0.0",
            "kind": "npc",
            "key": "sedge"
          },
          "currency": {
            "cartridge_id": "ferry_probe",
            "cartridge_version": "1.0.0",
            "kind": "resource",
            "key": "pennies"
          },
          "fare": 2,
          "recovery_rooms": [],
          "action": "board_ferry",
          "name": "transport.board",
          "narration": "transport.crossed"
        }
      ],
      "description": "Paired original boarding detail, destination, conserved fare recipient and corpse recovery rooms."
    }
  }
}
