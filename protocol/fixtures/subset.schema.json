{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Test-only probe for subset keywords no protocol/ contract uses yet (integer, boolean, null, const outside oneOf, minimum, maximum, minLength), and one astral character that a pattern matches only in Unicode mode. Property names __proto__ and a/b~c check that generation keeps and quotes every key. Read by the validator tests and generated into kernel/ts/test/subset.gen.ts; not a contract.",
  "$defs": {
    "SubsetProbe": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1
        },
        "big": {
          "type": "integer"
        },
        "flag": {
          "type": "boolean"
        },
        "nothing": {
          "type": "null"
        },
        "fixed": {
          "type": "string",
          "const": "x"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "astral": {
          "type": "string",
          "pattern": "^[^a]$"
        },
        "__proto__": {
          "type": "string"
        },
        "a/b~c": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "n": -1,
          "big": -9007199254740991,
          "flag": false,
          "nothing": null,
          "fixed": "x",
          "tags": [
            "ab"
          ]
        },
        {
          "n": 1,
          "big": 9007199254740991
        },
        {},
        {
          "astral": "𝒶"
        },
        {
          "a/b~c": "x"
        }
      ]
    }
  }
}
