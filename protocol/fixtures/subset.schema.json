{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Test-only probe for subset keywords no protocol/ contract uses yet (integer, boolean, null, const outside oneOf, minimum, maximum, minLength, the map form with maxProperties), and one astral character that a pattern matches only in Unicode mode. Property names __proto__ and a/b~c check that generation keeps and quotes every key. RecursiveProbe refers to itself (a recursive $ref). Read by the validator tests and generated into kernel/ts/test/subset.gen.ts; not a contract.",
  "$defs": {
    "SubsetProbe": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1
        },
        "big": {
          "type": "integer"
        },
        "flag": {
          "type": "boolean"
        },
        "nothing": {
          "type": "null"
        },
        "fixed": {
          "type": "string",
          "const": "x"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "astral": {
          "type": "string",
          "pattern": "^[^a]$"
        },
        "__proto__": {
          "type": "string"
        },
        "a/b~c": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]{1,3}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "maxProperties": 2
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "n": -1,
          "big": -9007199254740991,
          "flag": false,
          "nothing": null,
          "fixed": "x",
          "tags": [
            "ab"
          ]
        },
        {
          "n": 1,
          "big": 9007199254740991
        },
        {},
        {
          "astral": "𝒶"
        },
        {
          "a/b~c": "x"
        },
        {
          "counts": {}
        },
        {
          "counts": {
            "a": 0,
            "bbb": 9007199254740991
          }
        }
      ]
    },
    "RecursiveProbe": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer"
        },
        "next": {
          "$ref": "#/$defs/RecursiveProbe"
        }
      },
      "required": [
        "n"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "n": 0
        },
        {
          "n": 0,
          "next": {
            "n": 1,
            "next": {
              "n": 2
            }
          }
        }
      ]
    }
  }
}
