{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error contracts",
  "description": "The one error registry and GameError (04 §7; frozen ABI codes: docs/spec/conformance/numeric-profile.md).",
  "$defs": {
    "ErrorCode": {
      "description": "A stable machine error code (04 §7). Exactly the codes in protocol/error_registry.json, which gives each one's category and description; unknown codes are invalid.",
      "enum": [
        "not_found",
        "not_present",
        "not_owned",
        "permission_denied",
        "invalid_target",
        "invalid_state",
        "stale_view",
        "stale_revision",
        "insufficient_resource",
        "exit_locked",
        "quest_requirement",
        "cooldown",
        "rate_limited",
        "unsupported_capability",
        "invalid_json",
        "invalid_canonical",
        "integer_overflow",
        "division_by_zero",
        "invalid_bound",
        "invalid_rng_budget",
        "invalid_rng_state",
        "rng_budget_exhausted",
        "invalid_id",
        "invalid_ordinal",
        "unknown_contract",
        "invalid_type",
        "missing_property",
        "unknown_property",
        "not_in_enum",
        "const_mismatch",
        "unknown_variant",
        "below_minimum",
        "above_maximum",
        "pattern_mismatch",
        "too_short",
        "too_long",
        "too_few_items",
        "too_many_items",
        "too_many_properties",
        "conflicting_write",
        "precondition_failed",
        "containment_cycle",
        "capacity_exceeded",
        "nonfuture_job",
        "budget_exceeded",
        "unowned_event",
        "evaluator_error"
      ],
      "examples": [
        "not_found",
        "invalid_json",
        "missing_property"
      ]
    },
    "GameError": {
      "description": "A typed error: a stable code, never English text to parse (04 §7). Per-code data fields are added, as optional properties, when a code first needs them (owner decision Q5, docs/decisions/owner-decisions-r3-2026-09-24.md).",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "code": "exit_locked"
        }
      ]
    },
    "ErrorRegistryEntry": {
      "description": "One entry of protocol/error_registry.json (04 §7): gameplay rejections, ABI or contract-validation failures (numeric-profile.md, protocol/), and evaluation faults that discard a whole proposal (04 §5.2).",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "category": {
          "enum": [
            "gameplay_rejection",
            "abi_validation",
            "evaluation_fault"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "category",
        "description"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "code": "not_found",
          "category": "gameplay_rejection",
          "description": "The referenced thing does not exist (04 §7)."
        }
      ]
    }
  }
}
