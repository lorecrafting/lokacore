{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy contracts",
  "description": "The core policy AST (06 §21; 21 §3.2, §4 Policy; 14 §R3A). Typed, pure and fail-closed: an unknown operator is invalid.",
  "$defs": {
    "QuestState": {
      "description": "Where a quest stands for the player: active, completed, failed and so on.",
      "enum": [
        "active",
        "objectives_complete",
        "resolved",
        "failed",
        "abandoned"
      ],
      "examples": [
        "active"
      ]
    },
    "Policy": {
      "description": "A condition: a test on the world, such as a fact's value or where the player is. Combine tests with all, any and not.",
      "oneOf": [
        {
          "description": "Every item holds; an empty list is the policy with no condition.",
          "type": "object",
          "properties": {
            "op": {
              "const": "all"
            },
            "items": {"description":"The policies that must all hold.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Policy"
              }
            }
          },
          "required": [
            "op",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "description": "At least one item holds.",
          "type": "object",
          "properties": {
            "op": {
              "const": "any"
            },
            "items": {"description":"The policies of which one must hold.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Policy"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "description": "The item does not hold.",
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "item": {"description":"The policy that must not hold.",
              "$ref": "#/$defs/Policy"
            }
          },
          "required": [
            "op",
            "item"
          ],
          "additionalProperties": false
        },
        {
          "description": "The resolved target is present to the actor.",
          "type": "object",
          "properties": {
            "op": {
              "const": "target_present"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "description": "The actor holds an item of this definition, directly or inside containers it holds, transitively.",
          "type": "object",
          "properties": {
            "op": {
              "const": "has_item"
            },
            "item": {"description":"The item definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "item"
          ],
          "additionalProperties": false
        },
        {
          "description": "The actor's instance of the quest is in this lifecycle state.",
          "type": "object",
          "properties": {
            "op": {
              "const": "quest_state"
            },
            "quest": {"description":"The quest.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "state": {"description":"The lifecycle state.",
              "$ref": "#/$defs/QuestState"
            }
          },
          "required": [
            "op",
            "quest",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "description": "The fact, in the actor's scope, equals this value. An entity or pair fact is read on exactly one subject: npc or item, the one placed in the world from that definition, or subject target, the action's target (false without one); a player or instance fact names none.",
          "type": "object",
          "properties": {
            "op": {
              "const": "fact_compare"
            },
            "fact": {"description":"The fact to read.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "subject": {"description":"`target` reads the action's target.",
              "enum": [
                "target"
              ]
            },
            "npc": {"description":"Reads the NPC placed in the world from this definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "item": {"description":"Reads the item placed in the world from this definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "with": {
              "description": "An npc_pair fact's second NPC, read at the pair (subject toward with).",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "equals": {"description":"The value to compare.",
              "$ref": "delta.schema.json#/$defs/FactValue"
            }
          },
          "required": [
            "op",
            "fact",
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "description": "Holds during a range of hours of the day: from (included) up to to (not included), wrapping past midnight. Example: from 20 to 6 is night. From and to must differ.",
          "type": "object",
          "properties": {
            "op": {
              "const": "time_window"
            },
            "from": {"description":"First hour, inclusive.",
              "type": "integer",
              "minimum": 0
            },
            "to": {"description":"End hour, exclusive; the window wraps at day end.",
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while the door is in this state: open, closed or locked.",
          "type": "object",
          "properties": {
            "op": {
              "const": "barrier_state"
            },
            "barrier": {"description":"The barrier.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "equals": {"description":"The state.",
              "$ref": "room.schema.json#/$defs/BarrierState"
            }
          },
          "required": [
            "op",
            "barrier",
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while the player's attribute is at least this value.",
          "type": "object",
          "properties": {
            "op": {
              "const": "stat_compare"
            },
            "attribute": {"description":"The attribute.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "at_least": {"description":"The least value that holds.",
              "$ref": "resource.schema.json#/$defs/ResourceInt"
            }
          },
          "required": [
            "op",
            "attribute",
            "at_least"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while the player's level is at least at_least.",
          "type": "object",
          "properties": {
            "op": {
              "const": "level_compare"
            },
            "at_least": {"description":"The least level that holds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "op",
            "at_least"
          ],
          "additionalProperties": false
        },
        {
          "description": "Holds when the actor's resource (for example hp) is at least at_least, or at least at_least_percent of its maximum; use exactly one of the two. With subject, it reads the event's subject in a reaction. False for an actor without a body.",
          "type": "object",
          "properties": {
            "op": {
              "const": "resource_compare"
            },
            "resource": {"description":"The pool.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "subject": {"description":"`subject` reads the pool on a reaction's event subject.",
              "enum": [
                "subject"
              ]
            },
            "at_least": {"description":"The least value that holds.",
              "$ref": "resource.schema.json#/$defs/ResourceInt"
            },
            "at_least_percent": {"description":"The least percent of the pool's maximum that holds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "op",
            "resource"
          ],
          "exactlyOneRequired": [
            "at_least",
            "at_least_percent"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "escort_state"
            },
            "quest": {"description":"The quest.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "state": {"description":"The escort status.",
              "$ref": "relation.schema.json#/$defs/EscortStatus"
            }
          },
          "required": [
            "op",
            "quest",
            "state"
          ],
          "additionalProperties": false,
          "description": "True while the player's escort for the named quest has this status."
        },
        {"description":"Holds while the player's room is dark.",
          "type": "object",
          "properties": {
            "op": {
              "const": "light_off"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "description": "True when something has this tag: the action's target (target), the player's room (room), or a named item, door or room.",
          "type": "object",
          "properties": {
            "op": {
              "const": "has_tag"
            },
            "tag": {"description":"The tag.",
              "$ref": "entity.schema.json#/$defs/Tag"
            },
            "subject": {"description":"`target` or `room`: what is read.",
              "enum": [
                "target",
                "room"
              ]
            },
            "item": {"description":"Reads this item definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "barrier": {"description":"Reads this barrier definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "room": {"description":"Reads this room definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "tag"
          ],
          "exactlyOneRequired": [
            "subject",
            "item",
            "barrier",
            "room"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while the sky is in this phase: a moon phase, season, tide or the day's weather.",
          "type": "object",
          "properties": {
            "op": {
              "const": "sky"
            },
            "lunar": {"description":"The lunar phase.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "weather": {"description":"The weather entry.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "season": {"description":"The season.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "tide": {"description":"The tide phase.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "op"
          ],
          "exactlyOneRequired": [
            "lunar",
            "weather",
            "season",
            "tide"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while the player wears an item with this tag. False without a body.",
          "type": "object",
          "properties": {
            "op": {
              "const": "wearing"
            },
            "tag": {"description":"The tag a worn item declares.",
              "$ref": "entity.schema.json#/$defs/Tag"
            }
          },
          "required": [
            "op",
            "tag"
          ],
          "additionalProperties": false
        },
        {
          "description": "True once the player has entered the room at least this many times. The starting room counts as entered once.",
          "type": "object",
          "properties": {
            "op": {
              "const": "visited_count"
            },
            "room": {"description":"The room.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "at_least": {"description":"The least entry count that holds.",
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "op",
            "room",
            "at_least"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while the player's level in the named skill is at least at_least: 1 when learned, plus one for each growth step reached through use; 0 if not learned.",
          "type": "object",
          "properties": {
            "op": {
              "const": "skill_compare"
            },
            "skill": {"description":"The skill.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "at_least": {"description":"The least level that holds.",
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "op",
            "skill",
            "at_least"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while the named population has at least at_least living members.",
          "type": "object",
          "properties": {
            "op": {
              "const": "population_count"
            },
            "plan": {"description":"The population plan.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "at_least": {"description":"The least living count that holds.",
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "op",
            "plan",
            "at_least"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while someone has this status: the action's target (target), the player (self), the event's subject in a reaction (subject), or the player's room (room).",
          "type": "object",
          "properties": {
            "op": {
              "const": "status_active"
            },
            "subject": {"description":"Whose status: `target`, `self`, `subject` or `room`.",
              "enum": [
                "target",
                "self",
                "subject",
                "room"
              ]
            },
            "status": {"description":"The status.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "subject",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while an item with this tag lies on the floor of the player's room, not carried and not in a container. In a reaction, the room is the acting character's.",
          "type": "object",
          "properties": {
            "op": {
              "const": "item_present"
            },
            "tag": {"description":"The tag of an item on the floor.",
              "$ref": "entity.schema.json#/$defs/Tag"
            }
          },
          "required": [
            "op",
            "tag"
          ],
          "additionalProperties": false
        },
        {
          "description": "Holds when this NPC is alive and in the actor's room.",
          "type": "object",
          "properties": {
            "op": {
              "const": "npc_present"
            },
            "npc": {"description":"The NPC.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "npc"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while this NPC, alive, can sense a cue of this sense: a cue whose source is within its range of the NPC's room, through exits the player can see. In a reaction to an action's outcome, only that outcome's cues count.",
          "type": "object",
          "properties": {
            "op": {
              "const": "cue_perceived"
            },
            "npc": {"description":"The perceiving NPC.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "sense": {"description":"The sense.",
              "enum": [
                "sound",
                "smell",
                "heat"
              ]
            }
          },
          "required": [
            "op",
            "npc",
            "sense"
          ],
          "additionalProperties": false
        },
        {
          "description": "True while a number fact is at least at_least, such as a relationship or a count.",
          "type": "object",
          "properties": {
            "op": { "const": "fact_at_least" },
            "fact": {"description":"The number fact to read.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
            "subject": {"description":"Set to target to read the fact on the action's target.", "enum": ["target"] },
            "npc": {"description":"Read the fact on this NPC.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
            "item": {"description":"Read the fact on this item.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
            "with": {"description":"For a fact held between two NPCs: the other NPC.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
            "at_least": {"description":"The smallest value that passes.", "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
          },
          "required": ["op", "fact", "at_least"],
          "additionalProperties": false
        },
        {
          "description": "True once at least at_least time has passed since the time stored in a number fact, read at its named NPC or item. A fact never set holds its default.",
          "type": "object",
          "properties": {
            "op": { "const": "time_since" },
            "fact": {"description":"The int fact holding a stamp.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
            "npc": {"description":"Reads the NPC placed in the world from this definition.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
            "item": {"description":"Reads the item placed in the world from this definition.", "$ref": "identity.schema.json#/$defs/DefinitionRef" },
            "at_least": {"description":"The least elapsed time that holds.", "type": "integer", "minimum": 0, "maximum": 2147483647 }
          },
          "required": ["op", "fact", "at_least"],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "op": "target_present"
        },
        {
          "op": "all",
          "items": [
            {
              "op": "has_item",
              "item": {
                "cartridge_id": "ferrymans_lantern",
                "cartridge_version": "0.1.0",
                "kind": "item",
                "key": "lantern"
              }
            },
            {
              "op": "any",
              "items": [
                {
                  "op": "quest_state",
                  "quest": {
                    "cartridge_id": "ferrymans_lantern",
                    "cartridge_version": "0.1.0",
                    "kind": "quest",
                    "key": "find_the_lantern"
                  },
                  "state": "active"
                }
              ]
            },
            {
              "op": "not",
              "item": {
                "op": "fact_compare",
                "fact": {
                  "cartridge_id": "ferrymans_lantern",
                  "cartridge_version": "0.1.0",
                  "kind": "fact",
                  "key": "search_plan"
                },
                "equals": "player_led"
              }
            }
          ]
        },
        {
          "op": "time_window",
          "from": 18,
          "to": 6
        },
        {
          "op": "time_window",
          "from": 0,
          "to": 23
        },
        {
          "op": "barrier_state",
          "barrier": {
            "cartridge_id": "gate_sampler",
            "cartridge_version": "0.0.1",
            "kind": "barrier",
            "key": "cell_door"
          },
          "equals": "open"
        },
        {
          "op": "stat_compare",
          "attribute": {
            "cartridge_id": "resource_sampler",
            "cartridge_version": "0.0.1",
            "kind": "attribute",
            "key": "str"
          },
          "at_least": 14
        },
        {
          "op": "not",
          "item": {
            "op": "resource_compare",
            "resource": {
              "cartridge_id": "resource_sampler",
              "cartridge_version": "0.0.1",
              "kind": "resource",
              "key": "mv"
            },
            "at_least": 2
          }
        },
        {
          "op": "escort_state",
          "quest": {
            "cartridge_id": "c",
            "cartridge_version": "1.0.0",
            "kind": "quest",
            "key": "rescue"
          },
          "state": "following"
        },
        {
          "op": "has_tag",
          "subject": "target",
          "tag": "burnable"
        }
      ]
    }
  }
}
