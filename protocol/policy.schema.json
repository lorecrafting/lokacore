{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy contracts",
  "description": "The core policy AST and its version (06 §21; 21 §3.2, §4 Policy; 14 §R3A). Typed, pure and fail-closed: an unknown operator is invalid.",
  "$defs": {
    "VersionedPolicy": {
      "description": "A policy tree with the AST version it was written against (14 §R3A 'core policy AST/versioning'). A new leaf operator is versioned by its owning capability, which the cartridge must lock (capability_registry.json policies); adding an operator to a capability version that is already installed takes that capability's next version. A changed meaning of an existing operator takes a new policy_version.",
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "integer",
          "const": 1
        },
        "root": {
          "$ref": "#/$defs/Policy"
        }
      },
      "required": [
        "policy_version",
        "root"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "policy_version": 1,
          "root": {
            "op": "target_present"
          }
        }
      ]
    },
    "QuestState": {
      "description": "Persisted QuestInstance lifecycle state (06 §1). Availability is derived, not a state.",
      "enum": [
        "active",
        "objectives_complete",
        "resolved",
        "failed",
        "abandoned"
      ],
      "examples": [
        "active"
      ]
    },
    "Policy": {
      "description": "A pure condition tree (06 §21). all/any/not compose; the leaves are the 06 §21 operators the R6P proof uses (pre-release-proof.md) and the rest are added with their first use, each versioned by its owning capability (VersionedPolicy). fact_compare compares FactValue. stat_compare and resource_compare (attributes@1, 06 §21 amendment 2026-10-03) hold when the actor's attribute value, or the current value of the resource on the actor's body, is at least at_least; below is not, a range is all.",
      "oneOf": [
        {
          "description": "Every item holds; an empty list is the policy with no condition.",
          "type": "object",
          "properties": {
            "op": {
              "const": "all"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Policy"
              }
            }
          },
          "required": [
            "op",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "description": "At least one item holds.",
          "type": "object",
          "properties": {
            "op": {
              "const": "any"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Policy"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "description": "The item does not hold.",
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "item": {
              "$ref": "#/$defs/Policy"
            }
          },
          "required": [
            "op",
            "item"
          ],
          "additionalProperties": false
        },
        {
          "description": "The resolved target is present to the actor.",
          "type": "object",
          "properties": {
            "op": {
              "const": "target_present"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "description": "The actor holds an item of this definition, directly or inside containers it holds, transitively.",
          "type": "object",
          "properties": {
            "op": {
              "const": "has_item"
            },
            "item": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "item"
          ],
          "additionalProperties": false
        },
        {
          "description": "The actor's instance of the quest is in this lifecycle state.",
          "type": "object",
          "properties": {
            "op": {
              "const": "quest_state"
            },
            "quest": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "state": {
              "$ref": "#/$defs/QuestState"
            }
          },
          "required": [
            "op",
            "quest",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "description": "The fact, in the actor's scope, equals this value.",
          "type": "object",
          "properties": {
            "op": {
              "const": "fact_compare"
            },
            "fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "equals": {
              "$ref": "delta.schema.json#/$defs/FactValue"
            }
          },
          "required": [
            "op",
            "fact",
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "description": "06 §21 time_window, a window of authored calendar hours: floor(time / calendar.units_per_hour) mod calendar.hours_per_day is in `from` inclusive to `to` exclusive, wrapping at day end. The compiler and loader reject endpoints outside the authored day and equal endpoints (EMPTY_TIME_WINDOW). Owned by schedule@1.",
          "type": "object",
          "properties": {
            "op": {
              "const": "time_window"
            },
            "from": {
              "type": "integer",
              "minimum": 0
            },
            "to": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "description": "The barrier's current state equals `equals` (room.schema.json BarrierState; closed means closed and unlocked). Owned by barrier@1.",
          "type": "object",
          "properties": {
            "op": {
              "const": "barrier_state"
            },
            "barrier": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "equals": {
              "$ref": "room.schema.json#/$defs/BarrierState"
            }
          },
          "required": [
            "op",
            "barrier",
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "description": "The actor's value of the attribute (cartridge.schema.json AttributeSpec: its start, while nothing writes attributes) is at least at_least. Owned by attributes@1.",
          "type": "object",
          "properties": {
            "op": {
              "const": "stat_compare"
            },
            "attribute": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "at_least": {
              "$ref": "resource.schema.json#/$defs/ResourceInt"
            }
          },
          "required": [
            "op",
            "attribute",
            "at_least"
          ],
          "additionalProperties": false
        },
        {
          "description": "The current value of the resource on the actor's body (regenerated to now, before the action's costs) is at least at_least; false for an actor without a body. Owned by attributes@1.",
          "type": "object",
          "properties": {
            "op": {
              "const": "resource_compare"
            },
            "resource": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "at_least": {
              "$ref": "resource.schema.json#/$defs/ResourceInt"
            }
          },
          "required": [
            "op",
            "resource",
            "at_least"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "escort_state"
            },
            "quest": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "state": {
              "$ref": "relation.schema.json#/$defs/EscortStatus"
            }
          },
          "required": [
            "op",
            "quest",
            "state"
          ],
          "additionalProperties": false,
          "description": "API1.11 escort@1: this actor’s typed escort for the named quest instance has this status."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "light_off"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "description": "The subject's definition declares the tag (entity.schema.json Tag). Exactly one subject: subject target, the action's target, holding when it is an item whose definition declares the tag (false without a target, for a detail or for an NPC); subject room, the actor's current room; or item, barrier or room, that definition of this cartridge, a constant (tags never change). Owned by tags@1 (toolbox row G1).",
          "type": "object",
          "properties": {
            "op": {
              "const": "has_tag"
            },
            "tag": {
              "$ref": "entity.schema.json#/$defs/Tag"
            },
            "subject": {
              "enum": [
                "target",
                "room"
              ]
            },
            "item": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "barrier": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "room": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "tag"
          ],
          "exactlyOneRequired": [
            "subject",
            "item",
            "barrier",
            "room"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "op": "target_present"
        },
        {
          "op": "all",
          "items": [
            {
              "op": "has_item",
              "item": {
                "cartridge_id": "ferrymans_lantern",
                "cartridge_version": "0.1.0",
                "kind": "item",
                "key": "lantern"
              }
            },
            {
              "op": "any",
              "items": [
                {
                  "op": "quest_state",
                  "quest": {
                    "cartridge_id": "ferrymans_lantern",
                    "cartridge_version": "0.1.0",
                    "kind": "quest",
                    "key": "find_the_lantern"
                  },
                  "state": "active"
                }
              ]
            },
            {
              "op": "not",
              "item": {
                "op": "fact_compare",
                "fact": {
                  "cartridge_id": "ferrymans_lantern",
                  "cartridge_version": "0.1.0",
                  "kind": "fact",
                  "key": "search_plan"
                },
                "equals": "player_led"
              }
            }
          ]
        },
        {
          "op": "time_window",
          "from": 18,
          "to": 6
        },
        {
          "op": "time_window",
          "from": 0,
          "to": 23
        },
        {
          "op": "barrier_state",
          "barrier": {
            "cartridge_id": "ashmere_gate",
            "cartridge_version": "0.0.1",
            "kind": "barrier",
            "key": "cell_door"
          },
          "equals": "open"
        },
        {
          "op": "stat_compare",
          "attribute": {
            "cartridge_id": "ashmere_road",
            "cartridge_version": "0.0.1",
            "kind": "attribute",
            "key": "str"
          },
          "at_least": 14
        },
        {
          "op": "not",
          "item": {
            "op": "resource_compare",
            "resource": {
              "cartridge_id": "ashmere_road",
              "cartridge_version": "0.0.1",
              "kind": "resource",
              "key": "mv"
            },
            "at_least": 2
          }
        },
        {
          "op": "escort_state",
          "quest": {
            "cartridge_id": "c",
            "cartridge_version": "1.0.0",
            "kind": "quest",
            "key": "rescue"
          },
          "state": "following"
        },
        {
          "op": "has_tag",
          "subject": "target",
          "tag": "burnable"
        }
      ]
    }
  }
}
