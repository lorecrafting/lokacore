          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/NarrationParticipant"
          }
        }
      },
      "required": [
        "actor"
      ],
      "additionalProperties": false,
      "description": "A scripted action outcome's narration: the actor's line, the observers' line, and the entities the actor's line names, each resolved and pinned when the outcome commits.",
