{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Action contracts",
  "description": "Action definitions, ActionInvocation, TargetSpec and TargetResolution (04 §1, §2, §18, §19; 06 §20; 21 §7).",
  "$defs": {
    "Key": {
      "description": "A name the game uses inside: lowercase letters, digits and underscores, at most 64 characters, such as north or old_well.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "examples": [
        "talk",
        "k",
        "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
      ]
    },
    "Word": {
      "description": "One spoken word: 1 to 32 ASCII letters, the riddle answer's bound. The rule case-folds it and compares it only with authored keywords; it never reaches narration.",
      "type": "string",
      "pattern": "^[a-zA-Z]{1,32}$",
      "examples": ["ward", "WARD"]
    },
    "ActionInput": {
      "description": "The validated input of an ActionInvocation (04 §1). Closed: each field is a registered input parameter, and the ActionDefinition's `input` lists which ones the action requires (06 §20). The parameters are those the R6P proof uses (pre-release-proof.md).",
      "type": "object",
      "properties": {
        "ancestry": { "$ref": "#/$defs/Key" },
        "attribute": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
        "direction": {
          "$ref": "#/$defs/Key"
        },
        "choice_id": {
          "$ref": "#/$defs/Key"
        },
        "continuation_id": {
          "$ref": "delta.schema.json#/$defs/ContinuationId"
        },
        "until": {
          "$ref": "command.schema.json#/$defs/LogicalTime"
        },
        "answer": {
          "type": "string",
          "pattern": "^[a-zA-Z]{1,32}$"
        },
        "word": { "$ref": "#/$defs/Word" },
        "topic": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
        "room": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
        "fact": { "$ref": "identity.schema.json#/$defs/DefinitionRef" },
        "value": { "$ref": "delta.schema.json#/$defs/FactValue" },
        "level": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "allocated": { "$ref": "command.schema.json#/$defs/DevAllocated" },
        "scene": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "quoted_price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "patrol": {
          "$ref": "relation.schema.json#/$defs/PatrolDraw"
        },
        "service": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "route": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "quoted_fare": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "dream": {
          "$ref": "scene.schema.json#/$defs/DreamDraw"
        },
        "method": {
          "enum": [
            "careful"
          ]
        },
        "effect_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "transition": {
          "enum": [
            "start",
            "restart",
            "shelter"
          ]
        },
        "quest_instance_id": {
          "$ref": "delta.schema.json#/$defs/QuestInstanceId"
        },
        "attempt_id": {
          "$ref": "identity.schema.json#/$defs/CommandId"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      },
      "required": [],
      "additionalProperties": false,
      "examples": [
        {},
        {
          "direction": "north"
        },
        {
          "choice_id": "carry",
          "continuation_id": "44444444-5555-8666-8777-888888888888"
        },
        {
          "until": 0
        },
        {
          "route": {
            "cartridge_id": "ferry_probe",
            "cartridge_version": "1.0.0",
            "kind": "transport",
            "key": "return"
          },
          "quoted_fare": 0
        }
      ]
    },
    "ActionInvocation": {
      "description": "A host-neutral gameplay intent from an advertised GameView action; not yet an authoritative Command (04 §1, §2). invocation_id is the stable retry identity (03 §14). target_ids is ordered and its order is semantic (03 §14, invocation-intent digest). view_freshness_token is opaque admission metadata, not intent (04 §16). The 8-target and 128-character caps are admission limits of this contract version (not spec numbers); changing them is a contract version change.",
      "type": "object",
      "properties": {
        "invocation_id": {
          "$ref": "identity.schema.json#/$defs/InvocationId"
        },
        "action_key": {
          "$ref": "#/$defs/Key"
        },
        "actor_id": {
          "$ref": "identity.schema.json#/$defs/CharacterId"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "$ref": "identity.schema.json#/$defs/EntityId"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "input": {
          "$ref": "#/$defs/ActionInput"
        },
        "view_freshness_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "invocation_id",
        "action_key",
        "actor_id",
        "target_ids",
        "input"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "invocation_id": "f6a7b8c9-d0e1-4f2a-8b3c-5d6e7f8a9b0c",
          "action_key": "move",
          "actor_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d",
          "target_ids": [],
          "input": {
            "direction": "north"
          }
        },
        {
          "invocation_id": "f6a7b8c9-d0e1-4f2a-8b3c-5d6e7f8a9b0c",
          "action_key": "talk",
          "actor_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d",
          "target_ids": [
            "11111111-2222-4333-8444-555555555555"
          ],
          "input": {},
          "view_freshness_token": "v"
        },
        {
          "invocation_id": "f6a7b8c9-d0e1-4f2a-8b3c-5d6e7f8a9b0c",
          "action_key": "give",
          "actor_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d",
          "target_ids": [
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "11111111-2222-4333-8444-555555555555",
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "11111111-2222-4333-8444-555555555555",
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "11111111-2222-4333-8444-555555555555",
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "11111111-2222-4333-8444-555555555555"
          ],
          "input": {},
          "view_freshness_token": "tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
        }
      ]
    },
    "TargetSpec": {
      "description": "The candidate scopes an action's target is resolved from (21 §7): the scopes the R6P proof resolves to an EntityId. Inspectable details use target-only EntityIds and the inspectable_details scope. equipped, connections, party and privileged global scope are added with their first use, with a target identity for non-entity targets (21 §6). Accepted kinds and capabilities are added with the capability registry.",
      "oneOf": [
        {
          "description": "The action takes no target.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "One entity from the listed scopes.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "entity"
            },
            "scopes": {"description":"Where the target is looked for: self, inventory, room_contents, room_occupants or inspectable_details.",
              "type": "array",
              "items": {
                "enum": [
                  "self",
                  "inventory",
                  "room_contents",
                  "room_occupants",
                  "inspectable_details"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "scopes"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "kind": "none"
        },
        {
          "kind": "entity",
          "scopes": [
            "room_occupants"
          ]
        },
        {
          "kind": "entity",
          "scopes": [
            "inspectable_details"
          ]
        }
      ]
    },
    "TargetResolution": {
      "description": "The deterministic result of resolving a target (14 §R3A; 21 §7: none | unique(target) | ambiguous(candidates), no random tie-breaking; 04 §18: ambiguous search returns structured candidates). candidate_ids are 2 to 1024 distinct EntityIds (1024 is the composition profile's selector_cardinality) in ascending code-point order of the id string (owner decision: docs/archive/decisions/owner-decisions-r3-open-questions-2026-09-24.md, item 1). The subset cannot express order or distinctness, so invariant target_candidates_ordered in protocol/invariants.json carries it.",
      "oneOf": [
        {
          "description": "No candidate matched.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "Exactly one candidate.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "unique"
            },
            "target_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            }
          },
          "required": [
            "kind",
            "target_id"
          ],
          "additionalProperties": false
        },
        {
          "description": "Two or more candidates.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "ambiguous"
            },
            "candidate_ids": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/EntityId"
              },
              "minItems": 2,
              "maxItems": 1024
            }
          },
          "required": [
            "kind",
            "candidate_ids"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "kind": "none"
        },
        {
          "kind": "unique",
          "target_id": "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a"
        },
        {
          "kind": "ambiguous",
          "candidate_ids": [
            "11111111-2222-4333-8444-555555555555",
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a"
          ]
        }
      ]
    },
    "ActionInputParameter": {
      "description": "An input parameter an action requires (06 §20), one of the ActionInput fields.",
      "enum": [
        "ancestry",
        "attribute",
        "word",
        "topic",
        "direction",
        "choice_id",
        "continuation_id",
        "until",
        "answer",
        "scene",
        "line",
        "quoted_price",
        "patrol",
        "service",
        "route",
        "quoted_fare",
        "dream",
        "method",
        "effect_generation",
        "transition",
        "quest_instance_id",
        "attempt_id",
        "cursor"
      ],
      "examples": [
        "until"
      ]
    },
    "ActionDefinition": {
      "description": "An advertised affordance (04 §19; 06 §20; 21 §7): stable key, name (its localization key), target spec, the portable Command type it resolves to (checked against the command registry when content compiles), presentation priority, required input parameters, policy and accessibility description. Aliases, costs and cooldown hints arrive with the text parser and cost capabilities.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Key"
        },
        "name": {"description":"Text key of its name.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "maxLength": 128
        },
        "target": {"description":"The target spec.",
          "$ref": "#/$defs/TargetSpec"
        },
        "command": {"description":"The portable Command type it resolves to.",
          "$ref": "#/$defs/Key"
        },
        "priority": {"description":"Presentation priority.",
          "type": "integer"
        },
        "input": {"description":"Required input parameters.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionInputParameter"
          }
        },
        "policy": {
          "$ref": "policy.schema.json#/$defs/Policy"
        },
        "accessibility": {"description":"Accessibility description.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "maxLength": 128
        }
      },
      "required": [
        "key",
        "name",
        "target",
        "command",
        "priority",
        "input",
        "accessibility"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "talk",
          "name": "actions.talk",
          "target": {
            "kind": "entity",
            "scopes": [
              "room_occupants"
            ]
          },
          "command": "talk",
          "priority": 100,
          "input": [],
          "policy": {
            "op": "target_present"
          },
          "accessibility": "actions.talk.a11y"
        },
        {
          "key": "move",
          "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "target": {
            "kind": "none"
          },
          "command": "move",
          "priority": -1,
          "input": [
            "direction"
          ],
          "policy": {
            "op": "all",
            "items": []
          },
          "accessibility": "mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm"
        }
      ]
    },
    "ActionContribution": {
      "description": "Changes the list of actions the player is offered here: union adds actions, override adds or replaces them, replace offers exactly these, subtract removes them, intersect keeps only these. Each key names a built-in verb or one of the game's actions.",
      "type": "object",
      "properties": {
        "op": {"description":"How the actions apply to the set so far: union, override, replace, subtract or intersect.",
          "enum": [
            "union",
            "override",
            "replace",
            "subtract",
            "intersect"
          ]
        },
        "actions": {"description":"The action keys it applies.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Key"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "op",
        "actions"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "op": "subtract",
          "actions": [
            "take",
            "drop"
          ]
        },
        {
          "op": "union",
          "actions": [
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k"
          ]
        }
      ]
    },
    "ScriptedTarget": {
      "description": "What the action works on: a detail in a room (offered while the player is there), a tool used on another item, or a spell's word.",
      "oneOf": [
        {"description":"The action acts on one detail of a room, offered only while the actor is in that room.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "detail"
            },
            "room": {"description":"The room that holds the detail.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "detail": {"description":"The detail's key in that room's details.",
              "$ref": "#/$defs/Key"
            }
          },
          "required": [
            "kind",
            "room",
            "detail"
          ],
          "additionalProperties": false
        },
        {"description":"The action uses a tool the actor holds on another item.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "use"
            },
            "tool": {"description":"What the tool must be: an item with a given tag, or a vessel holding a given liquid.",
              "$ref": "#/$defs/UseTool"
            }
          },
          "required": [
            "kind",
            "tool"
          ],
          "additionalProperties": false
        },
        {
          "description": "A spell, cast by typing its word. With aimed it is cast at someone or something nearby; learned names a true-or-false fact the player must have true to cast it.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "spell"
            },
            "word": {"description":"The word the player types to cast it.",
              "$ref": "dialogue.schema.json#/$defs/SpokenKeyword"
            },
            "learned": {"description":"A bool fact; the word works for a caster only while it reads true for them.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "aimed": {"description":"Makes it an aimed spell, cast at one target; without it the spell takes no target.",
              "type": "object",
              "properties": {
                "scopes": {"description":"Where the target is looked for: the caster's room occupants, room contents or inventory.",
                  "type": "array",
                  "items": {
                    "enum": ["room_occupants", "room_contents", "inventory"]
                  },
                  "minItems": 1
                }
              },
              "required": ["scopes"],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "word",
            "learned"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "kind": "detail",
          "room": {
            "cartridge_id": "recipe_sampler",
            "cartridge_version": "0.0.1",
            "kind": "room",
            "key": "belfry"
          },
          "detail": "bell"
        },
        {
          "kind": "use",
          "tool": {
            "tag": "liquid_holding",
            "liquid": {
              "cartridge_id": "use_sampler",
              "cartridge_version": "0.0.1",
              "kind": "liquid",
              "key": "water"
            }
          }
        }
      ]
    },
    "UseTool": {
      "description": "What a use scripted action's tool must be, at least one property: an item whose definition declares tag, and a vessel holding some of liquid (quantity above 0).",
      "type": "object",
      "properties": {
        "tag": {"description":"A tag the tool item definition declares.",
          "$ref": "entity.schema.json#/$defs/Tag"
        },
        "liquid": {"description":"A liquid the tool vessel holds some of.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        }
      },
      "requiredUnless": {
        "tag": [
          "liquid"
        ]
      },
      "additionalProperties": false,
      "examples": [
        {
          "tag": "metal"
        }
      ]
    },
    "ScriptedAction": {
      "description": "An action the player can take, such as ring the bell: the words that start it, what it acts on, when it is offered, what it costs, an optional check, and what happens on success or failure.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Key"
        },
        "name": {"description":"Text key of its name.",
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "aliases": {"description":"Words a player types as its verb.",
          "type": "array",
          "items": {
            "$ref": "room.schema.json#/$defs/Alias"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "target": {"description":"Its target.",
          "$ref": "#/$defs/ScriptedTarget"
        },
        "priority": {"description":"Presentation priority.",
          "type": "integer"
        },
        "policy": {"description":"A condition the player must meet; while it fails, the action is shown unavailable and refused.",
          "$ref": "policy.schema.json#/$defs/Policy"
        },
        "outcomes": {"description":"The outcomes a perform selects.",
          "type": "object",
          "properties": {
            "success": {"description":"Runs when the check passes, or when the action has no check.",
              "type": "object",
              "properties": {
                "steps": {"description":"What happens on success, in order.",
                  "type": "array",
                  "items": {
                    "$ref": "step.schema.json#/$defs/Step"
                  },
                  "minItems": 1,
                  "maxItems": 16
                },
                "narration": {"description":"The line the player reads on success.",
                  "$ref": "#/$defs/ActionNarration"
                },
                "cues": {
                  "description": "Transient cues of this outcome, from the actor's room: perceived only by a cue_perceived condition of a reaction this outcome's check_passed, check_failed or action_completed causes; never stored or shown.",
                  "$ref": "entity.schema.json#/$defs/Cues"
                }
              },
              "required": [
                "steps",
                "narration"
              ],
              "additionalProperties": false
            },
            "failure": {"description":"Runs when the check fails.",
              "type": "object",
              "properties": {
                "steps": {"description":"What happens on failure, in order.",
                  "type": "array",
                  "items": {
                    "$ref": "step.schema.json#/$defs/Step"
                  },
                  "minItems": 0,
                  "maxItems": 16
                },
                "narration": {"description":"The line the player reads on failure.",
                  "$ref": "#/$defs/ActionNarration"
                },
                "cues": {
                  "description": "Transient cues of this outcome, from the actor's room: perceived only by a cue_perceived condition of a reaction this outcome's check_passed, check_failed or action_completed causes; never stored or shown.",
                  "$ref": "entity.schema.json#/$defs/Cues"
                }
              },
              "required": [
                "steps",
                "narration"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success"
          ],
          "additionalProperties": false
        },
        "check": {"description":"A check selecting success or failure.", "$ref": "step.schema.json#/$defs/Check" },
        "duration": {"description":"Logical time every accepted perform advances.",
          "type": "integer",
          "minimum": 1
        },
        "costs": {"description":"What the action costs the player's body each time, such as 1 movement point; up to 8. If the player cannot pay, it is refused.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionCost"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "craft": {"description":"Makes the action a crafting recipe: the items it uses up, the item it makes, or both.",
          "$ref": "#/$defs/ActionCraft"
        },
        "cooldown": {"description":"The action is refused until this much logical time has passed since the actor's last admitted attempt.",
          "type": "integer",
          "minimum": 1
        },
