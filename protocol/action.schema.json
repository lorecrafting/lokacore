{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Action contracts",
  "description": "Action definitions, ActionInvocation, TargetSpec and TargetResolution (04 §1, §2, §18, §19; 06 §20; 21 §7).",
  "$defs": {
    "Key": {
      "description": "A stable semantic key: lowercase snake_case of at most 64 characters, the DefinitionRef segment rule (03 §2). Used for action keys, directions, choices, outcomes and key-valued facts.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "examples": [
        "talk",
        "k",
        "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
      ]
    },
    "ActionInput": {
      "description": "The validated input of an ActionInvocation (04 §1). Closed: each field is a registered input parameter, and the ActionDefinition's `input` lists which ones the action requires (06 §20). The parameters are those the R6P proof uses (pre-release-proof.md).",
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Key"
        },
        "choice_id": {
          "$ref": "#/$defs/Key"
        },
        "continuation_id": {
          "$ref": "delta.schema.json#/$defs/ContinuationId"
        },
        "until": {
          "$ref": "command.schema.json#/$defs/LogicalTime"
        }
      },
      "required": [],
      "additionalProperties": false,
      "examples": [
        {},
        {
          "direction": "north"
        },
        {
          "choice_id": "carry",
          "continuation_id": "44444444-5555-8666-8777-888888888888"
        },
        {
          "until": 0
        }
      ]
    },
    "ActionInvocation": {
      "description": "A host-neutral gameplay intent from an advertised GameView action; not yet an authoritative Command (04 §1, §2). invocation_id is the stable retry identity (03 §14). target_ids is ordered and its order is semantic (03 §14, invocation-intent digest). view_freshness_token is opaque admission metadata, not intent (04 §16). The 8-target and 128-character caps are admission limits of this contract version (not spec numbers); changing them is a contract version change.",
      "type": "object",
      "properties": {
        "invocation_id": {
          "$ref": "identity.schema.json#/$defs/InvocationId"
        },
        "action_key": {
          "$ref": "#/$defs/Key"
        },
        "actor_id": {
          "$ref": "identity.schema.json#/$defs/CharacterId"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "$ref": "identity.schema.json#/$defs/EntityId"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "input": {
          "$ref": "#/$defs/ActionInput"
        },
        "view_freshness_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "invocation_id",
        "action_key",
        "actor_id",
        "target_ids",
        "input"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "invocation_id": "f6a7b8c9-d0e1-4f2a-8b3c-5d6e7f8a9b0c",
          "action_key": "move",
          "actor_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d",
          "target_ids": [],
          "input": {
            "direction": "north"
          }
        },
        {
          "invocation_id": "f6a7b8c9-d0e1-4f2a-8b3c-5d6e7f8a9b0c",
          "action_key": "talk",
          "actor_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d",
          "target_ids": [
            "11111111-2222-4333-8444-555555555555"
          ],
          "input": {},
          "view_freshness_token": "v"
        },
        {
          "invocation_id": "f6a7b8c9-d0e1-4f2a-8b3c-5d6e7f8a9b0c",
          "action_key": "give",
          "actor_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d",
          "target_ids": [
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "11111111-2222-4333-8444-555555555555",
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "11111111-2222-4333-8444-555555555555",
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "11111111-2222-4333-8444-555555555555",
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "11111111-2222-4333-8444-555555555555"
          ],
          "input": {},
          "view_freshness_token": "tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
        }
      ]
    },
    "TargetSpec": {
      "description": "The candidate scopes an action's target is resolved from (21 §7): the scopes the R6P proof resolves to an EntityId. equipped, connections, inspectable_details, party and privileged global scope are added with their first use, with a target identity for non-entity targets (21 §6). Accepted kinds and capabilities are added with the capability registry.",
      "oneOf": [
        {
          "description": "The action takes no target.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "One entity from the listed scopes.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "entity"
            },
            "scopes": {
              "type": "array",
              "items": {
                "enum": [
                  "self",
                  "inventory",
                  "room_contents",
                  "room_occupants"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "scopes"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "kind": "none"
        },
        {
          "kind": "entity",
          "scopes": [
            "room_occupants"
          ]
        }
      ]
    },
    "TargetResolution": {
      "description": "The deterministic result of resolving a target (14 §R3A; 21 §7: none | unique(target) | ambiguous(candidates), no random tie-breaking; 04 §18: ambiguous search returns structured candidates). candidate_ids are 2 to 1024 distinct EntityIds (1024 is the composition profile's selector_cardinality) in ascending code-point order of the id string (owner decision: docs/decisions/owner-decisions-r3-open-questions-2026-09-24.md, item 1). The subset cannot express order or distinctness, so invariant target_candidates_ordered in protocol/invariants.json carries it.",
      "oneOf": [
        {
          "description": "No candidate matched.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "Exactly one candidate.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "unique"
            },
            "target_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            }
          },
          "required": [
            "kind",
            "target_id"
          ],
          "additionalProperties": false
        },
        {
          "description": "Two or more candidates.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "ambiguous"
            },
            "candidate_ids": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/EntityId"
              },
              "minItems": 2,
              "maxItems": 1024
            }
          },
          "required": [
            "kind",
            "candidate_ids"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "kind": "none"
        },
        {
          "kind": "unique",
          "target_id": "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a"
        },
        {
          "kind": "ambiguous",
          "candidate_ids": [
            "11111111-2222-4333-8444-555555555555",
            "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a"
          ]
        }
      ]
    },
    "ActionInputParameter": {
      "description": "An input parameter an action requires (06 §20), one of the ActionInput fields.",
      "enum": [
        "direction",
        "choice_id",
        "continuation_id",
        "until"
      ],
      "examples": [
        "until"
      ]
    },
    "ActionDefinition": {
      "description": "An advertised affordance (04 §19; 06 §20; 21 §7): stable key, localization label, target spec, the portable Command type it resolves to (checked against the command registry when content compiles), presentation priority, required input parameters, policy and accessibility description. Aliases, costs and cooldown hints arrive with the text parser and cost capabilities.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Key"
        },
        "label": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "maxLength": 128
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        },
        "command": {
          "$ref": "#/$defs/Key"
        },
        "priority": {
          "type": "integer"
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionInputParameter"
          }
        },
        "policy": {
          "$ref": "policy.schema.json#/$defs/VersionedPolicy"
        },
        "accessibility": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "maxLength": 128
        }
      },
      "required": [
        "key",
        "label",
        "target",
        "command",
        "priority",
        "input",
        "policy",
        "accessibility"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "talk",
          "label": "actions.talk",
          "target": {
            "kind": "entity",
            "scopes": [
              "room_occupants"
            ]
          },
          "command": "talk",
          "priority": 100,
          "input": [],
          "policy": {
            "policy_version": 1,
            "root": {
              "op": "target_present"
            }
          },
          "accessibility": "actions.talk.a11y"
        },
        {
          "key": "move",
          "label": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "target": {
            "kind": "none"
          },
          "command": "move",
          "priority": -1,
          "input": [
            "direction"
          ],
          "policy": {
            "policy_version": 1,
            "root": {
              "op": "all",
              "items": []
            }
          },
          "accessibility": "mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm"
        }
      ]
    },
    "ActionContribution": {
      "description": "One source's contribution to an actor's ActionSet (06 §19; ADR-016), applied to the set composed so far by stable action key: union adds the named actions whose keys the set lacks, override adds them and replaces those it has, replace makes the set exactly them, subtract removes them and intersect keeps only them. A key names an engine verb (a registered command type), a cartridge action or a cartridge recipe; union, override and replace take its definition (a cartridge's own over the engine verb's). A room applies its contributions in order after the engine verbs and the cartridge's actions and recipes (kernel/ts/src/actions.ts).",
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "union",
            "override",
            "replace",
            "subtract",
            "intersect"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Key"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "op",
        "actions"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "op": "subtract",
          "actions": [
            "take",
            "drop"
          ]
        },
        {
          "op": "union",
          "actions": [
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k",
            "k"
          ]
        }
      ]
    },
    "RecipeTarget": {
      "description": "What an ActionRecipe acts on (06 §20 target; 21 §7 TargetSpec): here, one inspectable detail, by its room and its key in that room's details. The recipe is offered only while the actor is in that room; other target kinds (items, entities by property) join as further variants.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "detail"
        },
        "room": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "detail": {
          "$ref": "#/$defs/Key"
        }
      },
      "required": [
        "kind",
        "room",
        "detail"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "kind": "detail",
          "room": {
            "cartridge_id": "ashmere_bell",
            "cartridge_version": "0.0.1",
            "kind": "room",
            "key": "belfry"
          },
          "detail": "bell"
        }
      ]
    },
    "RecipeStep": {
      "description": "One registered operation of a recipe outcome's explicit sequence (04 §5.2 step 4, §5.3; 05 §28: never a generic setter or an untyped effect). fact.assign sets a declared fact of the cartridge, at the one scope the fact allows, to a value of its type (the host emits fact_changed at this step's causal position when the value changes, fact@1). event.emit emits the cartridge's custom event of this key (EventPayload custom_event, action_recipe@1), whose subject is the recipe's target.",
      "oneOf": [
        {
          "description": "Assign a fact.",
          "type": "object",
          "properties": {
            "op": {
              "const": "fact.assign"
            },
            "fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "value": {
              "$ref": "delta.schema.json#/$defs/FactValue"
            }
          },
          "required": [
            "op",
            "fact",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "description": "Emit a custom event.",
          "type": "object",
          "properties": {
            "op": {
              "const": "event.emit"
            },
            "event": {
              "$ref": "#/$defs/Key"
            }
          },
          "required": [
            "op",
            "event"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "op": "fact.assign",
          "fact": {
            "cartridge_id": "ashmere_bell",
            "cartridge_version": "0.0.1",
            "kind": "fact",
            "key": "chapel_bell_rung"
          },
          "value": true
        },
        {
          "op": "event.emit",
          "event": "bell_rung"
        }
      ]
    },
    "ActionRecipe": {
      "description": "A cartridge-local action composed only of registered operations (06 §20 Composed actions / ActionRecipe; 21 §7; 05 §28), invoked by the perform command: its stable key (its ActionSet identity), label, the aliases a player types as its verb (the first words of the command), its target, presentation priority, availability policy (evaluated for the actor; while it fails the action is shown unavailable and perform is rejected), and its outcomes. success is one explicit sequence of at most 16 steps, run in order as one logical decision (04 §5.2) and followed by the engine's action_completed event, and the narration its actor reads; observers is the line others in the room would read, kept for the first host with a second viewer. Costs, a Check, failure and result bands, cooldowns and duration join as optional fields (R5 S6 and later).",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Key"
        },
        "label": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "room.schema.json#/$defs/Alias"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "target": {
          "$ref": "#/$defs/RecipeTarget"
        },
        "priority": {
          "type": "integer"
        },
        "policy": {
          "$ref": "policy.schema.json#/$defs/VersionedPolicy"
        },
        "outcomes": {
          "type": "object",
          "properties": {
            "success": {
              "type": "object",
              "properties": {
                "sequence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/RecipeStep"
                  },
                  "minItems": 1,
                  "maxItems": 16
                },
                "narration": {
                  "type": "object",
                  "properties": {
                    "actor": {
                      "$ref": "text.schema.json#/$defs/TextKey"
                    },
                    "observers": {
                      "$ref": "text.schema.json#/$defs/TextKey"
                    }
                  },
                  "required": [
                    "actor"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "sequence",
                "narration"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "success"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "key",
        "label",
        "aliases",
        "target",
        "priority",
        "policy",
        "outcomes"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "ring_bell",
          "label": "actions.ring_bell",
          "aliases": [
            "ring",
            "pull"
          ],
          "target": {
            "kind": "detail",
            "room": {
              "cartridge_id": "ashmere_bell",
              "cartridge_version": "0.0.1",
              "kind": "room",
              "key": "belfry"
            },
            "detail": "bell"
          },
          "priority": 10,
          "policy": {
            "policy_version": 1,
            "root": {
              "op": "not",
              "item": {
                "op": "fact_compare",
                "fact": {
                  "cartridge_id": "ashmere_bell",
                  "cartridge_version": "0.0.1",
                  "kind": "fact",
                  "key": "chapel_bell_rung"
                },
                "equals": true
              }
            }
          },
          "outcomes": {
            "success": {
              "sequence": [
                {
                  "op": "fact.assign",
                  "fact": {
                    "cartridge_id": "ashmere_bell",
                    "cartridge_version": "0.0.1",
                    "kind": "fact",
                    "key": "chapel_bell_rung"
                  },
                  "value": true
                },
                {
                  "op": "event.emit",
                  "event": "bell_rung"
                }
              ],
              "narration": {
                "actor": "narration.ring_bell.actor",
                "observers": "narration.ring_bell.observers"
              }
            }
          }
        },
        {
          "key": "k",
          "label": "l",
          "aliases": [
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a",
            "a"
          ],
          "target": {
            "kind": "detail",
            "room": {
              "cartridge_id": "ashmere_bell",
              "cartridge_version": "0.0.1",
              "kind": "room",
              "key": "r"
            },
            "detail": "d"
          },
          "priority": -1,
          "policy": {
            "policy_version": 1,
            "root": {
              "op": "all",
