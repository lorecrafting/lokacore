    "ActionNarration": {
      "type": "object",
      "properties": {
        "actor": {"description":"Text key of the actor's line.",
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "observers": {"description":"Text key of the observers' line.",
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "participants": {"description":"The entities the actor's line names.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/NarrationParticipant"
          }
        }
      },
      "required": [
        "actor"
      ],
      "additionalProperties": false,
      "description": "A scripted action outcome's narration (21 §4 NarrationSpec): the actor's line, the observers' line, and the entities the actor's line names, each resolved and pinned when the outcome commits (06 §43; text.schema.json Text participants).",
      "examples": [
        {
          "actor": "narration.coil_rope.actor"
        },
        {
          "actor": "narration.coil_rope.actor",
          "observers": "narration.coil_rope.observers",
          "participants": {
            "actor": {
              "role": "actor"
            },
            "bram": {
              "role": "npc",
              "npc": {
                "cartridge_id": "ferry_sampler",
                "cartridge_version": "0.0.1",
                "kind": "npc",
                "key": "bram"
              }
            },
            "rope": {
              "role": "item",
              "item": {
                "cartridge_id": "ferry_sampler",
                "cartridge_version": "0.0.1",
                "kind": "item",
                "key": "rope"
              }
            }
          }
        }
      ]
    },
    "NarrationParticipant": {
      "description": "An entity a scripted action's narration names, by the field its role selects (like entity.schema.json ItemLocation): an NPC or item of this cartridge, or the command's actor (its body). The compiler reports an npc or item that names no definition of that kind in this cartridge as UNRESOLVED_REFERENCE.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "npc"
            },
            "npc": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "role",
            "npc"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "item"
            },
            "item": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "role",
            "item"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "actor"
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "role": "actor"
        },
        {
          "role": "npc",
          "npc": {
            "cartridge_id": "ferry_sampler",
            "cartridge_version": "0.0.1",
            "kind": "npc",
            "key": "bram"
          }
        }
      ]
    },
    "ActionCraft": {
      "description": "What a craft scripted action uses up and makes (docs/system/mechanics.md Craft; Homestead hs-10): consume, yield or both. consume: on every accepted perform, failure included, the first quantity of the listed items the actor's body holds directly (lowest EntityId first; one inside a worn or carried container does not count) move to the holder to; while the body holds fewer the perform is rejected invalid_state and the offer is unavailable, its reason's message reason when declared. yield: unless the outcome is failure, one of the listed items directly in the holder from (lowest EntityId first) moves to the body, with item_acquired after the check's events; while from holds none the perform is rejected invalid_state and the offer is unavailable with no message. Every moved item passes the body's carrying limits (give rules). The compiler (lib/loka/content/replenish.ex) refuses a template location, a holder with no placed entity (a spawn-template NPC or template item), an item holder that is not a container, duplicate items, and an unresolved item, holder or reason.",
      "type": "object",
      "properties": {
        "consume": {
          "type": "object",
          "properties": {
            "items": {"description":"The items that can be consumed.",
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 1,
              "maxItems": 16
            },
            "quantity": {"description":"How many of them are consumed.",
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "to": {
              "$ref": "entity.schema.json#/$defs/ItemLocation"
            },
            "reason": {"description":"The refusal text shown when the actor holds too few.",
              "$ref": "text.schema.json#/$defs/TextKey"
            }
          },
          "required": ["items", "quantity", "to"],
          "additionalProperties": false
        },
        "yield": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "from": {
              "$ref": "entity.schema.json#/$defs/ItemLocation"
            }
          },
          "required": ["items", "from"],
          "additionalProperties": false
        }
      },
      "requiredUnless": {
        "consume": ["yield"]
      },
      "additionalProperties": false,
      "examples": [
        {
          "consume": {
            "items": [
              {
                "cartridge_id": "craft_sampler",
                "cartridge_version": "1.0.0",
                "kind": "item",
                "key": "stick_01"
              }
            ],
            "quantity": 1,
            "to": {
              "in": "item",
              "item": {
                "cartridge_id": "craft_sampler",
                "cartridge_version": "1.0.0",
                "kind": "item",
                "key": "scrap"
              }
            },
            "reason": "craft.carve_spoon.needs"
          },
          "yield": {
            "items": [
              {
                "cartridge_id": "craft_sampler",
                "cartridge_version": "1.0.0",
                "kind": "item",
                "key": "spoon_01"
              }
            ],
            "from": {
              "in": "item",
              "item": {
                "cartridge_id": "craft_sampler",
                "cartridge_version": "1.0.0",
                "kind": "item",
                "key": "store"
              }
            }
          }
        }
      ]
    },
    "ActionCost": {
      "description": "One resource cost of a ScriptedAction (21 §7 Cost): the actor's body pays amount of a resource of the cartridge on every admitted perform, failure included (04 §5.0). A perform whose body cannot pay (current value minus amount below the resource's minimum) is rejected insufficient_resource before any RNG draw, and changes nothing.",
      "type": "object",
      "properties": {
        "resource": {"description":"The resource the body pays.",
