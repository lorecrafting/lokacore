    "ActionCraft": {
      "description": "What a crafting action uses up and makes. consume: the items taken from the player's hands into a holder on every try; yield: an item moved from a holder to the player unless the action fails.",
      "type": "object",
      "properties": {
        "consume": {"description":"What the actor gives up on every accepted perform, failure included.",
          "type": "object",
          "properties": {
            "items": {"description":"The items that can be consumed.",
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 1,
              "maxItems": 16
            },
            "quantity": {"description":"How many of them are consumed.",
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "to": {"description":"Where the consumed items go: the holder they are moved to.",
              "$ref": "entity.schema.json#/$defs/ItemLocation"
            },
            "reason": {"description":"The refusal text shown when the actor holds too few.",
              "$ref": "text.schema.json#/$defs/TextKey"
            }
          },
          "required": ["items", "quantity", "to"],
          "additionalProperties": false
        },
        "yield": {"description":"What the actor receives unless the outcome is failure.",
          "type": "object",
          "properties": {
            "items": {"description":"The items that can be yielded; one of them, directly in the holder, moves to the actor's body.",
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "from": {"description":"The holder the yielded item is taken from.",
              "$ref": "entity.schema.json#/$defs/ItemLocation"
            }
          },
          "required": ["items", "from"],
          "additionalProperties": false
        }
      },
      "requiredUnless": {
        "consume": ["yield"]
      },
      "additionalProperties": false,
      "examples": [
        {
          "consume": {
            "items": [
