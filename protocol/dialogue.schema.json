{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dialogue contracts",
  "description": "DialogueDefinition (06 §17, §18, §33, §37, §43; 04 §5.3 Choice/continuation resolution; 21 §20), owned by dialogue@1.",
  "$defs": {
    "SpokenKeyword": {
      "description": "An authored spoken keyword: 1 to 32 lowercase ASCII letters, compared with a case-folded say, whisper or shout word.",
      "type": "string",
      "pattern": "^[a-z]{1,32}$",
      "examples": ["ward"]
    },
    "DialogueDefinition": {
      "description": "A conversation with an NPC: who speaks (npc), when it is offered (policy), the question shown (prompt) and the choices the player can pick. Talking to an NPC opens its first dialogue, by key, whose condition holds. It can name a quest the choices resolve, and a riddle.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "npc": {"description":"The speaker, also an npc role.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "policy": {"description":"When this conversation is offered: a condition the player must meet.",
          "$ref": "policy.schema.json#/$defs/Policy"
        },
        "prompt": {"description":"Text key of the pending choice's prompt.",
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "roles": {"description":"Participants bound when the talk opens.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/DialogueRole"
          }
        },
        "quest": {"description":"The quest a choice resolves, with the choice id as its outcome.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "choices": {"description":"The options the player can pick, each with a short id, a button label and what happens.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/DialogueChoice"
          }
        },
        "riddle": {"description":"A riddle answered by a typed word.",
          "type": "object",
          "properties": {
            "choice_id": {"description":"The choice that takes a typed answer.",
              "$ref": "action.schema.json#/$defs/Key"
            },
            "answer": {"description":"The answer that solves the riddle, compared lowercased.",
              "type": "string",
              "pattern": "^[a-z]{1,32}$"
            },
            "bank": {"description":"The letters an answer may use, each once per entry; an answer that does not fit is refused.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]$"
              },
              "minItems": 1,
              "maxItems": 32
            },
            "wrong": {"description":"Line told after a wrong answer.",
              "$ref": "text.schema.json#/$defs/TextKey"
            },
            "wrong_limit": {"description":"Wrong answers allowed; the last one closes the choice for good. Leave out for unlimited tries. Needs the dialogue's quest.",
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "choice_id",
            "answer",
            "bank",
            "wrong"
          ],
          "additionalProperties": false
        },
        "entry": {
          "description": "Optional. true: talking to this speaker opens this dialogue instead of the one it would pick (at most one per speaker, not on a keyword dialogue). false: talking never opens it; only another dialogue's then does.",
          "type": "boolean"
        },
        "keyword": {
          "description": "A word that, said or whispered to the speaker, opens this dialogue. Talking never opens it.",
          "$ref": "#/$defs/SpokenKeyword"
        },
        "name": {
          "description": "A distinct name (the Talk label) opts that authored control into exact dialogue selection; omission retains first-eligible Talk.",
          "$ref": "text.schema.json#/$defs/TextKey"
        }
      },
      "required": [
        "key",
        "npc",
        "prompt",
        "roles",
        "choices"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "bram",
          "npc": {
            "cartridge_id": "ferry_sampler",
            "cartridge_version": "0.0.1",
            "kind": "npc",
            "key": "bram"
          },
          "policy": {
            "op": "all",
            "items": []
          },
          "prompt": "dialogue.bram.prompt",
          "roles": {
            "bram": {
              "role": "npc",
              "npc": {
                "cartridge_id": "ferry_sampler",
                "cartridge_version": "0.0.1",
                "kind": "npc",
                "key": "bram"
              }
            },
            "lantern": {
              "role": "item",
              "item": {
                "cartridge_id": "ferry_sampler",
                "cartridge_version": "0.0.1",
                "kind": "item",
                "key": "lantern"
              }
            }
          },
          "choices": {
            "leave": {
              "label": "dialogue.bram.leave",
              "narration": "dialogue.bram.leave.narration",
              "hand_over": {
                "item": "lantern",
                "to": "bram"
              }
            }
          }
        }
      ]
    },
    "DialogueRole": {
      "description": "Who plays this role in the conversation: an NPC or item of this game.",
      "oneOf": [
        {"description":"An NPC of this cartridge takes this role.",
          "type": "object",
          "properties": {
            "role": {
              "const": "npc"
            },
            "npc": {"description":"The NPC definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "role",
            "npc"
          ],
          "additionalProperties": false
        },
        {"description":"An item of this cartridge takes this role.",
          "type": "object",
          "properties": {
            "role": {
              "const": "item"
            },
            "item": {"description":"The item definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "role",
            "item"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "role": "item",
          "item": {
            "cartridge_id": "ferry_sampler",
            "cartridge_version": "0.0.1",
            "kind": "item",
            "key": "lantern"
          }
        }
      ]
    },
    "DialogueChoice": {
      "description": "One option the player can pick in a conversation: its button text, the line it tells, and what it does (steps, a quest to accept, an item to hand over). It can also have a condition that hides it, a check with what opens next on success (then) or failure (then_failed), or then: end to close the conversation.",
      "type": "object",
      "properties": {
        "label": {"description":"Text key of the option.",
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "narration": {"description":"Text key of what the actor reads on choosing.",
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "steps": {"description":"What happens when the player picks this option, in order.",
          "type": "array",
          "items": { "$ref": "step.schema.json#/$defs/Step" }
        },
        "accept": {"description":"A quest of this cartridge the choice activates.",
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "hand_over": {"description":"The item role the actor gives to an npc role.",
          "type": "object",
          "properties": {
            "item": {"description":"The item role given.",
              "$ref": "action.schema.json#/$defs/Key"
            },
            "to": {"description":"The npc role receiving it.",
              "$ref": "action.schema.json#/$defs/Key"
            }
          },
          "required": [
            "item",
            "to"
          ],
          "additionalProperties": false
        },
        "receive": {"description":"The bound NPC-held item transferred to the actor.",
          "type": "object",
          "properties": {
            "item": {"description":"The bound item transferred.",
              "$ref": "action.schema.json#/$defs/Key"
            },
            "from": {"description":"The npc role holding it.",
              "$ref": "action.schema.json#/$defs/Key"
            }
          },
          "required": [
            "item",
            "from"
          ],
          "additionalProperties": false
        },
        "availability": {"description":"Time limits on offering the choice.",
          "type": "object",
          "properties": {
            "from": {"description":"First logical time the choice is offered.",
              "$ref": "command.schema.json#/$defs/LogicalTime"
            },
            "through": {"description":"Last logical time the choice is offered, inclusive.",
              "$ref": "command.schema.json#/$defs/LogicalTime"
            }
          },
          "additionalProperties": false
        },
        "payment": {"description":"An amount of a resource paid to the actor by an NPC role.",
          "type": "object",
          "properties": {
            "from": {"description":"The paying npc role.",
              "$ref": "action.schema.json#/$defs/Key"
            },
            "resource": {"description":"The resource paid.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {"description":"How much.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "from",
            "resource",
            "amount"
          ],
          "additionalProperties": false
        },
        "escort": {
          "type": "object",
          "properties": {
            "npc": {"description":"A bound NPC role.",
              "$ref": "action.schema.json#/$defs/Key"
            },
            "quest": {"description":"The escort quest.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "transition": {"description":"The transition made.",
              "enum": [
                "start",
                "rejoin",
                "complete"
              ]
            }
          },
          "required": [
            "npc",
            "quest",
            "transition"
          ],
          "additionalProperties": false,
          "description": "Starts, rejoins or completes an escort: npc names the NPC who follows the player. start and rejoin keep the conversation going; complete finishes the dialogue's quest."
        },
        "exchange": {"description":"A quest item exchange.",
          "const": true
        },
        "lesson_payment": {"description":"An amount of a resource the actor pays for a lesson.",
          "type": "object",
          "properties": {
            "to": {"description":"The npc role paid.",
              "$ref": "action.schema.json#/$defs/Key"
            },
            "resource": {"description":"The resource paid.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {"description":"How much.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "to",
            "resource",
            "amount"
          ],
          "additionalProperties": false
        },
        "patrol": {"description":"A patrol transition.",
          "type": "object",
          "properties": {
            "npc": {"description":"A bound NPC role.",
              "$ref": "action.schema.json#/$defs/Key"
            },
            "quest": {"description":"The patrol quest.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "transition": {"description":"The transition made.",
              "enum": [
                "start",
                "continue",
                "rejoin",
                "restart"
              ]
            }
          },
          "required": [
            "npc",
            "quest",
            "transition"
          ],
          "additionalProperties": false
        },
        "check": {"description":"An opposed check made when chosen.",
          "$ref": "step.schema.json#/$defs/Check"
        },
        "policy": {"description":"When this option is shown: a condition the player must meet, checked with the speaker.",
          "$ref": "policy.schema.json#/$defs/Policy"
        },
        "order": {"description":"Display position among this dialogue's choices, lowest first; a choice with none follows, and a tie or none sorts by key. The compiler writes it for a scene set in an unsorted order.",
          "type": "integer",
          "minimum": 1
        },
        "sitting": {"description":"Taken, this choice leaves the reopened hub until the conversation next opens. Only on a plain answer of a dialogue that reopens; the compiler refuses the rest.",
          "const": true
        },
        "then": {"description":"The conversation to go to next, or end to finish talking.",
          "$ref": "action.schema.json#/$defs/Key"
        },
        "then_failed": {"description":"The conversation to go to next when this option's check fails.",
          "$ref": "action.schema.json#/$defs/Key"
        },
        "narration_variants": {"description":"Other lines read on choosing, each used while its condition holds.",
          "$ref": "entity.schema.json#/$defs/TextVariants"
        },
        "asked_when": {
          "description": "While it holds, the view marks this option asked; it never refuses the choice. Lowered from a source choice's `asked: true`.",
          "$ref": "policy.schema.json#/$defs/Policy"
        }
      },
      "required": [
        "label",
        "narration"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "label": "dialogue.bram.carry",
          "narration": "dialogue.bram.carry.narration",
          "steps": [
            {
              "op": "fact.assign",
              "fact": {
                "cartridge_id": "ferry_sampler",
                "cartridge_version": "0.0.1",
                "kind": "fact",
                "key": "search_plan"
              },
              "value": "player_led"
            }
          ]
        },
        {
          "label": "quest.lantern.accept",
          "narration": "dialogue.bram.offer.narration",
          "accept": {
            "cartridge_id": "ferry_sampler",
            "cartridge_version": "0.0.1",
            "kind": "quest",
            "key": "lantern"
          }
        }
      ]
    }
  }
}
