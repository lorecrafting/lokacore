{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quest contracts",
  "description": "QuestDefinition and its objective (06 §1, §2, §3 Objective credit/causation policy, §43; 04 §5.2), owned by quest@1. The persisted lifecycle state is policy.schema.json QuestState.",
  "$defs": {
    "QuestDefinition": {
      "description": "A quest with one objective (06 §2; R6P pre-release-proof.md), keyed in CompiledCartridge.quests by DefinitionRefString of kind quest, owned by quest@1 (a cartridge with one requires it): its key, also the stable action key of its offer (no action's, recipe's or registered command's: DUPLICATE_DEFINITION); title, the text key of its journal entry (QuestView.title); offer, optional, the accept action its actor's ActionSet lists while the actor has no instance of the quest (label its text key, policy its availability: while it fails the offer is shown unavailable and accept_quest is rejected), which resolves to accept_quest; without one, only a dialogue choice's accept (dialogue.schema.json DialogueChoice) activates the quest; and objective (QuestObjective). Resolution is another capability's: a choice resolves it through quest@1's resolution, which re-checks the objective. Giver, turn-in, prerequisites beyond the offer's policy, further objectives, outcomes and automatic or discovered activation join as optional fields. Optional journal declares lifecycle texts (QuestJournal); selection is computed in QuestView without changing persisted state.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "title": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "offer": {
          "type": "object",
          "properties": {
            "label": {
              "$ref": "text.schema.json#/$defs/TextKey"
            },
            "policy": {
              "$ref": "policy.schema.json#/$defs/VersionedPolicy"
            }
          },
          "required": [
            "label",
            "policy"
          ],
          "additionalProperties": false
        },
        "objective": {
          "$ref": "#/$defs/QuestObjective"
        },
        "deadline": {
          "description": "A quest deadline, one object (validate.ts oneOf needs a const discriminator). Legacy (S2): at, fact, trust_fact and trust_amount, no after. Generic (toolbox row W24, kernel_api 1.46): exactly one of after (logical units from activation) or at (absolute logical time), no legacy field; activation schedules one engine job and expiry fails the instance with outcome and emits quest_failed. The loader refuses any other shape (SCHEMA_VIOLATION).",
          "type": "object",
          "properties": {
            "after": {
              "type": "integer",
              "minimum": 1
            },
            "at": {
              "$ref": "command.schema.json#/$defs/LogicalTime"
            },
            "outcome": {
              "$ref": "action.schema.json#/$defs/Key"
            },
            "fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "trust_fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "trust_amount": {
              "type": "integer"
            }
          },
          "required": [
            "outcome"
          ],
          "additionalProperties": false
        },
        "journal": {
          "$ref": "#/$defs/QuestJournal"
        },
        "repeatable": {
          "const": true
        },
        "exchange": {
          "type": "object",
          "properties": {
            "npc": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "outgoing": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "incoming": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "contribution": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "faction": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "increment": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "npc",
            "outgoing",
            "incoming",
            "quantity",
            "contribution",
            "faction",
            "increment"
          ],
          "additionalProperties": false
        },
        "patrol": {
          "type": "object",
          "properties": {
            "npc": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "route": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 2,
              "maxItems": 64
            },
            "initial_cursor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "required": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "trust_fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "narration": {
              "$ref": "text.schema.json#/$defs/TextKey"
            }
          },
          "required": [
            "npc",
            "route",
            "initial_cursor",
            "checkpoints",
            "required",
            "trust_fact",
            "narration"
          ],
          "additionalProperties": false
        },
        "expedition": {
          "type": "object",
          "properties": {
            "start_room": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "start_detail": {
              "$ref": "action.schema.json#/$defs/Key"
            },
            "shelter_room": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "shelter_detail": {
              "$ref": "action.schema.json#/$defs/Key"
            },
            "route": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  },
                  "direction": {
                    "$ref": "action.schema.json#/$defs/Key"
                  },
                  "to": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "required": [
                  "from",
                  "direction",
                  "to"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 32
            },
            "footprint": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/DefinitionRef"
              },
              "minItems": 2,
              "maxItems": 32
            },
            "survived_fact": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "faction": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "faction_delta": {
              "type": "integer",
              "minimum": -100,
              "maximum": -1
            },
            "hound_population": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "narration": {
              "type": "object",
              "properties": {
                "start": {
                  "$ref": "text.schema.json#/$defs/TextKey"
                },
                "restart": {
                  "$ref": "text.schema.json#/$defs/TextKey"
                },
                "shelter": {
                  "$ref": "text.schema.json#/$defs/TextKey"
                },
                "failed": {
                  "$ref": "text.schema.json#/$defs/TextKey"
                },
                "completed": {
                  "$ref": "text.schema.json#/$defs/TextKey"
                }
              },
              "required": [
                "start",
                "restart",
                "shelter",
                "failed",
                "completed"
              ],
              "additionalProperties": false
            },
            "actions": {
              "type": "object",
              "properties": {
                "start": {
                  "$ref": "action.schema.json#/$defs/Key"
                },
                "restart": {
                  "$ref": "action.schema.json#/$defs/Key"
                },
                "shelter": {
                  "$ref": "action.schema.json#/$defs/Key"
                }
              },
              "required": [
                "start",
                "restart",
                "shelter"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "start_room",
            "start_detail",
            "shelter_room",
            "shelter_detail",
            "route",
            "footprint",
            "survived_fact",
            "faction",
            "faction_delta",
            "hound_population",
            "narration",
            "actions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "key",
        "title",
        "objective"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "lantern",
          "title": "quest.lantern.title",
          "offer": {
            "label": "quest.lantern.accept",
            "policy": {
              "policy_version": 1,
              "root": {
                "op": "all",
                "items": []
              }
            }
          },
          "objective": {
            "evidence": "current_state",
            "policy": {
              "policy_version": 1,
              "root": {
                "op": "has_item",
                "item": {
                  "cartridge_id": "ferrymans_lantern",
                  "cartridge_version": "0.1.0",
                  "kind": "item",
                  "key": "lantern"
                }
              }
            }
          }
        },
        {
          "key": "lantern",
          "title": "quest.lantern.title",
          "objective": {
            "evidence": "current_state",
            "policy": {
              "policy_version": 1,
              "root": {
                "op": "has_item",
                "item": {
                  "cartridge_id": "ferrymans_lantern",
                  "cartridge_version": "0.1.0",
                  "kind": "item",
                  "key": "lantern"
                }
              }
            }
          },
          "journal": {
            "active": "quest.lantern.find",
            "objectives_met": "quest.lantern.return",
            "resolved": "quest.lantern.done",
            "failed": "quest.lantern.failed",
            "abandoned": "quest.lantern.abandoned",
            "outcomes": {
              "carry": "quest.lantern.carried"
            }
          }
        }
      ]
    },
    "QuestObjective": {
      "description": "A quest's one objective and its evidence policy (06 §3 Objective credit/causation policy, §43; 04 §5.2). current_state: met while policy holds for the actor, evaluated on the state at hand and never stored (the R6P lantern: current possession, so a lantern taken before acceptance counts and one given away no longer does). post_activation_event: met by an item_acquired event whose item is the item `item_acquired` names and whose holder is the actor's body, at a causal position after the instance's activation; the instance then moves to objectives_complete in the same decision, and an acquisition before activation never counts (the Tiny fixture's strict credit; its automatic resolution is not part of this vocabulary yet).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "evidence": {
              "const": "current_state"
            },
            "policy": {
              "$ref": "policy.schema.json#/$defs/VersionedPolicy"
            }
          },
          "required": [
            "evidence",
            "policy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "const": "post_activation_event"
            },
            "item_acquired": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "evidence",
            "item_acquired"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "const": "patrol"
            }
          },
          "required": [
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "const": "expedition"
            }
          },
          "required": [
            "evidence"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "evidence": "post_activation_event",
          "item_acquired": {
            "cartridge_id": "tiny",
            "cartridge_version": "0.0.1",
            "kind": "item",
            "key": "lantern"
          }
        }
      ]
    },
    "QuestJournal": {
      "description": "Lifecycle journal texts, selected by quest@1 in GameView (06 §2, §41; 04 §15, c1-journal amendment). All five stage texts are required; outcomes optionally overrides terminal text by outcome key. Outcome keys need not name a dialogue choice. Reveal remains LATER. API1.9 active_variants are checked in order for active quests; the first holding policy supplies text, otherwise ordinary active/objectives_met selection applies. API1.46 hints (toolbox row W23): per stage (active, objectives_met), each after a whole number of real minutes since the stage began (the instance's started_at), strictly ascending, and at least one stage (an empty hints object is a loader check: the subset has no minProperties); the Journal shows the last one whose time has passed.",
      "type": "object",
      "properties": {
        "active": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "objectives_met": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "resolved": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "failed": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "abandoned": {
          "$ref": "text.schema.json#/$defs/TextKey"
        },
        "outcomes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "text.schema.json#/$defs/TextKey"
          }
        },
        "active_variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "policy.schema.json#/$defs/VersionedPolicy"
              },
              "text": {
                "$ref": "text.schema.json#/$defs/TextKey"
              }
            },
            "required": [
              "when",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "hints": {
          "type": "object",
          "properties": {
            "active": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "after": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440
                  },
                  "text": {
                    "$ref": "text.schema.json#/$defs/TextKey"
                  }
                },
                "required": [
                  "after",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "objectives_met": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "after": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440
                  },
                  "text": {
                    "$ref": "text.schema.json#/$defs/TextKey"
                  }
                },
                "required": [
                  "after",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "active",
        "objectives_met",
        "resolved",
        "failed",
        "abandoned"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "active": "quest.lantern.find",
          "objectives_met": "quest.lantern.return",
          "resolved": "quest.lantern.done",
          "failed": "quest.lantern.failed",
          "abandoned": "quest.lantern.abandoned",
          "outcomes": {
            "carry": "quest.lantern.carried"
          }
        },
        {
          "active": "quest.lantern.find",
          "objectives_met": "quest.lantern.return",
          "resolved": "quest.lantern.done",
          "failed": "quest.lantern.failed",
          "abandoned": "quest.lantern.abandoned"
        },
        {
          "active": "quest.lantern.find",
          "objectives_met": "quest.lantern.return",
          "resolved": "quest.lantern.done",
          "failed": "quest.lantern.failed",
          "abandoned": "quest.lantern.abandoned",
          "outcomes": {}
        }
      ]
    }
  }
}
