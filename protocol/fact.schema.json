{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fact contracts",
  "description": "FactSpec and scoped facts (03 §7, §13; 21 §3.9, §4 Fact).",
  "$defs": {
    "FactType": {
      "description": "What kind of value the fact holds and where it starts: true or false (bool), one of a list of words (enum), or a whole number with optional bounds (int).",
      "oneOf": [
        {
          "description": "True or false.",
          "type": "object",
          "properties": {
            "type": {
              "const": "bool"
            },
            "default": {"description":"Value before any assignment.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "default"
          ],
          "additionalProperties": false
        },
        {
          "description": "One of a list of words; the starting value must be one of them.",
          "type": "object",
          "properties": {
            "type": {
              "const": "enum"
            },
            "values": {"description":"The keys the fact may hold.",
              "type": "array",
              "items": {
                "$ref": "action.schema.json#/$defs/Key"
              },
              "minItems": 1
            },
            "default": {"description":"Value before any assignment; one of values.",
              "$ref": "action.schema.json#/$defs/Key"
            }
          },
          "required": [
            "type",
            "values",
            "default"
          ],
          "additionalProperties": false
        },
        {
          "description": "A whole number, optionally between a lowest and a highest value (both allowed); the starting value must be within them.",
          "type": "object",
          "properties": {
            "type": {
              "const": "int"
            },
            "minimum": {"description":"Lowest value allowed, inclusive.",
              "type": "integer"
            },
            "maximum": {"description":"Highest value allowed, inclusive.",
              "type": "integer"
            },
            "default": {"description":"Value before any assignment.",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "default"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "type": "bool",
          "default": false
        },
        {
          "type": "enum",
          "values": [
            "missing",
            "rescued",
            "lost"
          ],
          "default": "missing"
        },
        {
          "type": "int",
          "minimum": -10,
          "maximum": 10,
          "default": 0
        },
        {
          "type": "int",
          "default": 0
        }
      ]
    },
    "FactSpec": {
      "description": "A fact: its type, starting value, what it can belong to, and what it means.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "version": {"description":"The version of the fact's type.",
          "type": "integer",
          "minimum": 1
        },
        "value_type": {"description":"The fact's type and default value.",
          "$ref": "#/$defs/FactType"
        },
        "scopes": {"description":"The scope kinds allowed. This kernel accepts exactly one, `player` or `instance`.",
          "type": "array",
          "items": {
            "enum": [
              "player",
              "party",
              "instance",
              "realm"
            ]
          },
          "minItems": 1
        },
        "per_subject": {
          "description": "True if the fact has its own value for each NPC, item or detail rather than one value overall.",
          "const": true
        },
        "npc_pair": {
          "description": "A pair fact between two NPCs, one value per ordered pair (the subject NPC toward the with NPC), stored with subject_id and with_id. Needs per_subject and scopes exactly [instance] (world state).",
          "const": true
        },
        "meaning": {"description":"What the fact means, for authors. The rules do not read it.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "version",
        "value_type",
        "scopes",
        "meaning"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "child_status",
          "version": 1,
          "value_type": {
            "type": "enum",
            "values": [
              "missing",
              "rescued",
              "lost"
            ],
            "default": "missing"
          },
          "scopes": [
            "instance"
          ],
          "meaning": "Whether the missing child was found."
        },
        {
          "key": "search_plan",
          "version": 1,
          "value_type": {
            "type": "enum",
            "values": [
              "undecided",
              "player_led",
              "party_led"
            ],
            "default": "undecided"
          },
          "scopes": [
            "player"
          ],
          "meaning": "Who leads the search."
        }
      ]
    },
    "ScopedFact": {
      "description": "One stored fact value (03 §13): unique by fact, scope and subject_id within its world context, the same identity as the fact MutationTarget (delta.schema.json). An unset fact has its FactSpec default and no record. Revision and timestamps are host persistence metadata, not portable state.",
      "type": "object",
      "properties": {
        "fact": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "fact_version": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "$ref": "scope.schema.json#/$defs/StateScope"
        },
        "subject_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "with_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "value": {
          "$ref": "delta.schema.json#/$defs/FactValue"
        }
      },
      "required": [
        "fact",
        "fact_version",
        "scope",
        "value"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "fact": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "kind": "fact",
            "key": "search_plan"
          },
          "fact_version": 1,
          "scope": {
            "kind": "player",
            "character_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d"
          },
          "value": "player_led"
        },
        {
          "fact": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "kind": "fact",
            "key": "bell_rung"
          },
          "fact_version": 1,
          "scope": {
            "kind": "instance",
            "world_context_id": "0d4e8a5c-3f1b-4c2a-9e7d-6b5a4c3d2e1f"
          },
          "value": true
        },
        {
          "fact": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "kind": "fact",
            "key": "priory_fen"
          },
          "fact_version": 1,
          "scope": {
            "kind": "player",
            "character_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d"
          },
          "value": -10
        }
      ]
    }
  }
}
