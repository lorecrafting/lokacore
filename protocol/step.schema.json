{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step and check contracts",
  "description": "One step vocabulary and one check vocabulary (C3 D2, loka-ivjq.4): a reaction's steps, a scripted action outcome's steps and a dialogue choice's steps list Steps, and a service's benefit is one Step; a scripted action's and a dialogue choice's check is a Check. Each context runs a declared subset, enforced by the compiler (lib/loka/content/steps.ex, lib/loka/content/check_kinds.ex).",
  "$defs": {
    "Step": {
      "description": "One thing an action, reaction or choice does, named by op: set a fact, send a custom event, change a pool, and so on.",
      "examples": [
        {
          "op": "fact.assign",
          "fact": {
            "cartridge_id": "recipe_sampler",
            "cartridge_version": "0.0.1",
            "kind": "fact",
            "key": "chapel_bell_rung"
          },
          "value": true
        },
        {
          "op": "event.emit",
          "event": "bell_rung"
        },
        {
          "op": "resource.adjust",
          "resource": {
            "cartridge_id": "check_sampler",
            "cartridge_version": "0.0.1",
            "kind": "resource",
            "key": "hp"
          },
          "by": -3
        }
      ],
      "oneOf": [
        {
          "description": "Assign a fact.",
          "type": "object",
          "properties": {
            "op": {
              "const": "fact.assign"
            },
            "fact": {"description":"The declared fact to set.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "npc": {"description":"The NPC holding the fact: the one placed in the world from this definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "item": {"description":"The item holding the fact: the one placed in the world from this definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "with": {
              "description": "An npc_pair fact's second NPC; the step writes at the pair (its subject toward this NPC).",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "value": {"description":"The new value, of the fact's type.",
              "$ref": "delta.schema.json#/$defs/FactValue"
            }
          },
          "required": [
            "op",
            "fact",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "description": "Adds amount to a bounded int fact, clamped to its minimum and maximum, at the subject a fact.assign step writes at.",
          "type": "object",
          "properties": {
            "op": {
              "const": "fact.adjust"
            },
            "fact": {"description":"The bounded int fact to change.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "npc": {"description":"As fact.assign npc.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "item": {"description":"As fact.assign item.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "with": {
              "description": "An npc_pair fact's second NPC; the step writes at the pair (its subject toward this NPC).",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {"description":"What to add; negative subtracts. The result is clamped to the fact's bounds.",
              "type": "integer"
            }
          },
          "required": [
            "op",
            "fact",
            "amount"
          ],
          "additionalProperties": false
        },
        {"description":"Starts a quest.",
          "type": "object",
          "properties": {
            "op": {
              "const": "quest.activate"
            },
            "quest": {"description":"The quest to activate.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "quest"
          ],
          "additionalProperties": false
        },
        {"description":"Completes a quest with an outcome.",
          "type": "object",
          "properties": {
            "op": {
              "const": "quest.resolve"
            },
            "quest": {"description":"The quest to resolve.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "outcome": {"description":"The outcome key it resolves with.",
              "$ref": "action.schema.json#/$defs/Key"
            }
          },
          "required": [
            "op",
            "quest",
            "outcome"
          ],
          "additionalProperties": false
        },
        {"description":"Fails a quest with an outcome.",
          "type": "object",
          "properties": {
            "op": {
              "const": "quest.fail"
            },
            "quest": {"description":"The quest to fail.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "outcome": {"description":"The outcome key it fails with.",
              "$ref": "action.schema.json#/$defs/Key"
            }
          },
          "required": [
            "op",
            "quest",
            "outcome"
          ],
          "additionalProperties": false
        },
        {
          "description": "Suppress one authored population plan for duration logical seconds from this accepted fact-change cause, preserving current members and closing its current encounter.",
          "type": "object",
          "properties": {
            "op": {
              "const": "population.suppress"
            },
            "plan": {"description":"The population plan to suppress.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "duration": {"description":"How long, in logical seconds.",
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "op",
            "plan",
            "duration"
          ],
          "additionalProperties": false
        },
        {
          "description": "Starts a status, or refreshes it if already active. In a reaction it lands on the event's subject, the named item or NPC, or every living NPC in the room; in a spell, on the named NPC, the aimed target or the caster. Anything immune to the status is skipped.",
          "type": "object",
          "properties": {
            "op": {
              "const": "status.apply"
            },
            "status": {"description":"The status to apply.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "item": {"description":"Lands on the item placed in the world from this definition.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "npc": {"description":"Lands on the NPC placed in the world from this definition; never with item.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "room": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef",
              "description": "Put the status on this room instead of a person or item."
            },
            "co_present": {
              "enum": [
                true
              ],
              "description": "Put the status on every living NPC in the room (not the player) instead of one target."
            },
            "tag": {
              "$ref": "entity.schema.json#/$defs/Tag",
              "description": "With co_present only: put the status on every item lying in the room with this tag instead."
            }
          },
          "required": [
            "op",
            "status"
          ],
          "dependentRequired": {
            "tag": [
              "co_present"
            ]
          },
          "additionalProperties": false
        },
        {
          "description": "Force a door, or every door here with this tag, into a state with no key or check, such as a door burnt open. Locking needs the door's key to exist.",
          "type": "object",
          "properties": {
            "op": {
              "const": "barrier.set"
            },
            "to": {"description":"The state to move to.",
              "$ref": "room.schema.json#/$defs/BarrierState"
            },
            "barrier": {"description":"The one barrier to move.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "tag": {"description":"Moves every barrier on an exit of the event's room carrying this tag.",
              "$ref": "entity.schema.json#/$defs/Tag"
            }
          },
          "exactlyOneRequired": [
            "barrier",
            "tag"
          ],
          "required": [
            "op",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "description": "Ends this status where it is active: on the event's subject in a reaction, or on the scripted action's target. No line is shown.",
          "type": "object",
          "properties": {
            "op": {
              "const": "status.cure"
            },
            "status": {"description":"The status to end.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "description": "Give the player this much experience; needs levelling in the world settings.",
          "type": "object",
          "properties": {
            "op": {
              "const": "experience.grant"
            },
            "amount": {"description":"Experience to add.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "op",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "description": "End the acting character's open conversation as Leave would (one choice.close, no event, no line); with none open, nothing.",
          "type": "object",
          "properties": {
            "op": {
              "const": "end_talk"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "description": "For decay rules: moves the event's item into room, unless it is already there or used up. Nothing is checked and nothing is told; any other subject is left alone.",
          "type": "object",
          "properties": {
            "op": {
              "const": "item.move"
            },
            "room": {"description":"The room the item moves to.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "room"
          ],
          "additionalProperties": false
        },
        {
          "description": "Moves the named NPC (or the event's subject when it is an NPC) straight to room, or to the event's room, without using exits. With plan instead of npc, moves every living NPC of that population plan. Nothing happens if the NPC is dead, fighting, escorting or already there.",
          "type": "object",
          "properties": {
            "op": {
              "const": "npc.move"
            },
            "npc": {"description":"The NPC to move; else the event's subject when it is an NPC.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "plan": {"description":"Moves every living member of this population plan instead; never with npc, room required.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "room": {"description":"The destination; else the event's room.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "description": "For timed world events: adds one group of the population to its home, in a free slot, as the population's own births do. With no free slot nothing is born. No dice are rolled.",
          "type": "object",
          "properties": {
            "op": {
              "const": "population.spawn"
            },
            "plan": {"description":"The population plan to birth a bundle of.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "plan"
          ],
          "additionalProperties": false
        },
        {
          "description": "Run one restock at once: move items as the named replenish rule would, without waiting.",
          "type": "object",
          "properties": {
            "op": {
              "const": "replenish.run"
            },
            "replenish": {"description":"The replenish entry to run once.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "replenish"
          ],
          "additionalProperties": false
        },
        {
          "description": "Adds the line text to what the player reads, after the lines of earlier steps. Changes nothing in the world.",
          "type": "object",
          "properties": {
            "op": {
              "const": "narrate"
            },
            "text": {"description":"The line to append.",
              "$ref": "text.schema.json#/$defs/TextKey"
            }
          },
          "required": [
            "op",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "description": "NPC emotes: an NPC performs an emote from the cartridge's table. The one emoting is npc (the one placed in the world, alive in the delivery's room), else the delivery's subject; to subject makes the subject the target and needs the emote's wording for a target. Adds one emote line to the story, shown only to a reader who sees the one emoting; changes nothing else and sets off nothing.",
          "type": "object",
          "properties": {
            "op": {
              "const": "emote"
            },
            "emote": {"description":"The emote of the cartridge table to perform.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "npc": {"description":"The emoter, alive in the room; else the subject.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "to": {"description":"`subject` makes the subject the target.",
              "enum": [
                "subject"
              ]
            }
          },
          "required": [
            "op",
            "emote"
          ],
          "additionalProperties": false
        },
        {
          "description": "Writes the delivery's logical time into an int fact (no maximum, minimum absent or at most 0) at the subject a fact.assign step writes at, as a fact.assign.",
          "type": "object",
          "properties": {
            "op": {
              "const": "fact.stamp"
            },
            "fact": {"description":"The int fact that receives the delivery's logical time.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "npc": {"description":"As fact.assign npc.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "item": {"description":"As fact.assign item.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "fact"
          ],
          "additionalProperties": false
        },
        {
          "description": "Emit a custom event.",
          "type": "object",
          "properties": {
            "op": {
              "const": "event.emit"
            },
            "event": {"description":"The custom event key.",
              "$ref": "action.schema.json#/$defs/Key"
            }
          },
          "required": [
            "op",
            "event"
          ],
          "additionalProperties": false
        },
        {
          "description": "Spells only: the named NPC (or the spell's target) takes this much damage of this kind, after its resistances; at 0 it dies, killed by the caster.",
          "type": "object",
          "properties": {
            "op": {
              "const": "damage"
            },
            "npc": {"description":"The NPC hit; else an aimed spell's target.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "kind": {"description":"The damage kind, read against resistances.",
              "$ref": "entity.schema.json#/$defs/DamageKind"
            },
            "amount": {"description":"HP lost before resistances.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "op",
            "kind",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "description": "Spells only: light the named fuel source (or the spell's target), as the ignite verb would.",
          "type": "object",
          "properties": {
            "op": {
              "const": "light.ignite"
            },
            "item": {"description":"The fuel source to ignite; else an aimed spell's target.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "description": "Adjust a resource of the actor's body by `by`, stopping at its bounds.",
          "type": "object",
          "properties": {
            "op": {
              "const": "resource.adjust"
            },
            "resource": {"description":"The pool on the actor's body.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "by": {"description":"The signed change.",
              "$ref": "resource.schema.json#/$defs/ResourceInt"
            }
          },
          "required": [
            "op",
            "resource",
            "by"
          ],
          "additionalProperties": false
        },
        {
          "description": "Builds structure in direction from the site room, for the actor. In a scripted action it works only on a success outcome; in a service it is a benefit. Refused when that spot is built already or the world's building limit is reached. With fact and escrow it becomes an order: the items are held and the room is built ready_after seconds later; a cancel returns the items but not the fee.",
          "type": "object",
          "properties": {
            "op": {
              "const": "build"
            },
            "structure": {"description":"The structure to raise.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "direction": {"description":"The direction from the site the room is raised toward.",
              "enum": [
                "north",
                "south",
                "east",
                "west",
                "up",
                "down"
              ]
            },
            "site": {"description":"The site room.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "fact": {"description":"With escrow, makes a commission: true from the order until the job raises the room.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "escrow": {
              "type": "object",
              "description": "The items the player hands over with the order; ready_after seconds later the room is built.",
              "properties": {
                "items": {"description":"The item definitions accepted as payment.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "quantity": {"description":"How many of them move.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "custody": {"description":"The room holding them.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "ready_after": {"description":"Seconds until the order job raises the room.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31536000
                }
              },
              "required": [
                "items",
                "quantity",
                "custody",
                "ready_after"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "op",
            "structure",
            "direction"
          ],
          "additionalProperties": false,
          "dependentRequired": {
            "fact": [
              "escrow"
            ],
            "escrow": [
              "fact"
            ]
          }
        },
        {"description":"The player learns a skill.",
          "type": "object",
          "properties": {
            "op": {
              "const": "skill.acquire"
            },
            "skill": {"description":"The skill the actor acquires.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "skill"
          ],
          "additionalProperties": false
        },
        {"description":"The player learns a topic they can ask about.",
          "type": "object",
          "properties": {
            "op": {
              "const": "topic.grant"
            },
            "topic": {"description":"The topic the actor comes to know.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "topic"
          ],
          "additionalProperties": false
        },
        {"description":"A service's benefit: the player is now owed something, such as a paid room, recorded in a fact.",
          "type": "object",
          "properties": {
            "op": {
              "const": "entitlement"
            },
            "fact": {"description":"The fact recording the entitlement.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "escrow": {
              "type": "object",
              "description": "Items the player hands over with the order; they wait in the custody room. With ready_after and output, the order takes time and is claimed later, and cancelling returns the items but not the fee. With output and no ready_after it is an immediate trade.",
              "properties": {
                "items": {"description":"The item definitions accepted as payment.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "identity.schema.json#/$defs/DefinitionRef"
                  }
                },
                "quantity": {"description":"How many of them move.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "custody": {"description":"The room holding them.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                },
                "ready_after": {"description":"Seconds of work a claim waits for; needs output.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31536000
                },
                "output": {"description":"The item lying in custody the order hands over.",
                  "$ref": "identity.schema.json#/$defs/DefinitionRef"
                }
              },
              "required": [
                "items",
                "quantity",
                "custody"
              ],
              "additionalProperties": false,
              "dependentRequired": {
                "ready_after": [
                  "output"
                ]
              }
            }
          },
          "required": [
            "op",
            "fact"
          ],
          "additionalProperties": false
        },
        {"description":"A service's benefit: a meal that draws on the provider's stock and restores the body.",
          "type": "object",
          "properties": {
            "op": {
              "const": "meal"
            },
            "stock": {"description":"The provider's resource the meal draws on.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "debit": {"description":"How much leaves stock per meal.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "recovery": {"description":"The body resource restored.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {"description":"How much is restored, up to its maximum.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "op",
            "stock",
            "debit",
            "recovery",
            "amount"
          ],
          "additionalProperties": false
        },
        {"description":"A service's benefit: a drink served from a vessel that restores the body.",
          "type": "object",
          "properties": {
            "op": {
              "const": "drink"
            },
            "vessel": {"description":"The authored vessel the serving comes from.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "liquid": {"description":"The liquid it must hold.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "recovery": {"description":"The body resource restored.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {"description":"How much is restored, up to its maximum.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "op",
            "vessel",
            "liquid",
            "recovery",
            "amount"
          ],
          "additionalProperties": false
        },
        {"description":"A service's benefit: repairs the player's wielded weapon.",
          "type": "object",
          "properties": {
            "op": {
              "const": "repair"
            },
            "fact": {"description":"The durability fact of the wielded weapon (weapon.durability.fact).",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {"description":"Durability restored, up to its maximum.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "op",
            "fact",
            "amount"
          ],
          "additionalProperties": false
        },
        {"description":"A service's benefit: collects the player's ready order.",
          "type": "object",
          "properties": {
            "op": {
              "const": "claim"
            },
            "service": {"description":"The service whose order is claimed.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "service"
          ],
          "additionalProperties": false
        },
        {"description":"A service's benefit: cancels the player's order.",
          "type": "object",
          "properties": {
            "op": {
              "const": "cancel"
            },
            "service": {"description":"The service whose order is cancelled.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            }
          },
          "required": [
            "op",
            "service"
          ],
          "additionalProperties": false
        },
        {"description":"A service's benefit: puts the player's money into a shared vault; a fact shows their balance.",
          "type": "object",
          "properties": {
            "op": {
              "const": "deposit"
            },
            "account": {"description":"The bounded int player fact mirroring the balance.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "vault": {"description":"The NPC holding the shared pool.",
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "amount": {"description":"Currency moved, separate from the service's price.",
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "op",
            "account",
            "vault",
            "amount"
          ],
          "additionalProperties": false
        },
        {"description":"A service's benefit: takes the player's money out of a shared vault.",
