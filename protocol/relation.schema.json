{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relation and provenance contracts",
  "description": "Typed relations and runtime entity identity/provenance (21 \u00a74; 03 \u00a73, \u00a711; 05 \u00a725).",
  "$defs": {
    "Relation": {
      "description": "A typed, capability-owned relation between runtime entities (21 \u00a74 'Typed relations'; Loka is not an untyped graph). One branch per kind in use: containment (containment@1), an entity's one container (03 \u00a723). Equipment, ownership, custody, membership, following, participation and relationship links join as branches with their owning capability.",
      "oneOf": [
        {
          "description": "entity_id is directly inside container_id (a room, character or container).",
          "type": "object",
          "properties": {
            "kind": {
              "const": "containment"
            },
            "entity_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            "container_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            }
          },
          "required": [
            "kind",
            "entity_id",
            "container_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "escort"
            },
            "actor_id": {
              "$ref": "identity.schema.json#/$defs/CharacterId"
            },
            "body_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            "npc_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            "quest_instance_id": {
              "$ref": "delta.schema.json#/$defs/QuestInstanceId"
            },
            "continuation_id": {
              "$ref": "delta.schema.json#/$defs/ContinuationId"
            },
            "choice_id": {
              "$ref": "action.schema.json#/$defs/Key"
            },
            "status": {
              "$ref": "relation.schema.json#/$defs/EscortStatus"
            }
          },
          "required": [
            "kind",
            "actor_id",
            "body_id",
            "npc_id",
            "quest_instance_id",
            "continuation_id",
            "choice_id",
            "status"
          ],
          "additionalProperties": false,
          "description": "API1.11 escort@1 relation, keyed by actor_id. Identity is immutable; only status changes through escort.transition. The original continuation and choice bind the selected NPC and active quest instance.",
          "examples": [
            {
              "kind": "escort",
              "actor_id": "11111111-2222-4333-8444-555555555555",
              "body_id": "22222222-2222-4333-8444-555555555555",
              "npc_id": "33333333-2222-4333-8444-555555555555",
              "quest_instance_id": "44444444-2222-4333-8444-555555555555",
              "continuation_id": "55555555-2222-4333-8444-555555555555",
              "choice_id": "rescue",
              "status": "following"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "patrol"
            },
            "actor_id": {
              "$ref": "identity.schema.json#/$defs/CharacterId"
            },
            "body_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            "npc_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            "quest_instance_id": {
              "$ref": "delta.schema.json#/$defs/QuestInstanceId"
            },
            "continuation_id": {
              "$ref": "delta.schema.json#/$defs/ContinuationId"
            },
            "choice_id": {
              "$ref": "action.schema.json#/$defs/Key"
            },
            "attempt_id": {
              "$ref": "identity.schema.json#/$defs/CommandId"
            },
            "cursor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "credit": {
              "type": "array",
              "items": {
                "$ref": "identity.schema.json#/$defs/EntityId"
              },
              "maxItems": 64
            },
            "status": {
              "$ref": "relation.schema.json#/$defs/PatrolStatus"
            }
          },
          "required": [
            "kind",
            "actor_id",
            "body_id",
            "npc_id",
            "quest_instance_id",
            "continuation_id",
            "choice_id",
            "attempt_id",
            "cursor",
            "credit",
            "status"
          ],
          "additionalProperties": false,
          "description": "Quest-instance-keyed original leader attempt: immutable actor/body/NPC/activation identity, accepted command attempt, bounded cursor/unique checkpoint credit and explicit recovery lifecycle."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "expedition"
            },
            "actor_id": {
              "$ref": "identity.schema.json#/$defs/CharacterId"
            },
            "body_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            "quest_instance_id": {
              "$ref": "delta.schema.json#/$defs/QuestInstanceId"
            },
            "attempt_id": {
              "$ref": "identity.schema.json#/$defs/CommandId"
            },
            "cursor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "sheltered": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "active",
                "failed",
                "completed"
              ]
            }
          },
          "required": [
            "kind",
            "actor_id",
            "body_id",
            "quest_instance_id",
            "attempt_id",
            "cursor",
            "sheltered",
            "status"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "kind": "containment",
          "entity_id": "11111111-2222-4333-8444-555555555555",
          "container_id": "12121212-3434-4565-8787-909090909090"
        },
        {
          "kind": "escort",
          "actor_id": "11111111-2222-4333-8444-555555555555",
          "body_id": "22222222-2222-4333-8444-555555555555",
          "npc_id": "33333333-2222-4333-8444-555555555555",
          "quest_instance_id": "44444444-2222-4333-8444-555555555555",
          "continuation_id": "55555555-2222-4333-8444-555555555555",
          "choice_id": "rescue",
          "status": "following"
        }
      ]
    },
    "EntityOrigin": {
      "description": "Where a runtime entity came from (21 \u00a74 'spawn/population provenance'; 05 \u00a725 'Population provenance': a plan may only replenish or clean up what it spawned).",
      "oneOf": [
        {
          "description": "Placed by the cartridge's authored content.",
          "type": "object",
          "properties": {
            "kind": {
              "const": "authored"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "Created by the definition `by` (a spawn bundle or population plan).",
          "type": "object",
          "properties": {
            "kind": {
              "const": "spawned"
            },
            "by": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "bundle": {
              "$ref": "identity.schema.json#/$defs/DefinitionRef"
            },
            "slot": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "occurrence_id": {
              "$ref": "identity.schema.json#/$defs/CommandId"
            },
            "member_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            "role": {
              "enum": [
                "hound",
                "pelt",
                "deer",
                "hide"
              ]
            }
          },
          "required": [
            "kind",
            "by",
            "bundle",
            "slot",
            "generation",
            "occurrence_id",
            "member_id",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "death"
            },
            "victim_id": {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            "event_id": {
              "$ref": "event.schema.json#/$defs/EventId"
            },
            "owner_id": {
              "anyOf": [
                {
                  "$ref": "identity.schema.json#/$defs/CharacterId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "victim_id",
            "event_id",
            "owner_id"
          ],
          "additionalProperties": false
        }
      ],
      "examples": [
        {
          "kind": "authored"
        },
        {
          "kind": "spawned",
          "by": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "kind": "population",
            "key": "fen_wisps"
          },
          "bundle": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "kind": "population_bundle",
            "key": "fen_hounds"
          },
          "slot": 1,
          "generation": 1,
          "occurrence_id": "00000000-0000-0000-0000-000000000000",
          "member_id": "11111111-1111-4111-8111-111111111111",
          "role": "hound"
        }
      ]
    },
    "EntityIdentity": {
      "description": "A runtime entity's identity and provenance (03 \u00a73, \u00a711; 21 \u00a74): its own id, the definition it instantiates (never the definition record itself), its origin, and for a player/party overlay entity its StateScope and AudiencePolicy; shared entities omit both. Authority revision is host metadata.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "definition": {
          "$ref": "identity.schema.json#/$defs/DefinitionRef"
        },
        "origin": {
          "$ref": "#/$defs/EntityOrigin"
        },
        "scope": {
          "$ref": "scope.schema.json#/$defs/StateScope"
        },
        "audience": {
          "$ref": "scope.schema.json#/$defs/AudiencePolicy"
        }
      },
      "required": [
        "id",
        "definition",
        "origin"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "id": "11111111-2222-4333-8444-555555555555",
          "definition": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "kind": "item",
            "key": "lantern"
          },
          "origin": {
            "kind": "authored"
          }
        },
        {
          "id": "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
          "definition": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "kind": "npc",
            "key": "wren"
          },
          "origin": {
            "kind": "authored"
          },
          "scope": {
            "kind": "player",
            "character_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d"
          },
          "audience": {
            "kind": "player",
            "character_id": "a7b8c9d0-e1f2-4a3b-9c4d-6e7f8a9b0c1d"
          }
        }
      ]
    },
    "EscortStatus": {
      "enum": [
        "following",
        "separated",
        "completed"
      ],
      "examples": [
        "following",
        "separated",
        "completed"
      ],
      "description": "The bounded escort lifecycle: following moves with the actor, separated waits for explicit rejoin, completed never follows again."
    },
    "EscortRelation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "escort"
        },
        "actor_id": {
          "$ref": "identity.schema.json#/$defs/CharacterId"
        },
        "body_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "npc_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "quest_instance_id": {
          "$ref": "delta.schema.json#/$defs/QuestInstanceId"
        },
        "continuation_id": {
          "$ref": "delta.schema.json#/$defs/ContinuationId"
        },
        "choice_id": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "status": {
          "$ref": "relation.schema.json#/$defs/EscortStatus"
        }
      },
      "required": [
        "kind",
        "actor_id",
        "body_id",
        "npc_id",
        "quest_instance_id",
        "continuation_id",
        "choice_id",
        "status"
      ],
      "additionalProperties": false,
      "description": "API1.11 escort@1 relation, keyed by actor_id. Identity is immutable; only status changes through escort.transition. The original continuation and choice bind the selected NPC and active quest instance.",
      "examples": [
        {
          "kind": "escort",
          "actor_id": "11111111-2222-4333-8444-555555555555",
          "body_id": "22222222-2222-4333-8444-555555555555",
          "npc_id": "33333333-2222-4333-8444-555555555555",
          "quest_instance_id": "44444444-2222-4333-8444-555555555555",
          "continuation_id": "55555555-2222-4333-8444-555555555555",
          "choice_id": "rescue",
          "status": "following"
        }
      ]
    },
    "PatrolStatus": {
      "enum": [
        "together",
        "awaiting",
        "paused",
        "failed",
        "completed"
      ],
      "description": "Together, awaiting ordinary player entry, explicitly paused, fatally failed or terminally completed.",
      "examples": [
        "together"
      ]
    },
    "PatrolRelation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "patrol"
        },
        "actor_id": {
          "$ref": "identity.schema.json#/$defs/CharacterId"
        },
        "body_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "npc_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "quest_instance_id": {
          "$ref": "delta.schema.json#/$defs/QuestInstanceId"
        },
        "continuation_id": {
          "$ref": "delta.schema.json#/$defs/ContinuationId"
        },
        "choice_id": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "attempt_id": {
          "$ref": "identity.schema.json#/$defs/CommandId"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "credit": {
          "type": "array",
          "items": {
            "$ref": "identity.schema.json#/$defs/EntityId"
          },
          "maxItems": 64
        },
        "status": {
          "$ref": "relation.schema.json#/$defs/PatrolStatus"
        }
      },
      "required": [
        "kind",
        "actor_id",
        "body_id",
        "npc_id",
        "quest_instance_id",
        "continuation_id",
        "choice_id",
        "attempt_id",
        "cursor",
        "credit",
        "status"
      ],
      "additionalProperties": false,
      "description": "Quest-instance-keyed original leader attempt: immutable actor/body/NPC/activation identity, accepted command attempt, bounded cursor/unique checkpoint credit and explicit recovery lifecycle.",
      "examples": [
        {
          "kind": "patrol",
          "actor_id": "11111111-2222-4333-8444-555555555555",
          "body_id": "22222222-2222-4333-8444-555555555555",
          "npc_id": "33333333-2222-4333-8444-555555555555",
          "quest_instance_id": "44444444-2222-4333-8444-555555555555",
          "continuation_id": "55555555-2222-4333-8444-555555555555",
          "choice_id": "start_rounds",
          "attempt_id": "66666666-2222-4333-8444-555555555555",
          "cursor": 0,
          "credit": [],
          "status": "together"
        }
      ]
    },
    "PatrolDraw": {
      "type": "object",
      "properties": {
        "quest_instance_id": {
          "$ref": "delta.schema.json#/$defs/QuestInstanceId"
        },
        "attempt_id": {
          "$ref": "identity.schema.json#/$defs/CommandId"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "status": {
          "$ref": "relation.schema.json#/$defs/PatrolStatus"
        }
      },
      "required": [
        "quest_instance_id",
        "attempt_id",
        "cursor",
        "status"
      ],
      "additionalProperties": false,
      "description": "The exact quest instance, accepted attempt, occurrence cursor and lifecycle drawn on a patrol control; a fresh invocation cannot reuse a stale leg.",
      "examples": [
        {
          "quest_instance_id": "44444444-2222-4333-8444-555555555555",
          "attempt_id": "66666666-2222-4333-8444-555555555555",
          "cursor": 0,
          "status": "together"
        }
      ]
    },
    "PopulationSlot": {
      "description": "One fixed ordinal population slot. A dead member remains bound until a later eligible replacement.",
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "member_id": {
          "anyOf": [
            {
              "$ref": "identity.schema.json#/$defs/EntityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacement_due": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "last_flight_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sight_job_id": {
          "anyOf": [
            {
              "$ref": "delta.schema.json#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "generation",
        "member_id",
        "replacement_due"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "generation": 1,
          "member_id": "11111111-1111-4111-8111-111111111111",
          "replacement_due": null
        }
      ]
    },
    "CrowTransport": {
      "description": "One bounded crow slot's exact scavenging occurrence. Idle rows retain the last member generation without a pending item or job.",
      "type": "object",
      "properties": {
        "phase": { "enum": ["idle", "acquire", "leg", "return", "paused_return"] },
        "member_id": { "$ref": "identity.schema.json#/$defs/EntityId" },
        "generation": { "type": "integer", "minimum": 1 },
        "item_id": { "anyOf": [{ "$ref": "identity.schema.json#/$defs/EntityId" }, { "type": "null" }] },
        "nest_id": { "anyOf": [{ "$ref": "identity.schema.json#/$defs/EntityId" }, { "type": "null" }] },
        "job_id": { "anyOf": [{ "$ref": "delta.schema.json#/$defs/JobId" }, { "type": "null" }] },
        "drop_event_id": { "anyOf": [{ "$ref": "event.schema.json#/$defs/EventId" }, { "type": "null" }] },
        "encounter_id": { "anyOf": [{ "$ref": "delta.schema.json#/$defs/EncounterId" }, { "type": "null" }] }
      },
      "required": ["phase", "member_id", "generation", "item_id", "nest_id", "job_id", "drop_event_id", "encounter_id"],
      "additionalProperties": false,
      "examples": [{
        "phase": "idle",
        "member_id": "11111111-1111-4111-8111-111111111111",
        "generation": 1,
        "item_id": null,
        "nest_id": null,
        "job_id": null,
        "drop_event_id": null,
        "encounter_id": null
      }]
    },
    "PopulationControl": {
      "description": "Current plan job and next wander boundary; membership resides only in fixed slots.",
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "delta.schema.json#/$defs/JobId"
        },
        "next_wander_due": {
          "type": "integer",
          "minimum": 1
        },
        "suppression": {
          "type": "object",
          "properties": {
            "generation": { "type": "integer", "minimum": 1 },
            "ends_at": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
            "job_id": { "anyOf": [{ "$ref": "delta.schema.json#/$defs/JobId" }, { "type": "null" }] },
            "cause_event_id": { "$ref": "event.schema.json#/$defs/EventId" }
          },
          "required": ["generation", "ends_at", "job_id", "cause_event_id"],
          "additionalProperties": false
        }
      },
      "required": [
        "job_id",
        "next_wander_due"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "job_id": "33333333-3333-4333-8333-333333333333",
          "next_wander_due": 210
        }
      ]
    },
    "ExpeditionAttempt": {
      "description": "One player's current bounded expedition attempt, bound to its quest instance.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "expedition"
        },
        "actor_id": {
          "$ref": "identity.schema.json#/$defs/CharacterId"
        },
        "body_id": {
          "$ref": "identity.schema.json#/$defs/EntityId"
        },
        "quest_instance_id": {
          "$ref": "delta.schema.json#/$defs/QuestInstanceId"
        },
        "attempt_id": {
          "$ref": "identity.schema.json#/$defs/CommandId"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "sheltered": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "failed",
            "completed"
          ]
        }
      },
      "required": [
        "kind",
        "actor_id",
        "body_id",
        "quest_instance_id",
        "attempt_id",
        "cursor",
        "sheltered",
        "status"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "kind": "expedition",
          "actor_id": "11111111-2222-4333-8444-555555555555",
          "body_id": "22222222-2222-4333-8444-555555555555",
          "quest_instance_id": "33333333-2222-4333-8444-555555555555",
          "attempt_id": "44444444-2222-4333-8444-555555555555",
          "cursor": 0,
          "sheltered": false,
          "status": "active"
        }
      ]
    }
  }
}
