{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Account, run and admission contracts",
  "description": "Account/run binding, story point reports and acceptances, and Realm admission (23 §2-§7, §11; 03 §25-§27). Host and platform records, never portable gameplay inputs: no StateScope here, and none of this enters the canonical gameplay hash (03 §26; 23 §2).",
  "$defs": {
    "AccountId": {
      "description": "A platform account (23 §2, §5): server-owned, never reused. Lowercase hyphenated UUID, any version.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "examples": [
        "7a7a7a7a-1111-4222-8333-444444444444"
      ]
    },
    "StoryRunId": {
      "description": "A Story run/save lineage (23 §5; 03 §25). A semantic restore or fork is a new run (23 §11). Lowercase hyphenated UUID, any version.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "examples": [
        "6f6f6f6f-1111-4222-8333-444444444444"
      ]
    },
    "StoryPointReportId": {
      "description": "One story point occurrence's report, stable across retry and restore (23 §4, §11). Lowercase hyphenated UUID, any version.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "examples": [
        "5e5e5e5e-1111-4222-8333-444444444444"
      ]
    },
    "StoryPointReport": {
      "description": "The payload of one story point report (23 §5 'Local story point/report'): story point key, occurrence id, run and exact release, outcome and the observed game revision. It names no account (authentication supplies it) and no evidence class (only the server assigns one, 23 §6).",
      "type": "object",
      "properties": {
        "report_id": {
          "$ref": "#/$defs/StoryPointReportId"
        },
        "run_id": {
          "$ref": "#/$defs/StoryRunId"
        },
        "release": {
          "$ref": "manifest.schema.json#/$defs/CartridgeRelease"
        },
        "story_point": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "outcome": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "observed_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "report_id",
        "run_id",
        "release",
        "story_point",
        "outcome",
        "observed_revision"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "report_id": "5e5e5e5e-1111-4222-8333-444444444444",
          "run_id": "6f6f6f6f-1111-4222-8333-444444444444",
          "release": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "cartridge_hash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          },
          "story_point": "prologue_completed",
          "outcome": "player_led",
          "observed_revision": 17
        }
      ]
    },
    "EvidenceClass": {
      "description": "How a story point was evidenced (23 §6). A client cannot select or upgrade it.",
      "enum": [
        "offline_client_report",
        "server_replayed_trace",
        "server_authoritative_run"
      ],
      "examples": [
        "offline_client_report"
      ]
    },
    "StoryPointAcceptance": {
      "description": "The platform's durable acceptance record (23 §5 'Platform acceptance'): authenticated account, canonical payload digest (hash of the StoryPointReport), recognized release and story point, evidence class, acceptance-policy revision and result. integrity_conflict: the report id was reused with a different payload; outcome_conflict: another outcome for the same story point in the same run (23 §5). The server receipt time is host metadata whose format is fixed with the platform API (R12A).",
      "type": "object",
      "properties": {
        "report_id": {
          "$ref": "#/$defs/StoryPointReportId"
        },
        "account_id": {
          "$ref": "#/$defs/AccountId"
        },
        "payload_digest": {
          "$ref": "manifest.schema.json#/$defs/ContentHash"
        },
        "release": {
          "$ref": "manifest.schema.json#/$defs/CartridgeRelease"
        },
        "story_point": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "outcome": {
          "$ref": "action.schema.json#/$defs/Key"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": [
            "accepted",
            "rejected",
            "integrity_conflict",
            "outcome_conflict"
          ]
        }
      },
      "required": [
        "report_id",
        "account_id",
        "payload_digest",
        "release",
        "story_point",
        "outcome",
        "evidence_class",
        "policy_revision",
        "result"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "report_id": "5e5e5e5e-1111-4222-8333-444444444444",
          "account_id": "7a7a7a7a-1111-4222-8333-444444444444",
          "payload_digest": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
          "release": {
            "cartridge_id": "ferrymans_lantern",
            "cartridge_version": "0.1.0",
            "cartridge_hash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          },
          "story_point": "prologue_completed",
          "outcome": "player_led",
          "evidence_class": "offline_client_report",
          "policy_revision": 1,
          "result": "accepted"
        }
      ]
    }
  }
}
