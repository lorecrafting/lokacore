              }
            ]
          }
        }
      ]
    },
    "GameViewSnapshot": {
      "description": "An authoritative GameView snapshot (04 §16). format versions the envelope: a new field or meaning takes a new format. projection_sequence orders this client stream's projection messages; a gap means resync from a fresh snapshot. view_freshness_token is opaque, echoed in ActionInvocation (same 1-128 character limit) for staleness diagnosis. Neither equals an authority revision (04 §16). Incremental projection messages are added with the Realm transport. narration holds committed narration records not yet delivered on this stream, oldest first.",
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "loka-gameview-v1"
        },
        "projection_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "view_freshness_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "view": {
          "$ref": "#/$defs/GameView"
        },
        "narration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NarrationRecord"
          }
        }
      },
      "required": [
        "format",
        "projection_sequence",
        "view"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "format": "loka-gameview-v1",
          "projection_sequence": 0,
          "view_freshness_token": "tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt",
