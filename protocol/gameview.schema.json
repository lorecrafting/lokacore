    "TextValue": {
      "description": "A value interpolated into localized text (04 §15 'interpolation data'; 06 §43 'bindings'): a TextKey (localized in turn, so a Key such as a direction also fits), an integer (a count, a time) or a boolean.",
      "anyOf": [
        {
          "$ref": "#/$defs/TextKey"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        }
      ],
      "examples": [
        "room.village_green.title",
        "north",
        420,
        true
      ]
    },
    "Text": {
      "description": "Localized text: a string id and its named bindings (04 §15 'localized string IDs plus interpolation data'; 06 §43 'pinned text keys and bindings'). Binding names are lowercase snake_case, at most 64 characters.",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/TextKey"
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/TextValue"
          }
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "key": "narration.move"
        },
        {
          "key": "narration.move",
          "bindings": {
            "direction": "north",
            "destination": "room.village_green.title"
          }
        },
        {
          "key": "clock.time",
          "bindings": {
            "minutes": 420
          }
        },
        {
          "key": "k",
          "bindings": {}
        }
      ]
    },
    "UnavailableReason": {
      "description": "Why an action, choice or exit is shown but not legal now (00 §4.10: greyed with the reason, badge when locked; P5 'clear unavailable-action feedback'): the typed code, and optionally the player-facing sentence that tells apart two reasons with one code (a locked door, a causeway under the tide). A GameView presentation field, so GameError and the error registry stay unchanged.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "error.schema.json#/$defs/ErrorCode"
        },
        "message": {
          "$ref": "#/$defs/Text"
