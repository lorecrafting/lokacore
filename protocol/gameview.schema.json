            "continuation_id": "0f0e0d0c-0b0a-4908-8706-050403020100",
            "speaker_id": "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
            "prompt": {
              "key": "dialogue.bram.search_plan"
            },
            "closable": true,
