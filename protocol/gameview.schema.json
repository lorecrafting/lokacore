              }
            }
          },
          "exits": [
            {
              "available": true,
              "direction": "north"
            },
            {
              "available": false,
              "direction": "west",
              "reason": {
                "code": "exit_locked",
                "message": {
                  "key": "reason.causeway_flooded"
                }
              }
            }
          ],
          "actions": [
            {
              "available": true,
              "action_key": "look",
              "label": "action.look"
            },
            {
              "available": false,
