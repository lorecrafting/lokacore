              "label": "action.wait",
              "reason": {
                "code": "invalid_state"
              }
            }
          ],
          "entities": [
            {
              "id": "d4e5f6a7-b8c9-8d0e-9f1a-3b4c5d6e7f8a",
              "name": "npc.wren.name",
              "kind": "npc",
              "actions": [
                {
