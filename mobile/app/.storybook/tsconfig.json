// Storybook's types pull in Node's, which the app's tsconfig keeps out (tests/page_turn.e2e.ts).
{
  "extends": "../tsconfig.json",
  "compilerOptions": { "types": ["vite/client"] },
  "include": [
    "*.ts",
    "*.tsx",
    "picker/*.ts",
    "picker/*.tsx",
    "../vitest.config.mts",
    "../stories",
    "../book/sksl.d.ts"
  ],
  "exclude": [] // the app's excludes 'stories'
}
