{
  "name": "loka-app",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node patch-sqlite-web.cjs",
    "web:preview": "node preview-server.cjs",
    "pretest:e2e": "node patch-sqlite-web.cjs",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "test": "node --test --test-reporter=${TEST_REPORTER:-spec} \"../authority/**/*.test.ts\" \"book/*.test.ts\" \"*.test.ts\""
  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "57.0.24",
    "expo-crypto": "57.0.3",
    "expo-font": "57.0.4",
    "expo-sqlite": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.12.0",
    "@types/react": "19.2.18",
    "e2e": "^0.17.0",
    "typescript": "6.0.3"
  }
}
