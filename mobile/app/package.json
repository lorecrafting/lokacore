{
  "name": "loka-app",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node patch-sqlite-web.cjs",
    "web:preview": "node preview-server.cjs",
    "author": "LOKA_DEV_CARTRIDGE=.dev-cartridge/current.json node preview-server.cjs",
    "pretest:e2e": "node patch-sqlite-web.cjs && node --test sqlite-web-worker.test.ts",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "walkthrough": "rm -rf .walkthrough/steps && node patch-sqlite-web.cjs && E2E_TELEMETRY_DISABLED=1 e2e run --config walkthrough.config.ts; s=$?; node walkthrough/sheet.cjs; exit $s",
    "test": "node --test --test-reporter=${TEST_REPORTER:-spec} \"../authority/**/*.test.ts\" \"book/*.test.ts\" \"*.test.ts\"",
    "stories:views": "node stories/scenarios.ts",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "storybook:build": "storybook build",
    "storybook:live": "node .storybook/live.ts",
    "storybook:smoke": "tsc -p .storybook && storybook build --quiet && vitest run --config .storybook/vitest.config.mts"
  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@shopify/react-native-skia": "2.6.2",
    "canvaskit-wasm": "0.41.0",
    "expo": "57.0.24",
    "expo-crypto": "57.0.3",
    "expo-font": "57.0.4",
    "expo-sqlite": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.12.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-native-web-vite": "10.6.1",
    "@types/react": "19.2.18",
    "@vitest/browser-playwright": "5.0.3",
    "e2e": "^0.17.0",
    "playwright": "1.63.0",
    "storybook": "10.6.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
