 "details": {
  "ee88876f-e173-89bf-b354-fa9b2ddb3f0b": [
   "“My boy Wren hasn’t come home. I keep thinking the next boat might bring word of him.” She gathers herself. “You’re new to Ashmere, aren’t you?”",
   "You agree to look around Village Green for a sign of Wren.",
   {
    "text": "Journal updated",
    "event": true
   },
   "Elspeth watches the folded drawing in your hand.",
   "“That could be Wren's drawing,” Elspeth says. “He was always exploring. The reeds south of the landing may be worth searching, but I can't know where he went.” “Look closely at the tracks on Reed Bank,” Elspeth says. “Follow them south. Wren is still missing.”",
   {
    "text": "Journal updated",
    "event": true
   }
  ]
 }
