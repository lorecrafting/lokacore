#!/bin/sh
# Loka's command line. `loka play <artifact> [script | --replay <transcript>]`: kernel/ts/play.
# `loka dev [<cartridge dir>] [--watch]`: the author preview's artifact, kernel/ts/play/author.ts
# (`--watch` with no dir: the last one watched).
# `loka new <kind> <name> [--from <room> <direction>] [--area <area>] [--extends <key>] ... [cartridge dir]` (`scene <npc> <key>` for a scene): compiling starter files,
# mix loka.new (any cwd; the cartridge dir, default the cwd, and a new cartridge's path resolve
# against the caller's cwd).
# `loka todo <cartridge dir>`: the `~` placeholders still to write, by file (kernel/ts/play/todo.ts).
# `loka story <cartridge dir>`: the Story map's model as JSON (kernel/ts/play/story.ts).
# `loka check <cartridge dir>`: replays each checkpoints/*.json headless (kernel/ts/play/check.ts).
# `loka sim <cartridge dir> [--seeds N] [--days D]`: balancing numbers, no limit (kernel/ts/play/sim.ts).
# `loka roam <cartridge dir> [--runs N] [--steps M] [--seed S]`: a random player's coverage, and a
# checkpoint for any invariant it breaks (kernel/ts/play/roam.ts).
# mobile/app/package.json stays typeless (Metro); the warning is noise (also for `new`, whose todo runs node).
export NODE_OPTIONS="${NODE_OPTIONS-} --disable-warning=MODULE_TYPELESS_PACKAGE_JSON"
case "${1-}" in
play) shift; exec node "$(dirname "$0")/../kernel/ts/play/main.ts" "$@" ;;
dev)
  shift
  # 75: the editor opened another world (POST /world); start again on it, the one remembered.
  while :; do
    node "$(dirname "$0")/../kernel/ts/play/author.ts" "$@" && exit 0 || status=$?
    [ "$status" -eq 75 ] || exit "$status"
    set -- --watch
  done ;;
todo) shift; exec node "$(dirname "$0")/../kernel/ts/play/todo.ts" "$@" ;;
story) shift; exec node "$(dirname "$0")/../kernel/ts/play/story.ts" "$@" ;;
check) shift; exec node "$(dirname "$0")/../kernel/ts/play/check.ts" "$@" ;;
sim) shift; exec node "$(dirname "$0")/../kernel/ts/play/sim.ts" "$@" ;;
roam) shift; exec node "$(dirname "$0")/../kernel/ts/play/roam.ts" "$@" ;;
new)
  shift
  caller="$PWD"
  cd "$(dirname "$0")/.." && exec mix loka.new --cwd "$caller" "$@" ;;
*) echo "usage: bin/loka play <artifact> [script | --replay <transcript>] | bin/loka dev [<cartridge dir>] [--watch] | bin/loka new <kind> <name> [--from <room> <direction>] [--from <cartridge dir>] [--area <area>] [--extends <key>] ... [cartridge dir] (scene <npc> <key>) | bin/loka todo <cartridge dir> | bin/loka story <cartridge dir> | bin/loka check <cartridge dir> | bin/loka sim <cartridge dir> [--seeds N] [--days D] | bin/loka roam <cartridge dir> [--runs N] [--steps M] [--seed S]" >&2; exit 2 ;;
esac
