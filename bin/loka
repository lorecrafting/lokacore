#!/bin/sh
# Loka's command line. `loka play <artifact> [script | --replay <transcript>]`: kernel/ts/play.
# `loka dev <cartridge dir> [--watch]`: the author preview's artifact, kernel/ts/play/author.ts.
# `loka new <kind> <name> [cartridge dir]`: a compiling starter file, mix loka.new (run from the root).
case "${1-}" in
play) shift; exec node "$(dirname "$0")/../kernel/ts/play/main.ts" "$@" ;;
dev) shift; exec node "$(dirname "$0")/../kernel/ts/play/author.ts" "$@" ;;
new) shift; exec mix loka.new "$@" ;;
*) echo "usage: bin/loka play <artifact> [script | --replay <transcript>] | bin/loka dev <cartridge dir> [--watch] | bin/loka new <kind> <name> [cartridge dir]" >&2; exit 2 ;;
esac
