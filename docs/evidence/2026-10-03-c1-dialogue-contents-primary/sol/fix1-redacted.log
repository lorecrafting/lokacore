    49	// The view's available actions as buttons: place actions that need no input, each open exit as a
    50	// move, each entity's or held item's actions aimed at it, then the pending choice's.
    51	function buttonsOf(v: GameView, label: Say, text: Say): Press[] {
    52	  const button = (a: { action_key: string; label: string }, name: string, id?: string) => ({
    53	    label: `${label(a.label)}${name}`,
    54	    action_key: a.action_key,
    55	    target_ids: id ? [id] : [],
    56	    input: {},
    57	  });
