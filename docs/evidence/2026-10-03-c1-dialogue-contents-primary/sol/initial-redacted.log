   226	/** World/detail logs, buttons and presses for one game. */
   227	export function presenter(game: Game) {
   228	  const { text, label } = sayers(game);
   229	  const s = restoredLogs(game, text);
   230	  return {
   231	    screen: () => {
   232	      s.log.splice(0, s.log.length - 200);
   233	      for (const lines of s.details.values()) lines.splice(0, lines.length - 200);
   234	      const { view, token } = game.view();
   235	      const buttons: Button[] = buttonsOf(view, label, text).map((b) => ({ ...b, token }));
   236	      return {
   237	        view,
   238	        text,
   239	        buttons,
   240	        log: s.log,
   241	        detail: (id: string) => s.details.get(id) ?? [],
   242	        pending: game.pending(),
   243	        fault: s.fault,
   244	        returnWorld: s.returnWorld,
   245	      };
   246	    },
   247	    // A pending retry keeps the original detail, even when retried from the world.
   248	    press: (b: Button, detail?: string) => pressed(game, b, detail, s, text),
   249	    startOverFailed(why?: string) {
   250	      if (why !== undefined) s.log.push(`(start over: ${why})`);
   251	    },
   252	  };
   253	}
