   202	function pressed(game: Game, b: Button, detail: string | undefined, s: Logs, text: Say): string {
   203	  s.returnWorld = false;
   204	  // A complete Give remains legal; the current item-only touch button cannot supply its recipient.
   205	  if (!game.pending() && b.action_key === 'give' && b.target_ids.length !== 2) return '';
   206	  const was = game.view().view;
   207	  const item = ['take', 'drop'].includes(b.action_key)
   208	    ? things(was).find((e) => e.id === b.target_ids[0])
   209	    : undefined;
   210	  s.retry ??= { button: b, detail, item: item && text(item.name) };
   211	  let reply: Reply;
   212	  try {
   213	    reply = game.invoke(intentOf(b));
   214	  } catch (e) {
   215	    s.fault = (e as Error).message;
   216	    const line = `(not confirmed: ${s.fault}; the next press retries ${s.retry.button.label})`;
   217	    (s.retry.detail ? detailLines(s, s.retry.detail) : s.log).push(line);
   218	    return line;
   219	  }
   220	  s.fault = undefined;
   221	  const line = received(game, reply, was, s, text);
   222	  if (!game.pending()) s.retry = undefined;
   223	  return line;
   224	}
