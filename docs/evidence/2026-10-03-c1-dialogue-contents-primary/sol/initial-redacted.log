    38	// Keep the page after a same-room action, stopping at the first item page that disappeared.
    39	export function pagesAfter(stack: Page[], before: GameView, after: GameView): Page[] {
    40	  if (after.chapter && before.chapter?.index !== after.chapter.index) return [{ kind: 'chapter' }];
    41	  if (before.place.id !== after.place.id) return [];
    42	  const visible = things(after);
    43	  const gone = stack.findIndex((p) => p.kind === 'thing' && !visible.some((e) => e.id === p.id));
    44	  return gone < 0 ? stack : stack.slice(0, gone);
    45	}
