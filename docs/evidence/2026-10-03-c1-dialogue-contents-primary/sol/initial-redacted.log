   116	// A text key's words, and an action label's. ponytail: the cartridge has no text for most action
   117	// labels yet, so a label shows the key's last word, capitalised as the texted labels are.
   118	const sayers = (g: Game): { text: Say; label: Say } => ({
   119	  text: (key) => g.text(key) ?? key,
   120	  label: (key) =>
   121	    g.text(key) ??
   122	    key
   123	      .replace(/^actions?\./, '')
   124	      .replaceAll('_', ' ')
