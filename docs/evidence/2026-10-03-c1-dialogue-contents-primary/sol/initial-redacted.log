   143	// A first-run hint's "seen" flag in a key-value store (the shell's key-value store: its own file, not the
   144	// save). A store that throws falls back to this session's memory: a hint never stops the book.
   145	type Store = { getItemSync(key: string): string | null; setItemSync(key: string, v: string): void };
   146	export type Hint = ReturnType<typeof hint>;
   147	export function hint(store: Store, key: string) {
   148	  let seen = false;
   149	  return {
   150	    seen: () => {
   151	      try {
   152	        return seen || store.getItemSync(key) !== null;
   153	      } catch {
   154	        return seen;
   155	      }
   156	    },
   157	    see: () => {
   158	      seen = true;
   159	      try {
   160	        store.setItemSync(key, '1');
   161	      } catch {} // ponytail: the next launch shows the hint again
   162	    },
   163	  };
   164	}

