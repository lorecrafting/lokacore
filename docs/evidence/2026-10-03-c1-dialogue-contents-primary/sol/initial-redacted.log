    47	const OWN = ['look', 'choose', 'close_choice', 'continue', 'stand', 'sit', 'rest', 'sleep']; // drawn in their own places, not as place actions
    48	
    49	export function group(buttons: Button[]) {
    50	  const dir = (b: Button) => (b.input as { direction?: string }).direction;
    51	  const aimed = (b: Button) => b.target_ids.length > 0;
    52	  return {
    53	    look: buttons.find((b) => b.action_key === 'look' && !aimed(b)),
    54	    exits: buttons.flatMap((b) =>
    55	      b.action_key === 'move' && dir(b) ? [{ direction: dir(b)!, button: b }] : [],
    56	    ),
    57	    door: (direction: string) =>
    58	      buttons.filter((b) => b.action_key !== 'move' && dir(b) === direction),
    59	    continue: buttons.find((b) => b.action_key === 'continue'),
    60	    position: buttons.filter((b) => ['stand', 'sit', 'rest', 'sleep'].includes(b.action_key)),
    61	    choice: buttons.filter((b) => b.action_key === 'choose' || b.action_key === 'close_choice'),
    62	    // scan: the engine verb stays, but the phone shows nothing for it yet (DIFFERENCES 3), so no button.
    63	    place: buttons.filter(
    64	      (b) => !aimed(b) && !dir(b) && !OWN.includes(b.action_key) && b.action_key !== 'scan',
    65	    ),
    66	    on: (id: string) => buttons.filter((b) => b.target_ids.includes(id)),
    67	  };
    68	}
