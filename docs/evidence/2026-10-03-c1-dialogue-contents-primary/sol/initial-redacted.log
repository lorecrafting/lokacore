   128	// The button's plain strings are the wire's branded ones: a button is built from the view's own keys.
   129	const intentOf = ({ action_key, target_ids, input, token }: Button): Intent => ({
   130	  action_key: action_key as Key,
   131	  target_ids: target_ids as EntityId[],
   132	  input: input as ActionInput,
   133	  ...(token && { view_freshness_token: token }),
   134	});
