// The boundary between the renderer and a game engine (spec 07 "The session boundary"): the renderer
// reads host-neutral GameView data and sends host-neutral intents through these types. It names no
// engine internals (no Db, Story, World or Cartridge), so the local TypeScript authority and a
// future online Elixir Realm can both serve one presenter. The renderer's words live in the app.
import type {
  ActionInput,
  ActionInvocation,
  DecisionResult,
  EntityId,
  ErrorCode,
  GameView,
  Key,
  NarrationRecord,
} from '../../../kernel/ts/src/contracts.gen.ts';

export type {
  ActionInput,
  ActionInvocation,
  DecisionResult,
  EntityId,
  ErrorCode,
  GameView,
  Key,
  NarrationRecord,
};

/** What a press sends: an invocation without its id and actor, which the session adds. */
export type Intent = Omit<ActionInvocation, 'invocation_id' | 'actor_id'>;

/** The answer to one press (03 §14, 04 §16). */
export type Reply =
  | { kind: 'saved'; decision: DecisionResult }
  | { kind: 'stale_view' } // sent against an older view; nothing changed
  | { kind: 'conflict' }
  | { kind: 'invalid' | 'unauthorized' }
  | { kind: 'pending' } // the save is not confirmed: any later invoke resends the same attempt
  | { kind: 'fault'; code: ErrorCode };

/** One game being played. */
export interface Game {
  /** The current page and its freshness token (04 §16). */
  view(): { view: GameView; token: string };
  /** Throws when the write failed: the attempt stays pending and the next call resends it. */
  invoke(intent: Intent): Reply;
  pending(): boolean;
  /** Cartridge prose (content, not app words); none for an unknown key. */
  text(key: string): string | undefined;
  /** The last committed narration, to show again on a reopen (06 §43). */
  lastNarration(): NarrationRecord | undefined;
}

/**
 * Why there is no game: the save's kind (none: untyped), its message, a `code` for a start over
 * that is not confirmed (the presenter says it in words), and whether Start over is offered.
 */
export type Failed = {
  kind?: 'unsupported_save_format' | 'save_corrupt' | 'pinned_release_missing';
  message: string;
  code?: 'start_over_pending';
  startOver: boolean;
};

export interface GameSession {
  game(): Game | undefined;
  failed(): Failed | undefined;
  /** A start over that failed and kept the game: its message, for the presenter's log. */
  startOver(): string | undefined;
}
    45	// The save does not open (and offers start over) on a corrupt file (untyped: replaced), or, as
    46	// save_corrupt with the new game in place (the file is fine), a damaged receipt or a world whose
    47	// first screen cannot be built, whatever row's shape stops it (ROADMAP SM2a), so both are read
    48	// once here, not lazily. ponytail: later screens' reads are not checked; typed row validation is R12's.
    49	function checked(story: Extract<ReturnType<typeof openStory>, { kind: 'open' }>) {
    50	  const refusal = (e: unknown) =>
    51	    Object.assign(new Error((e as Error).message), {
    52	      cause: { kind: 'save_corrupt', newGame: story.newGame },
    53	    });
    54	  try {
    55	    gameView(story.world());
    56	  } catch (e) {
    57	    throw refusal(e);
    58	  }
    59	  try {
    60	    const last = story.narration();
    61	    // a line that parses but is not text would throw in the presenter's draw, outside SaveError
    62	    if (last?.lines.some((t) => typeof (t as { key?: unknown } | null)?.key !== 'string'))
    63	      throw new Error('malformed JSON: a narration line without a key');
    64	  } catch (e) {
    65	    if (!/malformed JSON/.test(String(e))) throw e; // a full disk or I/O: the save may be intact
    66	    throw refusal(e);
    67	  }
    68	}
    69	
    70	/**
    71	 * The game on the save in `db` (a new one if empty, its ids from `host.newId`, a random UUID each call)
    72	 * of the bundled cartridge; open `db` once per process. A save that does not open throws, its
    73	 * refusal (kind and newGame) as the error's cause.
    74	 */
    75	export function openGame(db: Db, bundled: Bundled, host: HostPart) {
    76	  const cartridge = cartridgeOf(bundled);
    77	  const fresh = newWorld(cartridge, CONTEXT as never, SEED as never);
    78	  const story = openStory(db, [{ content_hash: bundled.sha256, fresh }], host);
    79	  if (story.kind !== 'open') throw Object.assign(new Error(story.kind), { cause: story });
    80	  checked(story);
    81	  // The unconfirmed attempt, resent unchanged (same id, same intent) until it settles (03 §§14-15).
    82	  let retry: object | undefined;
    83	  let sent = lastId(db);
    84	  const game: Game = {
    85	    view: () => ({ view: gameView(story.world()), token: story.token() }),
    86	    invoke(intent: Intent): Reply {
    87	      // While unconfirmed any call resends that attempt, whatever the intent.
    88	      retry ??= {
    89	        ...intent,
    90	        invocation_id: `${ID_PREFIX}${(++sent).toString(16).padStart(12, '0')}`,
    91	        actor_id: story.world().character,
    92	      };
    93	      const reply = story.invoke(retry); // a throw may follow a durable commit: keep the attempt (03 §14)
    94	      if (reply.kind !== 'pending') retry = undefined;
    95	      return reply as Reply;
    96	    },
    97	    pending: () => !!retry,
    98	    text: (key) => cartridge.text[key as Key],
    99	    lastNarration: story.narration,
   100	  };
   101	  return Object.assign(game, { newGame: story.newGame });
   102	}
