    49	export default function Book(p: BookProps) {
    50	  const [pr] = useState(() => presenter(p.game));
    51	  const [stack, setStack] = useState<Page[]>(() => initialPages(pr.screen().view));
    52	  const [flip, setFlip] = useState({ turn: 0, dir: 1 as 1 | -1 });
    53	  const [, redraw] = useState(0);
    54	  const screen = pr.screen();
    55	  const { view } = screen;
    56	  const go = (next: Page[], dir: 1 | -1) => {
    57	    setStack(next);
    58	    setFlip((f) => ({ turn: f.turn + 1, dir }));
    59	  };
    60	  const press = (b: Button, detail?: string) => {
    61	    const stale = !!b.token && !p.game.pending() && b.token !== p.game.view().token;
    62	    pr.press(b, detail);
    63	    if (stale) return redraw((n) => n + 1);
    64	    const after = pr.screen();
    65	    let next = pagesAfter(stack, view, after.view);
    66	    if (after.returnWorld && next === stack) next = [];
    67	    if (next === stack && npcPage(stack.at(-1), view) && !view.scene && !after.view.scene)
    68	      redraw((n) => n + 1);
    69	    else go(next, 1);
    70	  };
    71	  const refused = (line: string) => (screen.log.push(line), redraw((n) => n + 1));
    72	  const startOver = () => p.shell.confirm(() => (pr.startOverFailed(p.startOver()), go([], 1)));
    73	  return (
    74	    <BookView
    75	      screen={screen}
    76	      stack={stack}
    77	      flip={flip}
    78	      go={go}
    79	      press={press}
    80	      refused={refused}
    81	      startOver={startOver}
    82	      shell={p.shell}
    83	    />
    84	  );
    85	}
