    87	// What one press answers: the narration or the outcome's words (words.ts; none: '') of an accepted
    88	// command, else the refusal in words. Never a raw outcome code.
    89	function said(r: Reply, text: Say, view: GameView, fallback?: string): string {
    90	  if (r.kind === 'pending') return '(pending: not confirmed saved; press any button to retry it)';
    91	  if (r.kind === 'stale_view') return 'The page had changed; here it is again.';
    92	  if (r.kind !== 'saved') return `(${r.kind}${'code' in r ? ` ${r.code}` : ''})`;
    93	  const d = r.decision;
    94	  if (d.kind === 'rejected') {
    95	    const { code } = d.error; // the same sentence as a refused drag (model.ts `refused`)
    96	    return SENTENCE[code] ?? `You can't do that: ${reason(code)}.`;
    97	  }
    98	  if (d.kind === 'fault') return '';
    99	  const lines = d.narration ?? [];
   100	  const shown = ['looked', 'moved'].includes(d.outcome) ? withoutHeading(lines, view) : lines;
   101	  return shown.map((t) => text(t.key)).join(' ') || (fallback ?? OUTCOME[d.outcome] ?? '');
   102	}
