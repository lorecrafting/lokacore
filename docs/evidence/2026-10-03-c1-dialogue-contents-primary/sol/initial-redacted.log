   140	type Logs = {
   141	  log: string[];
   142	  details: Map<string, string[]>;
   143	  retry?: { button: Button; detail?: string; item?: string };
   144	  narrationId?: string;
   145	  returnWorld?: boolean;
   146	  fault?: string;
   147	};
   148	
   149	function restoredLogs(game: Game, text: Say): Logs {
   150	  const last = game.lastNarration();
   151	  const { view } = game.view();
   152	  const restored = last
   153	    ? withoutHeading(last.lines, view)
   154	        .map((t) => text(t.key))
   155	        .join(' ')
   156	    : '';
   157	  const log = restored && !view.choice ? [restored] : [];
   158	  const details = new Map<string, string[]>();
   159	  if (restored && view.choice) details.set(view.choice.speaker_id ?? 'conversation', [restored]);
   160	  if (view.choice) {
   161	    const id = view.choice.speaker_id ?? 'conversation';
   162	    details.set(id, [...(details.get(id) ?? []), text(view.choice.prompt.key)]);
   163	  }
   164	  return { log, details, narrationId: last?.command_id };
   165	}
   166	
   167	function detailLines(s: Logs, id: string) {
   168	  if (!s.details.has(id)) s.details.set(id, []);
   169	  return s.details.get(id)!;
   170	}
   171	
   172	function received(game: Game, reply: Reply, was: GameView, s: Logs, text: Say): string {
   173	  const attempt = s.retry!;
   174	  const now = game.view().view;
   175	  const accepted =
   176	    reply.kind === 'saved' && reply.decision.kind === 'accepted' ? reply.decision : undefined;
   177	  s.returnWorld = !!accepted && ['taken', 'dropped'].includes(accepted.outcome);
   178	  const moved = !!accepted && was.place.id !== now.place.id;
   179	  if (moved) s.log.length = 0;
   180	  const lines = attempt.detail && !s.returnWorld && !moved ? detailLines(s, attempt.detail) : s.log;
   181	  const retained = accepted?.narration?.length ? game.lastNarration() : undefined;
   182	  const repeated = !moved && retained && retained.command_id === s.narrationId;
   183	  if (retained) s.narrationId = retained.command_id;
   184	  const fallback =
   185	    s.returnWorld && attempt.item
   186	      ? `You ${accepted?.outcome === 'taken' ? 'pick up' : 'drop'} ${attempt.item}.`
   187	      : accepted?.outcome === 'choice_closed' && lines === s.log
   188	        ? ''
   189	        : undefined;
   190	  const line = repeated ? '' : said(reply, text, now, fallback);
   191	  if (line) lines.push(line);
   192	  lines.push(...comings(was, now, text));
   193	  if (
   194	    now.choice &&
   195	    was.choice?.continuation_id !== now.choice.continuation_id &&
   196	    !accepted?.narration?.some((line) => line.key === now.choice!.prompt.key)
   197	  )
   198	    detailLines(s, now.choice.speaker_id ?? 'conversation').push(text(now.choice.prompt.key));
   199	  return line;
   200	}
