   136	// Compare structured TextKeys, never rendered English. Authored non-navigation consequences stay.
   137	const withoutHeading = <T extends { key: string }>(lines: readonly T[], view: GameView) =>
   138	  lines.filter((t) => t.key !== view.place.title.key && t.key !== view.place.description?.key);
