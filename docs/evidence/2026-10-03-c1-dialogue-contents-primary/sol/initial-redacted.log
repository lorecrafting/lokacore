    50	export function gesture<P extends { exits: readonly { direction: string }[] }>(u: Ui<P>) {
    51	  const reset = () => (u.setLit(null), u.knob(0, 0), u.zoom(0));
    52	  let d = { t: 0, moved: false, pick: null as string | null, at: u.now.current };
    53	  return {
