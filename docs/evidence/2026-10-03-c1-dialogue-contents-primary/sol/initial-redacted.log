   104	// Navigation adds no duplicate heading. NPCs that leave or arrive while the player stays put
   105	// still have a meaningful status line. ponytail: inferred from the view; kernel schedule narration replaces it.
   106	function comings(was: GameView, now: GameView, text: Say): string[] {
   107	  if (was.place.id !== now.place.id) return [];
   108	  const gone = (a: GameView, b: GameView) =>
   109	    a.entities.filter((e) => e.kind === 'npc' && !b.entities.some((f) => f.id === e.id));
   110	  return [
   111	    ...gone(was, now).map((e) => `${text(e.name)} leaves.`),
   112	    ...gone(now, was).map((e) => `${text(e.name)} arrives.`),
   113	  ];
   114	}
