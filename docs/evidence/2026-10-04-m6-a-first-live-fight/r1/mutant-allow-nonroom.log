  +         'npc.bram.description': 'A ferryman with rope-scarred hands and a coat that has never been dry.',
  +         'npc.bram.room': '[Old Bram] the ferryman stands here, one boot on the ferry.',
  +         'npc.bram.short': 'Old Bram',
