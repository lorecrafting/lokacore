{
  "api_version": "loka/v3",
  "id": "identity_sampler",
  "version": "0.0.1",
  "title": "Identity Sampler",
  "requires": {
    "kernel_api": {
      "at_least": "1.97",
      "below": "2.0"
    },
    "content_schema": 1,
    "rule_ir": 1,
    "capabilities": {
      "movement": 1,
      "containment": 1,
      "resource": 1,
      "combat": 1,
      "schedule": 1,
      "death": 1,
      "description_variant": 1,
      "calendar": 1,
      "position": 1,
      "fact": 1,
      "policy": 1,
      "reaction": 1,
      "status": 1,
      "action_recipe": 1,
      "dialogue": 1,
      "inspectable_detail": 1,
      "topics": 1,
      "knowledge": 1
    },
    "client_features": []
  },
  "supported_profiles": [
    "offline_private"
  ],
  "entry": "square",
  "time_policy": {
    "profile": "real_elapsed",
    "rate": 50
  },
  "world": {
    "bands": [
      {
        "at_percent": 100,
        "key": "ready",
        "tone": "normal"
      },
      {
        "at_percent": 50,
        "key": "hurt",
        "tone": "warning"
      },
      {
        "at_percent": 0,
        "key": "dying",
        "tone": "danger"
      }
    ],
    "death": {
      "player_corpse": "player_corpse",
      "npc_corpse": "npc_corpse",
      "shrine": "square",
      "restore": {
        "hp": 10,
        "mv": 100
      }
    },
    "combat": {
      "player_attack": {
        "chance": 100,
        "damage_min": 1,
        "damage_max": 1
      },
      "interval": 150,
      "sleep_multiplier": 2,
      "flee_multiplier": 2,
      "narration": {
        "player_hit": "combat.player_hit",
        "player_miss": "combat.player_miss",
        "npc_hit": "combat.npc_hit",
        "npc_miss": "combat.npc_miss",
        "player_died": "combat.player_died",
        "npc_died": "combat.npc_died"
      }
    },
    "identity": {
      "name": "identity.name",
      "name_variants": [
        {
          "when": {
            "policy_version": 1,
            "root": {
              "op": "status_active",
              "subject": "target",
              "status": "disguised"
            }
          },
          "description": "identity.name_hooded"
        },
        {
          "when": {
            "policy_version": 1,
            "root": {
              "op": "fact_compare",
              "fact": "topic_houndbane_known",
              "equals": true
            }
          },
          "description": "identity.name_houndbane"
        }
      ]
    }
  }
}
