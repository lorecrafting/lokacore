{
  "api_version": "loka/v3",
  "id": "pen_sampler",
  "version": "0.0.1",
  "title": "Pen Sampler",
  "requires": {
    "kernel_api": {
      "at_least": "1.101",
      "below": "2.0"
    },
    "content_schema": 1,
    "rule_ir": 1,
    "capabilities": {
      "movement": 1,
      "containment": 1,
      "resource": 1,
      "policy": 1,
      "tag": 1,
      "fact": 1,
      "scripted_action": 1,
      "reaction": 1,
      "status": 1,
      "schedule": 1,
      "death": 1,
      "position": 1,
      "calendar": 1,
      "service": 1,
      "commerce": 1,
      "combat": 1,
      "population": 1,
      "food": 1
    },
    "client_features": []
  },
  "supported_profiles": [
    "offline_private"
  ],
  "entry": "yard",
  "time_policy": {
    "profile": "real_elapsed",
    "rate": 50
  },
  "calendar": {
    "start": 28800,
    "units_per_hour": 3600,
    "hours_per_day": 24,
    "subdivisions_per_hour": 4
  },
  "world": {
    "carry": {
      "max_grams": 5000
    },
    "bands": [
      {
        "at_percent": 100,
        "key": "ready",
        "tone": "normal"
      },
      {
        "at_percent": 50,
        "key": "hurt",
        "tone": "warning"
      },
      {
        "at_percent": 0,
        "key": "dying",
        "tone": "danger"
      }
    ],
    "death": {
      "player_corpse": "player_corpse",
      "npc_corpse": "npc_corpse",
      "shrine": "yard",
      "restore": {
        "hp": 10,
        "mv": 100
      }
    },
    "combat": {
      "player_attack": {
        "chance": 100,
        "damage_min": 1,
        "damage_max": 1
      },
      "interval": 150,
      "sleep_multiplier": 2,
      "flee_multiplier": 2,
      "narration": {
        "player_hit": "combat.player_hit",
        "player_miss": "combat.player_miss",
        "npc_hit": "combat.npc_hit",
        "npc_miss": "combat.npc_miss",
        "player_died": "combat.player_died",
        "npc_died": "combat.npc_died"
      }
    }
  }
}
