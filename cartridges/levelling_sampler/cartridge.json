{
  "api_version": "loka/v3",
  "id": "levelling_sampler",
  "version": "0.0.1",
  "title": "Levelling Sampler",
  "requires": {
    "kernel_api": {
      "at_least": "1.42",
      "below": "2.0"
    },
    "content_schema": 1,
    "rule_ir": 1,
    "capabilities": {
      "movement": 1,
      "containment": 1,
      "resource": 1,
      "fact": 1,
      "policy": 1,
      "attributes": 1,
      "combat": 1,
      "schedule": 1,
      "death": 1,
      "behavior": 1,
      "description_variant": 1,
      "calendar": 1,
      "position": 1,
      "quest": 1,
      "reaction": 1
    },
    "client_features": []
  },
  "supported_profiles": [
    "offline_private"
  ],
  "entry": "hall",
  "time_policy": {
    "profile": "real_elapsed",
    "rate": 50
  },
  "world": {
    "bands": [
      {
        "at_percent": 100,
        "key": "ready",
        "tone": "normal"
      },
      {
        "at_percent": 50,
        "key": "hurt",
        "tone": "warning"
      },
      {
        "at_percent": 0,
        "key": "dying",
        "tone": "danger"
      }
    ],
    "derived": {
      "damage": {
        "terms": [
          {
            "attribute": "str",
            "per_point": 1,
            "pivot": 10
          }
        ],
        "divisor": 1
      },
      "hp_max": {
        "terms": [
          {
            "attribute": "con",
            "per_point": 1,
            "pivot": 10
          }
        ]
      }
    },
    "death": {
      "player_corpse": "player_corpse",
      "npc_corpse": "npc_corpse",
      "shrine": "hall",
      "restore": {
        "hp": 10,
        "mv": 100
      }
    },
    "combat": {
      "player_attack": {
        "chance": 100,
        "damage_min": 4,
        "damage_max": 4
      },
      "interval": 150,
      "sleep_multiplier": 2,
      "flee_multiplier": 2,
      "narration": {
        "player_hit": "combat.player_hit",
        "player_miss": "combat.player_miss",
        "npc_hit": "combat.npc_hit",
        "npc_miss": "combat.npc_miss",
        "player_died": "combat.player_died",
        "npc_died": "combat.npc_died"
      }
    },
    "levelling": {
      "thresholds": [
        30,
        100
      ],
      "points_per_level": 1,
      "kills": [
        {
          "npc": "rat_a",
          "experience": 10
        },
        {
          "npc": "rat_b",
          "experience": 10
        },
        {
          "npc": "rat_c",
          "experience": 10
        }
      ],
      "level_up": "levelling.level_up"
    }
  }
}
