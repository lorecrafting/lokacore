{
  "on": {
    "event": "action_completed",
    "action": "turn_wheel_1"
  },
  "when": {
    "policy_version": 1,
    "root": {
      "op": "fact_compare",
      "fact": "wheel_1",
      "equals": 10
    }
  },
  "apply": [
    {
      "op": "fact.assign",
      "fact": "wheel_1",
      "value": 0
    }
  ]
}
