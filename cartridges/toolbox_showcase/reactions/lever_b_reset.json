{
  "on": {
    "event": "action_completed",
    "action": "pull_b"
  },
  "when": {
    "op": "not",
    "item": {
      "op": "fact_compare",
      "fact": "lever_stage",
      "equals": 1
    }
  },
  "apply": [
    {
      "op": "narrate",
      "text": "narration.lever_reset"
    },
    {
      "op": "fact.assign",
      "fact": "lever_stage",
      "value": 0
    }
  ]
}
