{
  "on": {
    "event": "entity_entered_room",
    "room": "cell"
  },
  "when": {
    "op": "fact_compare",
    "fact": "wanted",
    "equals": true
  },
  "apply": [
    {
      "op": "narrate",
      "text": "trial.charge"
    },
    {
      "op": "barrier.set",
      "barrier": "cell_door",
      "to": "closed"
    },
    {
      "op": "barrier.set",
      "barrier": "grate",
      "to": "closed"
    },
    {
      "op": "fact.assign",
      "fact": "grate_forced",
      "value": false
    }
  ]
}
