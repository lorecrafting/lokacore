{
  "abstract": true,
  "params": [
    "action",
    "fact",
    "n",
    "line"
  ],
  "on": {
    "event": "action_completed",
    "action": {
      "param": "action"
    }
  },
  "when": {
    "op": "fact_compare",
    "fact": {
      "param": "fact"
    },
    "equals": {
      "param": "n"
    }
  },
  "apply": [
    {
      "op": "narrate",
      "text": {
        "param": "line"
      }
    }
  ]
}
