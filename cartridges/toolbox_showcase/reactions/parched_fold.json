{
  "on": {
    "event": "entity_entered_room",
    "room": "the_fold"
  },
  "when": {
    "policy_version": 1,
    "root": {
      "op": "all",
      "items": [
        {
          "op": "sky",
          "weather": "drought"
        },
        {
          "op": "has_tag",
          "subject": "room",
          "tag": "exposed"
        }
      ]
    }
  },
  "apply": [
    {
      "op": "status.apply",
      "status": "parched"
    }
  ]
}
