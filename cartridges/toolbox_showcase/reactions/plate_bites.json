{
  "on": {
    "event": "check_failed",
    "check": "disarm_plate"
  },
  "when": {
    "op": "fact_compare",
    "fact": "plate_sprung",
    "equals": false
  },
  "apply": [
    {
      "op": "narrate",
      "text": "narration.needle"
    },
    {
      "op": "status.apply",
      "status": "poisoned"
    }
  ]
}
