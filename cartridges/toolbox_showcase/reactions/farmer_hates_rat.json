{
  "on": {
    "event": "item_acquired",
    "item": "dead_rat"
  },
  "when": {
    "op": "fact_compare",
    "fact": "gifted_rat",
    "equals": false,
    "npc": "farmer"
  },
  "apply": [
    {
      "op": "fact.adjust",
      "fact": "regard",
      "amount": -1
    },
    {
      "op": "fact.assign",
      "fact": "gifted_rat",
      "value": true
    }
  ]
}
