{
  "on": {
    "event": "entity_entered_room",
    "room": "loft"
  },
  "when": {
    "policy_version": 1,
    "root": {
      "op": "all",
      "items": [
        {
          "op": "quest_state",
          "quest": "errand",
          "state": "active"
        },
        {
          "op": "fact_compare",
          "fact": "flamma_known",
          "equals": true
        }
      ]
    }
  },
  "apply": [
    {
      "op": "quest.resolve",
      "quest": "errand",
      "outcome": "done"
    }
  ]
}
