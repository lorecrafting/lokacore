{
  "on": {
    "event": "check_failed",
    "check": "disarm_cellar"
  },
  "when": {
    "policy_version": 1,
    "root": {
      "op": "fact_compare",
      "fact": "cellar_sprung",
      "equals": false
    }
  },
  "apply": [
    {
      "op": "narrate",
      "text": "narration.needle"
    },
    {
      "op": "status.apply",
      "status": "poisoned"
    }
  ]
}
