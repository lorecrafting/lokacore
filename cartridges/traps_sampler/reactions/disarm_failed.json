{
  "on": {
    "event": "check_failed",
    "check": "disarm_plate"
  },
  "when": {
    "policy_version": 1,
    "root": {
      "op": "fact_compare",
      "fact": "plate_sprung",
      "equals": false
    }
  },
  "apply": [
    {
      "op": "status.apply",
      "status": "poison"
    }
  ]
}
