{
  "on": {
    "event": "entity_entered_room",
    "room": "fell"
  },
  "when": {
    "policy_version": 1,
    "root": {
      "op": "all",
      "items": [
        {
          "op": "sky",
          "weather": "rain"
        },
        {
          "op": "has_tag",
          "subject": "room",
          "tag": "exposed"
        },
        {
          "op": "not",
          "item": {
            "op": "wearing",
            "tag": "waterproof"
          }
        }
      ]
    }
  },
  "apply": [
    {
      "op": "status.apply",
      "status": "soaked"
    }
  ]
}
