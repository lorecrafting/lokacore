{
  "label": "service.buy_charter",
  "command": "use_service",
  "target": {
    "kind": "entity",
    "scopes": [
      "room_occupants"
    ]
  },
  "input": [
    "service",
    "quoted_price"
  ],
  "priority": 0,
  "policy": {
    "policy_version": 1,
    "root": {
      "op": "any",
      "items": [
        {
          "op": "fact_compare",
          "fact": "owns_charter",
          "equals": true
        },
        {
          "op": "fact_compare",
          "fact": "charter_sold",
          "equals": false
        }
      ]
    }
  },
  "accessibility": "service.buy_charter"
}
