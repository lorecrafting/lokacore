{
  "on": {
    "event": "fact_changed",
    "fact": "owns_charter"
  },
  "when": {
    "policy_version": 1,
    "root": {
      "op": "fact_compare",
      "fact": "owns_charter",
      "equals": true
    }
  },
  "apply": [
    {
      "op": "fact.assign",
      "fact": "charter_sold",
      "value": true
    }
  ]
}
