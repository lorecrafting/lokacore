{
  "api_version": "loka/v3",
  "id": "settle_sampler",
  "version": "0.0.1",
  "title": "Settle Sampler",
  "requires": {
    "kernel_api": {
      "at_least": "1.103",
      "below": "2.0"
    },
    "content_schema": 1,
    "rule_ir": 1,
    "capabilities": {
      "movement": 1,
      "schedule": 1,
      "calendar": 1,
      "reaction": 1
    },
    "client_features": []
  },
  "supported_profiles": [
    "offline_private"
  ],
  "entry": "square",
  "time_policy": {
    "profile": "real_elapsed",
    "rate": 50
  },
  "calendar": {
    "start": 600,
    "units_per_hour": 100,
    "hours_per_day": 24,
    "subdivisions_per_hour": 10,
    "lunar": {
      "period": 4800,
      "origin": 0,
      "phases": [
        {
          "at": 0,
          "phase": "new"
        },
        {
          "at": 2400,
          "phase": "full"
        }
      ]
    }
  }
}
