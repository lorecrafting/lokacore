{
  "on": {
    "event": "item_acquired",
    "item": "ring"
  },
  "when": {
    "op": "not",
    "item": {
      "op": "fact_compare",
      "fact": "blessed",
      "item": "ring",
      "equals": true
    }
  },
  "steps": [
    {
      "op": "status.apply",
      "status": "cursed",
      "item": "ring"
    }
  ]
}
