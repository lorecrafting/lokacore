#!/bin/sh
# Refuses a push when a new commit's message names a local path, or when bin/prepush.sh fails (loka-9ruc). Activate once per clone: git config core.hooksPath .githooks
# Status-only pushes (every changed file under .beads/ or docs/HANDOFF.md) skip the check; a new branch or an unknown remote sha runs it.
z=0000000000000000000000000000000000000000
skip=1
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$z" ] && continue
  # A commit message must not name a local path (home or worktree directory).
  for c in $(git rev-list "$local_sha" --not --remotes); do
    git log -1 --format=%B "$c" | grep -qE '/Users/|worktrees\.noindex/' && { echo "pre-push: commit $c's message names a local path (/Users/ or worktrees.noindex/); reword it" >&2; exit 1; }
  done
  [ "$remote_sha" = "$z" ] && { skip=0; continue; }
  files=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null) || { skip=0; continue; }
  [ -n "$(printf '%s\n' "$files" | grep -vE '^(\.beads/|docs/HANDOFF\.md$)')" ] && { skip=0; continue; }
done
[ "$skip" = 1 ] && exit 0
exec "$(git rev-parse --show-toplevel)/bin/prepush.sh"
