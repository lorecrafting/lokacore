#!/bin/sh
# Metadata and mobile app views/assets outside the Book (bin/ci_scope.sh code lane) use the short lane; a push whose
# other changes are only *.test.ts files skips mix test and credo; everything else runs the full line.
# ponytail: the checks run on the working tree, not the pushed commits; CI checks those.
scope=metadata
seen=0
deleted=0
while read -r _ local _ remote; do
  case $local in *[!0]*) ;; *) deleted=1; continue ;; esac # branch deletion
  seen=1
  case $remote in
    *[!0]*) ;;
    *) remote=$1/main # new branch: trust the local main only if the remote agrees
       tracked=$(git rev-parse -q --verify "$remote" 2>/dev/null)
       advertised=$(git ls-remote "$2" refs/heads/main 2>/dev/null | cut -f1)
       [ -n "$tracked" ] && [ "$tracked" = "$advertised" ] || { scope=full; continue; } ;;
  esac
  [ "$(bin/ci_scope.sh "$remote" "$local" code)" = skip ] && continue
  [ "$(bin/ci_scope.sh "$remote" "$local" elixir)" = skip ] && [ "$scope" != full ] && scope=tests || scope=full
done
[ "$seen" = 1 ] || [ "$deleted" = 0 ] || exit 0 # deletions only: nothing to check
[ "$seen" = 1 ] || scope=full
passed=$(cat "$(git rev-parse --git-path loka-checked-tree)" 2>/dev/null || true)
if [ -n "$passed" ] && [ -z "$(git status --porcelain --untracked-files=all)" ] && [ "$(git rev-parse HEAD^{tree})" = "$passed" ]; then
  echo "pre-push: bin/check_all.sh already passed on this clean tree"; exit 0
fi
[ "$scope" = metadata ] && exec bin/check_all.sh --metadata
[ "$scope" = tests ] && exec bin/check_all.sh --no-mix-test
exec bin/check_all.sh
