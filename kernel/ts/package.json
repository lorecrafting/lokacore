{
  "name": "loka-kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc && tsc -p test && tsc -p play",
    "test": "node --test --test-reporter=${TEST_REPORTER:-spec} \"test/**/*.test.ts\"",
    "test:files": "sh ../../bin/test_files.sh",
    "test:nosim": "node --test --test-reporter=${TEST_REPORTER:-spec} $(find test -name '*.test.ts' ! -name sim.test.ts)",
    "test:sim": "node --test --test-reporter=${TEST_REPORTER:-spec} test/sim.test.ts",
    "test:sim:fresh": "node --test --test-reporter=${TEST_REPORTER:-spec} --test-skip-pattern=showcase test/sim.test.ts",
    "test:sim:showcase": "node --test --test-reporter=${TEST_REPORTER:-spec} --test-name-pattern=showcase test/sim.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "ajv": "^8.20.0",
    "typescript": "6.0.3"
  }
}
